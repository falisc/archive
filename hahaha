local Lib = {}
Lib.__index = Lib
Lib.Theme = Theme
Lib.Windows = {}

function Lib:CreateWindow(title, width, height)
    return self.Window.new(title, width, height)
end

function Lib:Destroy()
    for _, w in ipairs(self.Windows) do
        w:Destroy()
    end
    Input:Stop()
    for _, d in ipairs(ActiveDrawings) do
        destroyDrawing(d)
    end
    ActiveDrawings = {}
end

--=====================================================================
-- WINDOW
--=====================================================================

local Window = {}
Window.__index = Window
Lib.Window = Window

function Window.new(title, width, height)
    width = width or 900
    height = height or 620

    local self = setmetatable({}, Window)
    self.Title = title or "UI Library"
    self.X, self.Y = 300, 150
    self.Width, self.Height = width, height
    self.TitleBarHeight = 34
    self.WatermarkHeight = 22
    self.TabBarHeight = 28
    self.SidebarWidth = 170

    self.Tabs = {}
    self.ActiveTab = nil
    self.Visible = true
    self.Minimized = false

    self.Drawings = {}
    self.Connections = {}

    self:_buildWatermark()
    self:_buildChrome()
    self:_bindDrag()

    table.insert(Lib.Windows, self)
    return self
end

function Window:_track(d)
    table.insert(self.Drawings, d)
    return d
end

function Window:_buildChrome()
    self.Background = self:_track(newDrawing("Square", {
        Size = Vector2.new(self.Width, self.Height),
        Position = Vector2.new(self.X, self.Y + self.WatermarkHeight + 8),
        Color = Theme.Background,
        Filled = true,
        ZIndex = 1,
    }))

    self.Border = newRectOutline(
        self.X, self.Y + self.WatermarkHeight + 8, self.Width, self.Height,
        Theme.Accent, 1, 2
    )

    self.TitleBar = self:_track(newDrawing("Square", {
        Size = Vector2.new(self.Width, self.TitleBarHeight),
        Position = Vector2.new(self.X, self.Y + self.WatermarkHeight + 8),
        Color = Theme.Panel,
        Filled = true,
        ZIndex = 3,
    }))

    self.TitleText = self:_track(newDrawing("Text", {
        Text = self.Title,
        Position = Vector2.new(self.X + 12, self.Y + self.WatermarkHeight + 8 + 9),
        Color = Theme.Text,
        FontSize = Theme.TextSize,
        Font = Theme.Font,
        ZIndex = 4,
    }))

    -- minimize button
    self.MinimizeBtn = self:_track(newDrawing("Text", {
        Text = "-",
        Position = Vector2.new(self.X + self.Width - 24, self.Y + self.WatermarkHeight + 8 + 8),
        Color = Theme.Text,
        FontSize = 16,
        Font = Theme.Font,
        ZIndex = 4,
    }))

    Input:Register({
        x = function() return self.X + self.Width - 30 end,
        y = function() return self.Y + self.WatermarkHeight + 8 end,
        w = function() return 30 end,
        h = function() return self.TitleBarHeight end,
        active = function() return self.Visible end,
        onClick = function() self:ToggleMinimize() end,
    })

    -- sidebar
    self.SidebarBg = self:_track(newDrawing("Square", {
        Size = Vector2.new(self.SidebarWidth, self.Height - self.TitleBarHeight - self.TabBarHeight),
        Color = Theme.Panel,
        Filled = true,
        ZIndex = 2,
    }))

    self.KeybindsLabel = self:_track(newDrawing("Text", {
        Text = "Keybinds",
        Color = Theme.Accent,
        FontSize = Theme.TextSize,
        Font = Theme.Font,
        ZIndex = 4,
    }))

    self:_layout()
end

function Window:_buildWatermark()
    self.WatermarkBg = self:_track(newDrawing("Square", {
        Size = Vector2.new(340, self.WatermarkHeight),
        Position = Vector2.new(self.X, self.Y),
        Color = Theme.Panel,
        Filled = true,
        ZIndex = 3,
    }))

    self.WatermarkBorder = newRectOutline(
        self.X, self.Y, 340, self.WatermarkHeight,
        Theme.Accent, 1, 4
    )

    self.WatermarkText = self:_track(newDrawing("Text", {
        Text = self.Title,
        Position = Vector2.new(self.X + 8, self.Y + 5),
        Color = Theme.Text,
        FontSize = 13,
        Font = Theme.Font,
        ZIndex = 5,
    }))

    self._watermarkFields = {} -- name -> value, rebuilt into text each frame
    self._lastWatermarkUpdate = 0
    self.Running = true

    safeSpawn(function()
        while self.Running do
            local ok = pcall(function()
                if self.Visible then
                    self:_refreshWatermarkText()
                end
            end)
            if not ok then
                warn("[UILibrary] watermark refresh loop errored; continuing.")
            end
            wait(0.5)
        end
    end)
end

-- Public: set arbitrary watermark fields, e.g. Window:SetWatermark({FPS=126, Ping=27})
function Window:SetWatermark(fields)
    for k, v in pairs(fields) do
        self._watermarkFields[k] = v
    end
    self:_refreshWatermarkText()
end

function Window:_refreshWatermarkText()
    local parts = { self.Title }
    -- preserve insertion-ish order isn't guaranteed in Lua tables;
    -- caller can pass an ordered array instead via SetWatermarkOrdered if needed
    for k, v in pairs(self._watermarkFields) do
        table.insert(parts, k .. " - " .. tostring(v))
    end
    self.WatermarkText.Text = table.concat(parts, " | ")
end

function Window:_layout()
    local barY = self.Y + self.WatermarkHeight + 8
    self.Background.Position = Vector2.new(self.X, barY)
    self.Background.Size = Vector2.new(self.Width, self.Height)
    self.Border:SetRect(self.X, barY, self.Width, self.Height)

    self.TitleBar.Position = Vector2.new(self.X, barY)
    self.TitleBar.Size = Vector2.new(self.Width, self.TitleBarHeight)
    self.TitleText.Position = Vector2.new(self.X + 12, barY + 9)
    self.MinimizeBtn.Position = Vector2.new(self.X + self.Width - 24, barY + 8)

    self.WatermarkBg.Position = Vector2.new(self.X, self.Y)
    self.WatermarkBorder:SetRect(self.X, self.Y, 340, self.WatermarkHeight)
    self.WatermarkText.Position = Vector2.new(self.X + 8, self.Y + 5)

    local sideY = barY + self.TitleBarHeight + self.TabBarHeight
    self.SidebarBg.Position = Vector2.new(self.X, sideY)
    self.SidebarBg.Size = Vector2.new(self.SidebarWidth, self.Height - self.TitleBarHeight - self.TabBarHeight)
    self.KeybindsLabel.Position = Vector2.new(self.X + 10, sideY + 8)

    -- tab bar
    local tx = self.X
    for i, tab in ipairs(self.Tabs) do
        tab:_layout(tx, barY + self.TitleBarHeight)
        tx = tx + tab.Width
    end

    -- content area for active tab
    local contentX = self.X + self.SidebarWidth
    local contentY = sideY
    local contentW = self.Width - self.SidebarWidth
    local contentH = self.Height - self.TitleBarHeight - self.TabBarHeight
    for _, tab in ipairs(self.Tabs) do
        tab:_layoutContent(contentX, contentY, contentW, contentH)
        tab:SetVisible(tab == self.ActiveTab and self.Visible and not self.Minimized)
    end

    local visible = self.Visible and not self.Minimized
    for _, d in ipairs(self.Drawings) do
        if d ~= self.WatermarkBg and d ~= self.WatermarkText then
            d.Visible = visible
        end
    end
    self.Border:SetVisible(visible)
    -- watermark always shows even when minimized
    self.WatermarkBg.Visible = self.Visible
    self.WatermarkBorder:SetVisible(self.Visible)
    self.WatermarkText.Visible = self.Visible
    self.SidebarBg.Visible = visible
    self.KeybindsLabel.Visible = visible
end

function Window:_bindDrag()
    Input:Register({
        x = function() return self.X end,
        y = function() return self.Y + self.WatermarkHeight + 8 end,
        w = function() return self.Width - 30 end,
        h = function() return self.TitleBarHeight end,
        active = function() return self.Visible end,
        draggable = true,
        onClick = function(mp)
            self._dragOffset = Vector2.new(mp.X - self.X, mp.Y - self.Y)
        end,
        onDrag = function(mp)
            if not self._dragOffset then return end
            self.X = mp.X - self._dragOffset.X
            self.Y = mp.Y - self._dragOffset.Y
            self:_layout()
        end,
        onRelease = function()
            self._dragOffset = nil
        end,
    })
end

function Window:ToggleMinimize()
    self.Minimized = not self.Minimized
    self:_layout()
end

function Window:SetVisible(v)
    self.Visible = v
    self:_layout()
end

function Window:Tab(name)
    local tab = Lib.Tab.new(self, name)
    table.insert(self.Tabs, tab)
    if not self.ActiveTab then
        self.ActiveTab = tab
    end
    self:_layout()
    return tab
end

function Window:SelectTab(tab)
    self.ActiveTab = tab
    self:_layout()
end

function Window:Destroy()
    self.Running = false -- stops the watermark polling loop
    for _, d in ipairs(self.Drawings) do
        destroyDrawing(d)
    end
    if self.Border then self.Border:Destroy() end
    if self.WatermarkBorder then self.WatermarkBorder:Destroy() end
    for _, tab in ipairs(self.Tabs) do
        tab:Destroy()
    end
end

--=====================================================================
-- TAB
--=====================================================================

local Tab = {}
Tab.__index = Tab
Lib.Tab = Tab

function Tab.new(window, name)
    local self = setmetatable({}, Tab)
    self.Window = window
    self.Name = name
    self.Width = math.max(80, #name * 8 + 24)
    self.Sections = {}
    self.Drawings = {}

    self.Underline = nil
    self:_build()
    return self
end

function Tab:_track(d)
    table.insert(self.Drawings, d)
    return d
end

function Tab:_build()
    self.Label = self:_track(newDrawing("Text", {
        Text = self.Name,
        Color = Theme.SubText,
        FontSize = Theme.TextSize,
        Font = Theme.Font,
        ZIndex = 4,
    }))

    Input:Register({
        x = function() return self._x end,
        y = function() return self._y end,
        w = function() return self.Width end,
        h = function() return self.Window.TabBarHeight end,
        active = function() return self.Window.Visible and not self.Window.Minimized end,
        onClick = function() self.Window:SelectTab(self) end,
    })
end

function Tab:_layout(x, y)
    self._x, self._y = x, y
    self.Label.Position = Vector2.new(x + 12, y + 6)
    self.Label.Color = (self.Window.ActiveTab == self) and Theme.Text or Theme.SubText

    for _, seg in ipairs(self._underlineSegs or {}) do
        destroyDrawing(seg)
    end
    self._underlineSegs = nil

    if self.Window.ActiveTab == self then
        self._underlineSegs = drawGradientLine(
            x, y + self.Window.TabBarHeight - 2, self.Width, 2,
            Theme.Accent, Theme.AccentDark, 8
        )
    end
end

function Tab:_layoutContent(x, y, w, h)
    local cy = y + 8
    for _, section in ipairs(self.Sections) do
        local usedH = section:_layout(x + 8, cy, w - 16)
        cy = cy + usedH + 8
    end
end

function Tab:SetVisible(v)
    self.Label.Visible = v
    for _, seg in ipairs(self._underlineSegs or {}) do
        seg.Visible = v
    end
    for _, section in ipairs(self.Sections) do
        section:SetVisible(v)
    end
end

function Tab:Section(name)
    local section = Lib.Section.new(self, name)
    table.insert(self.Sections, section)
    self.Window:_layout()
    return section
end

function Tab:Destroy()
    for _, d in ipairs(self.Drawings) do destroyDrawing(d) end
    for _, seg in ipairs(self._underlineSegs or {}) do destroyDrawing(seg) end
    for _, s in ipairs(self.Sections) do s:Destroy() end
end

--=====================================================================
-- SECTION
--=====================================================================

local Section = {}
Section.__index = Section
Lib.Section = Section

function Section.new(tab, name)
    local self = setmetatable({}, Section)
    self.Tab = tab
    self.Name = name
    self.Collapsed = false
    self.Controls = {}
    self.Drawings = {}
    self:_build()
    return self
end

function Section:_track(d)
    table.insert(self.Drawings, d)
    return d
end

function Section:_build()
    self.HeaderBg = self:_track(newDrawing("Square", {
        Color = Theme.PanelLight, Filled = true, ZIndex = 3,
    }))
    self.HeaderText = self:_track(newDrawing("Text", {
        Text = self.Name, Color = Theme.Text, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 4,
    }))
    self.ToggleGlyph = self:_track(newDrawing("Text", {
        Text = "-", Color = Theme.SubText, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 4,
    }))
    self.BodyBg = self:_track(newDrawing("Square", {
        Color = Theme.Panel, Filled = true, ZIndex = 2,
    }))

    Input:Register({
        x = function() return self._x end,
        y = function() return self._y end,
        w = function() return self._w end,
        h = function() return 26 end,
        active = function() return self.Tab.Window.ActiveTab == self.Tab and self.Tab.Window.Visible end,
        onClick = function() self:ToggleCollapse() end,
    })
end

function Section:ToggleCollapse()
    self.Collapsed = not self.Collapsed
    self.ToggleGlyph.Text = self.Collapsed and "+" or "-"
    self.Tab.Window:_layout()
end

-- lays out header + controls, returns total height used
function Section:_layout(x, y, w)
    self._x, self._y, self._w = x, y, w

    self.HeaderBg.Position = Vector2.new(x, y)
    self.HeaderBg.Size = Vector2.new(w, 26)
    self.HeaderText.Position = Vector2.new(x + 8, y + 6)
    self.ToggleGlyph.Position = Vector2.new(x + w - 16, y + 6)

    for _, seg in ipairs(self._headerLine or {}) do destroyDrawing(seg) end
    self._headerLine = drawGradientLine(x, y + 25, w, 1, Theme.Accent, Theme.AccentDark, 10)

    local cy = y + 30
    if not self.Collapsed then
        for _, ctrl in ipairs(self.Controls) do
            local h = ctrl:_layout(x + 8, cy, w - 16)
            cy = cy + h + 6
        end
    end

    local bodyH = self.Collapsed and 0 or (cy - (y + 30))
    self.BodyBg.Position = Vector2.new(x, y + 26)
    self.BodyBg.Size = Vector2.new(w, math.max(0, bodyH))
    self.BodyBg.Visible = not self.Collapsed

    for _, ctrl in ipairs(self.Controls) do
        ctrl:SetVisible(not self.Collapsed)
    end

    return 26 + (self.Collapsed and 0 or bodyH)
end

function Section:SetVisible(v)
    for _, d in ipairs(self.Drawings) do d.Visible = v end
    for _, seg in ipairs(self._headerLine or {}) do seg.Visible = v end
    for _, ctrl in ipairs(self.Controls) do
        ctrl:SetVisible(v and not self.Collapsed)
    end
end

function Section:Destroy()
    for _, d in ipairs(self.Drawings) do destroyDrawing(d) end
    for _, seg in ipairs(self._headerLine or {}) do destroyDrawing(seg) end
    for _, c in ipairs(self.Controls) do c:Destroy() end
end

--=====================================================================
-- BASE CONTROL
--=====================================================================

local Control = {}
Control.__index = Control

function Control.new(section)
    local self = setmetatable({}, Control)
    self.Section = section
    self.Drawings = {}
    return self
end

function Control:_track(d)
    table.insert(self.Drawings, d)
    return d
end

function Control:SetVisible(v)
    for _, d in ipairs(self.Drawings) do d.Visible = v end
end

function Control:Destroy()
    for _, d in ipairs(self.Drawings) do destroyDrawing(d) end
end

--=====================================================================
-- TOGGLE / CHECKBOX
--=====================================================================

local Toggle = setmetatable({}, { __index = Control })
Toggle.__index = Toggle
Lib.Toggle = Toggle

function Toggle.new(section, label, default, callback)
    local self = setmetatable(Control.new(section), Toggle)
    self.Value = default or false
    self.Callback = callback

    self.Box = self:_track(newDrawing("Square", {
        Size = Vector2.new(16, 16), Color = Theme.Accent, Filled = self.Value, Thickness = 1, ZIndex = 4,
    }))
    self.Label = self:_track(newDrawing("Text", {
        Text = label, Color = Theme.Text, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 4,
    }))

    Input:Register({
        x = function() return self._x end, y = function() return self._y end,
        w = function() return 16 end, h = function() return 16 end,
        active = function() return self._active end,
        onClick = function() self:Set(not self.Value) end,
    })

    return self
end

function Toggle:Set(v)
    self.Value = v
    self.Box.Filled = v
    if self.Callback then self.Callback(v) end
end

function Toggle:_layout(x, y, w)
    self._x, self._y = x, y
    self._active = true
    self.Box.Position = Vector2.new(x, y)
    self.Label.Position = Vector2.new(x + 24, y - 1)
    return 18
end

function Section:Toggle(label, default, callback)
    local c = Toggle.new(self, label, default, callback)
    table.insert(self.Controls, c)
    self.Tab.Window:_layout()
    return c
end

