--[[
    UILibrary.lua
    Drawing-API based UI library for Matcha LuaVM
    Chaining API pattern (INSui-style):

        local Lib = loadstring(game:HttpGet("..."))()
        local Window = Lib:CreateWindow("My UI")
        local Tab = Window:Tab("Combat")
        local Section = Tab:Section("Settings")
        Section:Toggle("Enable Thing", false, function(v) end)

    Everything here is a pure UI shell: components hold state and fire
    callbacks, but contain no game logic themselves.
]]

-- Matcha is an external executor: it does NOT expose RunService /
-- UserInputService event connections. Input is read by polling:
--   - cursor position comes from LocalPlayer:GetMouse() (Mouse.X / Mouse.Y)
--   - click state comes from ismouse1pressed() (no press/release event)
-- Everything downstream polls inside a while-loop coroutine instead of
-- binding to Roblox signals.

local function safeGetService(name)
    local ok, svc = pcall(function() return game:GetService(name) end)
    if ok then return svc end
    return nil
end

local Players = safeGetService("Players")
local LocalPlayer = Players and Players.LocalPlayer or nil

local function getMouse()
    if not LocalPlayer then return nil end
    local ok, mouse = pcall(function() return LocalPlayer:GetMouse() end)
    if ok then return mouse end
    return nil
end

local Mouse = getMouse()
local MouseAvailable = Mouse ~= nil

-- `spawn` is a Roblox global; it isn't guaranteed to exist in an
-- external executor sandbox. Try spawn -> task.spawn -> coroutine
-- as a fallback chain so a missing global can't crash library load.
local function safeSpawn(fn)
    if type(spawn) == "function" then
        local ok = pcall(spawn, fn)
        if ok then return true end
    end
    if type(task) == "table" and type(task.spawn) == "function" then
        local ok = pcall(task.spawn, fn)
        if ok then return true end
    end
    local ok = pcall(function()
        local co = coroutine.create(fn)
        coroutine.resume(co)
    end)
    return ok
end

