local Theme = {
    Background      = Color3.fromRGB(20, 20, 20),
    Panel           = Color3.fromRGB(30, 30, 30),
    PanelLight      = Color3.fromRGB(38, 38, 38),
    Border          = Color3.fromRGB(55, 55, 55),
    Text            = Color3.fromRGB(230, 230, 230),
    SubText         = Color3.fromRGB(150, 150, 150),
    Accent          = Color3.fromRGB(0, 191, 255),
    AccentDark      = Color3.fromRGB(0, 128, 255),
    -- NOTE: Theme.Font is resolved lazily below (Drawing.Fonts may not
    -- exist until the Drawing API global is available at load time).
    Font            = nil,
    TextSize        = 14,
}

-- Resolve the real font enum from Matcha's Drawing API (Drawing.Fonts.UI
-- etc.), falling back gracefully if the global isn't shaped as expected.
do
    local ok, font = pcall(function() return Drawing.Fonts.UI end)
    Theme.Font = (ok and font) or nil
end

--=====================================================================
-- INTERNAL: Drawing helpers
--=====================================================================

local ActiveDrawings = {} -- registry so we can clean everything up on re-execute

local function newDrawing(class, props)
    local obj = Drawing.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Visible = true
    table.insert(ActiveDrawings, obj)
    return obj
end

local function destroyDrawing(obj)
    if obj and obj.Remove then
        pcall(function() obj:Remove() end)
    end
end

-- Square only supports Filled/Corner in this Drawing API (no outline
-- mode), so a rectangle outline is built from 4 Line objects instead.
local RectOutline = {}
RectOutline.__index = RectOutline

local function newRectOutline(x, y, w, h, color, thickness, zIndex)
    local self = setmetatable({}, RectOutline)
    thickness = thickness or 1
    zIndex = zIndex or 5
    self.Lines = {
        top = newDrawing("Line", { Thickness = thickness, Color = color, ZIndex = zIndex }),
        bottom = newDrawing("Line", { Thickness = thickness, Color = color, ZIndex = zIndex }),
        left = newDrawing("Line", { Thickness = thickness, Color = color, ZIndex = zIndex }),
        right = newDrawing("Line", { Thickness = thickness, Color = color, ZIndex = zIndex }),
    }
    self:SetRect(x, y, w, h)
    return self
end

function RectOutline:SetRect(x, y, w, h)
    self.Lines.top.From = Vector2.new(x, y)
    self.Lines.top.To = Vector2.new(x + w, y)
    self.Lines.bottom.From = Vector2.new(x, y + h)
    self.Lines.bottom.To = Vector2.new(x + w, y + h)
    self.Lines.left.From = Vector2.new(x, y)
    self.Lines.left.To = Vector2.new(x, y + h)
    self.Lines.right.From = Vector2.new(x + w, y)
    self.Lines.right.To = Vector2.new(x + w, y + h)
end

function RectOutline:SetColor(color)
    for _, line in pairs(self.Lines) do line.Color = color end
end

function RectOutline:SetVisible(v)
    for _, line in pairs(self.Lines) do line.Visible = v end
end

function RectOutline:Destroy()
    for _, line in pairs(self.Lines) do destroyDrawing(line) end
end

-- draws a horizontal gradient line by stacking thin colored segments
local function drawGradientLine(x, y, width, thickness, colorA, colorB, steps)
    steps = steps or 12
    local segments = {}
    local segW = width / steps
    for i = 0, steps - 1 do
        local t = i / (steps - 1)
        local col = colorA:Lerp(colorB, t)
        local seg = newDrawing("Line", {
            From = Vector2.new(x + i * segW, y),
            To = Vector2.new(x + (i + 1) * segW, y),
            Color = col,
            Thickness = thickness,
            ZIndex = 5,
        })
        table.insert(segments, seg)
    end
    return segments
end

local function pointInRect(px, py, x, y, w, h)
    return px >= x and px <= x + w and py >= y and py <= y + h
end

--=====================================================================
-- INPUT MANAGER
--=====================================================================

local InputManager = {}
InputManager.__index = InputManager

function InputManager.new()
    local self = setmetatable({}, InputManager)
    self.MouseDown = false
    self.MousePos = Vector2.new(0, 0)
    self.MouseAvailable = MouseAvailable
    self.Dragging = nil     -- currently dragged element {onDrag = fn, onRelease = fn}
    self.Clickables = {}    -- list of {x,y,w,h (functions or numbers), onClick}
    self.Running = true
    self:_startLoop()
    return self
end

function InputManager:_pollMousePos()
    if not self.MouseAvailable then return end
    local ok, x, y = pcall(function() return Mouse.X, Mouse.Y end)
    if ok and x and y then
        self.MousePos = Vector2.new(x, y)
    else
        -- Mouse object stopped working mid-session; mark unavailable
        -- rather than repeatedly erroring every loop tick.
        self.MouseAvailable = false
    end
end

-- Matcha exposes input via polling functions (ismouse1pressed,
-- iskeypressed) rather than Roblox events, so the whole input system
-- runs as a simple game loop instead of signal connections.
function InputManager:_startLoop()
    safeSpawn(function()
        while self.Running do
            local ok = pcall(function()
                self:_pollMousePos()

                local down = ismouse1pressed and ismouse1pressed() or false

                if down and not self.MouseDown then
                    -- rising edge: button just pressed
                    self.MouseDown = true
                    self:_handleMouseDown()
                elseif not down and self.MouseDown then
                    -- falling edge: button just released
                    self.MouseDown = false
                    if self.Dragging and self.Dragging.onRelease then
                        self.Dragging.onRelease()
                    end
                    self.Dragging = nil
                elseif down and self.MouseDown and self.Dragging and self.Dragging.onDrag then
                    self.Dragging.onDrag(self.MousePos)
                end
            end)

            if not ok then
                warn("[UILibrary] input loop tick errored; continuing.")
            end

            wait(1 / 60)
        end
    end)
end

function InputManager:Stop()
    self.Running = false
end

function InputManager:_handleMouseDown()
    local mp = self.MousePos
    -- iterate in reverse so top-most (last drawn) elements get priority
    for i = #self.Clickables, 1, -1 do
        local c = self.Clickables[i]
        if c.active == nil or c.active() then
            local x, y, w, h = c.x(), c.y(), c.w(), c.h()
            if pointInRect(mp.X, mp.Y, x, y, w, h) then
                if c.onClick then c.onClick(mp) end
                if c.draggable then
                    self.Dragging = {
                        onDrag = c.onDrag,
                        onRelease = c.onRelease,
                    }
                end
                return true
            end
        end
    end
    return false
end

function InputManager:Register(entry)
    -- entry = {x=fn, y=fn, w=fn, h=fn, onClick=fn, draggable=bool, onDrag=fn, onRelease=fn, active=fn}
    table.insert(self.Clickables, entry)
    return entry
end

function InputManager:Unregister(entry)
    for i, c in ipairs(self.Clickables) do
        if c == entry then
            table.remove(self.Clickables, i)
            break
        end
    end
end

print("[UILibrary] about to construct InputManager...")
local Input
do
    local ok, result = pcall(InputManager.new)
    if ok then
        Input = result
        print("[UILibrary] InputManager constructed OK")
    else
        warn("[UILibrary] InputManager.new() FAILED: " .. tostring(result))
        -- fall back to a stub so the rest of the library can still
        -- load; controls just won't receive input, but Lib won't be nil.
        Input = setmetatable({
            Clickables = {},
            Register = function(self, e) table.insert(self.Clickables, e); return e end,
            Unregister = function(self, e) end,
            Stop = function(self) end,
        }, { __index = function() return function() end end })
    end
end

