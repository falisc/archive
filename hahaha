--=====================================================================

local TextInput = setmetatable({}, { __index = Control })
TextInput.__index = TextInput
Lib.TextInput = TextInput

function TextInput.new(section, placeholder, callback)
    local self = setmetatable(Control.new(section), TextInput)
    self.Value = ""
    self.Placeholder = placeholder or ""
    self.Callback = callback
    self.Focused = false

    self.Bg = self:_track(newDrawing("Square", {
        Size = Vector2.new(100, 22), Color = Theme.PanelLight, Filled = true, ZIndex = 4,
    }))
    self.Border = newRectOutline(0, 0, 100, 22, Theme.Border, 1, 5)
    self.Text = self:_track(newDrawing("Text", {
        Text = self.Placeholder, Color = Theme.SubText, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 6,
    }))

    Input:Register({
        x = function() return self._x end, y = function() return self._y end,
        w = function() return self._w end, h = function() return 22 end,
        active = function() return self._active end,
        onClick = function() self:Focus() end,
    })

    -- NOTE: keyboard capture isn't defined in the Matcha input docs
    -- provided (only iskeypressed()/keypress()/keyrelease() for
    -- simulating/checking individual keys, no text-composition event).
    -- Poll iskeypressed(keycode) for each key you want to support in
    -- your own loop and feed characters into self:SetText(...) while
    -- self.Focused is true.

    return self
end

function TextInput:Focus()
    self.Focused = true
    self.Border:SetColor(Theme.Accent)
end

function TextInput:Unfocus()
    self.Focused = false
    self.Border:SetColor(Theme.Border)
end

function TextInput:SetText(v)
    self.Value = v
    self.Text.Text = (v == "" and self.Placeholder or v)
    self.Text.Color = (v == "" and Theme.SubText or Theme.Text)
    if self.Callback then self.Callback(v) end
end

function TextInput:_layout(x, y, w)
    self._x, self._y, self._w = x, y, w
    self._active = true
    self.Bg.Position = Vector2.new(x, y)
    self.Bg.Size = Vector2.new(w, 22)
    self.Border:SetRect(x, y, w, 22)
    self.Text.Position = Vector2.new(x + 6, y + 4)
    return 22
end

function TextInput:SetVisible(v)
    Control.SetVisible(self, v)
    self.Border:SetVisible(v)
end

function TextInput:Destroy()
    Control.Destroy(self)
    self.Border:Destroy()
end

function Section:TextInput(placeholder, callback)
    local c = TextInput.new(self, placeholder, callback)
    table.insert(self.Controls, c)
    self.Tab.Window:_layout()
    return c
end

--=====================================================================
-- DROPDOWN
--=====================================================================

local Dropdown = setmetatable({}, { __index = Control })
Dropdown.__index = Dropdown
Lib.Dropdown = Dropdown

function Dropdown.new(section, label, options, default, callback)
    local self = setmetatable(Control.new(section), Dropdown)
    self.Options = options or {}
    self.Value = default or self.Options[1]
    self.Callback = callback
    self.Open = false

    self.Header = self:_track(newDrawing("Square", {
        Size = Vector2.new(100, 22), Color = Theme.PanelLight, Filled = true, ZIndex = 4,
    }))
    self.HeaderText = self:_track(newDrawing("Text", {
        Text = ("%s"):format(tostring(self.Value)),
        Color = Theme.Text, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 5,
    }))
    self.Glyph = self:_track(newDrawing("Text", {
        Text = "+", Color = Theme.SubText, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 5,
    }))

    self.OptionDrawings = {} -- rebuilt when opened

    Input:Register({
        x = function() return self._x end, y = function() return self._y end,
        w = function() return self._w end, h = function() return 22 end,
        active = function() return self._active end,
        onClick = function() self:Toggle() end,
    })

    return self
end

function Dropdown:_clearOptions()
    for _, entry in ipairs(self.OptionDrawings) do
        destroyDrawing(entry.bg)
        destroyDrawing(entry.text)
        Input:Unregister(entry.clickable)
    end
    self.OptionDrawings = {}
end

function Dropdown:Toggle()
    self.Open = not self.Open
    self.Glyph.Text = self.Open and "-" or "+"
    self:_clearOptions()

    if self.Open then
        for i, opt in ipairs(self.Options) do
            local oy = self._y + 22 + (i - 1) * 20
            local bg = newDrawing("Square", {
                Position = Vector2.new(self._x, oy), Size = Vector2.new(self._w, 20),
                Color = Theme.Panel, Filled = true, ZIndex = 10,
            })
            local text = newDrawing("Text", {
                Position = Vector2.new(self._x + 6, oy + 3), Text = tostring(opt),
                Color = Theme.Text, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 11,
            })
            local clickable = Input:Register({
                x = function() return self._x end, y = function() return oy end,
                w = function() return self._w end, h = function() return 20 end,
                active = function() return self.Open end,
                onClick = function()
                    self:Set(opt)
                    self:Toggle()
                end,
            })
            table.insert(self.OptionDrawings, { bg = bg, text = text, clickable = clickable })
        end
    end
end

function Dropdown:Set(v)
    self.Value = v
    self.HeaderText.Text = tostring(v)
    if self.Callback then self.Callback(v) end
end

function Dropdown:_layout(x, y, w)
    self._x, self._y, self._w = x, y, w
    self._active = true
    self.Header.Position = Vector2.new(x, y)
    self.Header.Size = Vector2.new(w, 22)
    self.HeaderText.Position = Vector2.new(x + 6, y + 4)
    self.Glyph.Position = Vector2.new(x + w - 14, y + 4)
    return 22
end

function Dropdown:SetVisible(v)
    Control.SetVisible(self, v)
    for _, entry in ipairs(self.OptionDrawings) do
        entry.bg.Visible = v
        entry.text.Visible = v
    end
end

function Dropdown:Destroy()
    Control.Destroy(self)
    self:_clearOptions()
end

function Section:Dropdown(label, options, default, callback)
    local c = Dropdown.new(self, label, options, default, callback)
    table.insert(self.Controls, c)
    self.Tab.Window:_layout()
    return c
end

--=====================================================================
-- COLOR PICKER (simple swatch + expandable RGB sliders)
--=====================================================================

local ColorPicker = setmetatable({}, { __index = Control })
ColorPicker.__index = ColorPicker
Lib.ColorPicker = ColorPicker

function ColorPicker.new(section, label, default, callback)
    local self = setmetatable(Control.new(section), ColorPicker)
    self.Value = default or Color3.fromRGB(0, 191, 255)
    self.Callback = callback
    self.Open = false

    self.Label = self:_track(newDrawing("Text", {
        Text = label, Color = Theme.Text, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 4,
    }))
    self.Swatch = self:_track(newDrawing("Square", {
        Size = Vector2.new(18, 18), Color = self.Value, Filled = true, ZIndex = 5,
    }))
    self.SwatchBorder = newRectOutline(0, 0, 18, 18, Theme.Border, 1, 6)

    self.RSlider, self.GSlider, self.BSlider = nil, nil, nil

    Input:Register({
        x = function() return self._swatchX end, y = function() return self._y end,
        w = function() return 18 end, h = function() return 18 end,
        active = function() return self._active end,
        onClick = function() self:Toggle() end,
    })

    return self
end

function ColorPicker:Toggle()
    self.Open = not self.Open
    self.Section.Tab.Window:_layout()
end

function ColorPicker:Set(color)
    self.Value = color
    self.Swatch.Color = color
    if self.Callback then self.Callback(color) end
end

function ColorPicker:_layout(x, y, w)
    self._x, self._y, self._w = x, y, w
    self._active = true
    self.Label.Position = Vector2.new(x, y)
    self._swatchX = x + w - 22
    self.Swatch.Position = Vector2.new(self._swatchX, y - 2)
    self.SwatchBorder:SetRect(self._swatchX, y - 2, 18, 18)

    local used = 18

    if self.Open then
        local r, g, b = math.floor(self.Value.R * 255), math.floor(self.Value.G * 255), math.floor(self.Value.B * 255)

        if not self.RSlider then
            self.RSlider = Slider.new(self.Section, "R", 0, 255, r, function(v) self:Set(Color3.fromRGB(v, self.GSlider.Value, self.BSlider.Value)) end)
            self.GSlider = Slider.new(self.Section, "G", 0, 255, g, function(v) self:Set(Color3.fromRGB(self.RSlider.Value, v, self.BSlider.Value)) end)
            self.BSlider = Slider.new(self.Section, "B", 0, 255, b, function(v) self:Set(Color3.fromRGB(self.RSlider.Value, self.GSlider.Value, v)) end)
        end

        local sy = y + 22
        sy = sy + self.RSlider:_layout(x, sy, w) + 6
        sy = sy + self.GSlider:_layout(x, sy, w) + 6
        sy = sy + self.BSlider:_layout(x, sy, w) + 6
        self.RSlider:SetVisible(true)
        self.GSlider:SetVisible(true)
        self.BSlider:SetVisible(true)
        used = (sy - y)
    else
        if self.RSlider then
            self.RSlider:SetVisible(false)
            self.GSlider:SetVisible(false)
            self.BSlider:SetVisible(false)
        end
    end

    return used
end

function Section:ColorPicker(label, default, callback)
    local c = ColorPicker.new(self, label, default, callback)
    table.insert(self.Controls, c)
    self.Tab.Window:_layout()
    return c
end

