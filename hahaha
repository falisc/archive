--=====================================================================
-- SLIDER
--=====================================================================

local Slider = setmetatable({}, { __index = Control })
Slider.__index = Slider
Lib.Slider = Slider

function Slider.new(section, label, min, max, default, callback, step)
    local self = setmetatable(Control.new(section), Slider)
    self.Min, self.Max = min, max
    self.Step = step or 1
    self.Value = default or min
    self.Callback = callback

    self.Label = self:_track(newDrawing("Text", {
        Text = ("%s: %s"):format(label, tostring(self.Value)),
        Color = Theme.Text, FontSize = Theme.TextSize, Font = Theme.Font, ZIndex = 4,
    }))
    self.LabelBase = label

    self.Track = self:_track(newDrawing("Square", {
        Size = Vector2.new(100, 4), Color = Theme.PanelLight, Filled = true, ZIndex = 4,
    }))
    self.Fill = self:_track(newDrawing("Square", {
        Size = Vector2.new(0, 4), Color = Theme.Accent, Filled = true, ZIndex = 5,
    }))

    Input:Register({
        x = function() return self._x end, y = function() return self._y end,
        w = function() return self._w end, h = function() return 10 end,
        active = function() return self._active end,
        draggable = true,
        onClick = function(mp) self:_setFromMouse(mp.X) end,
        onDrag = function(mp) self:_setFromMouse(mp.X) end,
    })

    return self
end

function Slider:_setFromMouse(mx)
    local pct = math.clamp((mx - self._x) / self._w, 0, 1)
    local raw = self.Min + pct * (self.Max - self.Min)
    local stepped = math.floor(raw / self.Step + 0.5) * self.Step
    self:Set(stepped)
end

function Slider:Set(v)
    v = math.clamp(v, self.Min, self.Max)
    self.Value = v
    local pct = (self.Max > self.Min) and (v - self.Min) / (self.Max - self.Min) or 0
    self.Fill.Size = Vector2.new(self._w * pct, 4)
    self.Label.Text = ("%s: %s"):format(self.LabelBase, tostring(v))
    if self.Callback then self.Callback(v) end
end

function Slider:_layout(x, y, w)
    self._x, self._y, self._w = x, y + 16, w
    self._active = true
    self.Label.Position = Vector2.new(x, y)
    self.Track.Position = Vector2.new(x, y + 16)
    self.Track.Size = Vector2.new(w, 4)
    self.Fill.Position = Vector2.new(x, y + 16)
    self:Set(self.Value)
    return 26
end

function Section:Slider(label, min, max, default, callback, step)
    local c = Slider.new(self, label, min, max, default, callback, step)
    table.insert(self.Controls, c)
    self.Tab.Window:_layout()
    return c
end

