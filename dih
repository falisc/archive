            end
        end
    end
    if window.ShowKeybindOverlay then
        local entries = keybindEntries(window)
        local width = 196
        local visibleCount = math.min(#entries, 9)
        local height = 30 + visibleCount * 22 + (#entries > visibleCount and 18 or 0)
        local x, y = updateOverlayDrag(window, "keybinds",
            window.KeybindOverlayX or 14, window.KeybindOverlayY or 54, width, height)
