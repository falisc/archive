    paintImageRect(colourAlphaSheet(r, g, b), fieldX, barY, barWidth, barHeight, 4, 1, z + 24)
    paintRect(fieldX, barY, barWidth, barHeight, Theme.Border, 0.72, z + 25, 4, false, 1)
