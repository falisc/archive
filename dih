function RimuruUI.IsMouseOver(x, y, width, height)
    return state.HasMouse and state.MouseX >= x and state.MouseX <= x + width and
        state.MouseY >= y and state.MouseY <= y + height
end

function RimuruUI.ConsumeMousePress(x, y, width, height)
    if state.MousePressConsumed or not Keys.m1.Pressed or not RimuruUI.IsMouseOver(x, y, width, height) then
        return false
    end
    state.MousePressConsumed = true



    if state.KeybindModeItem and state.KeybindModeItem.ModePopupBounds then
        local bounds = state.KeybindModeItem.ModePopupBounds
        if not RimuruUI.IsMouseOver(bounds.X, bounds.Y, bounds.Width, bounds.Height) then
            state.KeybindModeItem.ModePopupBounds = nil
            state.KeybindModeItem = nil
        end
    end
    return true
end

function RimuruUI.ConsumeMouseRightPress(x, y, width, height)
    if state.MouseRightConsumed or not Keys.m2.Pressed or not RimuruUI.IsMouseOver(x, y, width, height) then
        return false
    end
    state.MouseRightConsumed = true
    return true
end

function RimuruUI.CloseTransientMenus(exception)
    local windows = RimuruUI.Windows or {}
    for windowIndex = 1, #windows do
        local window = windows[windowIndex]
        for categoryIndex = 1, #window.Categories do
            for tabIndex = 1, #window.Categories[categoryIndex].Tabs do
                local tab = window.Categories[categoryIndex].Tabs[tabIndex]
                for sectionIndex = 1, #tab.Sections do
                    for itemIndex = 1, #tab.Sections[sectionIndex].Items do
                        local item = tab.Sections[sectionIndex].Items[itemIndex]
                        if item ~= exception then
                            if item.Type == "dropdown" or item.Type == "colorpicker" then item.Open = false end
                            if item.ColorPicker and item.ColorPicker ~= exception then item.ColorPicker.Open = false end
                            if state.KeybindModeItem == item then
                                item.ModePopupBounds = nil
                                state.KeybindModeItem = nil
                            end
                        end
                    end
                end
            end
        end
    end
    if state.ColorPickerOpen ~= exception then state.ColorPickerOpen = nil end
    if state.Capture and state.Capture.Kind == "dropdownSearch" and state.Capture.Item ~= exception then
        state.Capture = nil
        setGameInput(true)
    end
    if state.KeybindModeItem and state.KeybindModeItem ~= exception then
        state.KeybindModeItem.ModePopupBounds = nil
        state.KeybindModeItem = nil
    end
end

function RimuruUI.IsShiftDown()
    return RimuruUI.IsDown("shift") or RimuruUI.IsDown("lshift") or RimuruUI.IsDown("rshift")
end

function RimuruUI.IsCtrlDown()
    return RimuruUI.IsDown("ctrl") or RimuruUI.IsDown("lctrl") or RimuruUI.IsDown("rctrl")
end

function RimuruUI.Bind(keyName, callback, mode)
    local name = lower(tostring(keyName or ""))
    assert(Keys[name] or mode == "always", "unknown key: " .. name)
    local bind = {
        Key = name,
        Mode = lower(tostring(mode or "toggle")),
        Callback = callback,
        Enabled = false,
        Armed = false,
        Removed = false,
    }
    state.Binds[#state.Binds + 1] = bind
    return bind
end

function RimuruUI.Unbind(bind)
    if type(bind) ~= "table" then return false end
    bind.Removed = true
    for i = #state.Binds, 1, -1 do
        if state.Binds[i] == bind then
            table.remove(state.Binds, i)
            return true
        end
    end
    return false
end

function RimuruUI.ProcessBinds()
    for i = #state.Binds, 1, -1 do
        local bind = state.Binds[i]
        if bind.Removed then
            table.remove(state.Binds, i)
        elseif type(bind.Callback) == "function" then
            local key = Keys[bind.Key]
            if bind.Mode == "always" then
                if not bind.Enabled then
                    bind.Enabled = true
                    bind.Callback(bind.Key, true)
                end
            elseif key then
                if bind.Armed then
                    if not key.Down then bind.Armed = false end
                elseif bind.Mode == "hold" then
                    if bind.Enabled ~= key.Down then
                        bind.Enabled = key.Down
                        bind.Callback(bind.Key, bind.Enabled)
                    end
                elseif key.Pressed then
                    bind.Enabled = not bind.Enabled
                    bind.Callback(bind.Key, bind.Enabled)
                end
            end
        end
    end
end

function RimuruUI.CaptureKey(options, callback)
    options = options or {}
    if state.Capture and (state.Capture.Kind == "search" or state.Capture.Kind == "dropdownSearch") then
        setGameInput(true)
    end
    state.Capture = {
        Banned = options.Blacklist or options.Banned,
        Callback = callback,
        Armed = false,
    }
    return state.Capture
end

function RimuruUI.CaptureNumber(item)
    if state.Capture and (state.Capture.Kind == "search" or state.Capture.Kind == "dropdownSearch") then
        setGameInput(true)
    end
    setGameInput(false)
    state.Capture = {
        Kind = "number",
        Item = item,
        Buffer = tostring(math.floor((item.Value or 0) * 100 + 0.5) / 100),
    }
    return state.Capture
end

function RimuruUI.CaptureSearch(window)
    setGameInput(false)
    state.Capture = {
        Kind = "search",
        Window = window,
        Buffer = tostring(window.SearchQuery or ""),
    }
    return state.Capture
end

function RimuruUI.CaptureDropdownSearch(item)
    if state.Capture and state.Capture.Kind == "search" then
        setGameInput(true)
    end
    setGameInput(false)
    state.Capture = {
        Kind = "dropdownSearch",
        Item = item,
        Buffer = tostring(item.DropdownQuery or ""),
    }
    return state.Capture
end

function RimuruUI.CancelCapture()
    if state.Capture and (state.Capture.Kind == "search" or state.Capture.Kind == "dropdownSearch" or
        state.Capture.Kind == "number") then
        setGameInput(true)
    end
    state.Capture = nil
end

local function finishNumberCapture(capture, commit)
    local item = capture and capture.Item
    if commit then
        local number = tonumber(capture.Buffer)
        if number and item then
            item.Value = clamp(number, item.Min, item.Max)
            if type(item.Callback) == "function" then pcall(item.Callback, item.Value, item) end
            if type(RimuruUI.MarkConfigDirty) == "function" then RimuruUI.MarkConfigDirty(item) end
        end
    end
    state.Capture = nil
    setGameInput(true)
end

function RimuruUI.ProcessCapture()
    local capture = state.Capture
    if not capture then return end
    if capture.Kind == "search" then
        local window = capture.Window
        for i = 1, #Order do
            local name = Order[i]
            local key = Keys[name]
            if key.Pressed then
                key.Pressed = false
                if name == "enter" then
                    if window then window.SearchQuery = capture.Buffer end
                    state.Capture = nil
                    setGameInput(true)
                    debugLog("search commit", capture.Buffer)
                    return
                elseif name == "esc" then
                    if window then window.SearchQuery = "" end
                    state.Capture = nil
                    setGameInput(true)
                    debugLog("search clear")
                    return
                elseif name == "backspace" then
                    capture.Buffer = sub(capture.Buffer, 1, math.max(0, #capture.Buffer - 1))
                elseif name == "space" then
                    capture.Buffer = capture.Buffer .. " "
                elseif key.Character and #capture.Buffer < 32 then
                    local character = RimuruUI.IsShiftDown() and (key.Shifted or key.Character) or key.Character
                    capture.Buffer = capture.Buffer .. tostring(character)
                end
                if window then window.SearchQuery = capture.Buffer end
            end
        end
        return
    end
    if capture.Kind == "dropdownSearch" then
        local item = capture.Item
        for i = 1, #Order do
            local name = Order[i]
            local key = Keys[name]
            if key.Pressed then
                key.Pressed = false
                if name == "enter" or name == "esc" then
                    if name == "esc" and item then item.DropdownQuery = "" end
                    state.Capture = nil
                    setGameInput(true)
                    return
                elseif name == "backspace" then
                    capture.Buffer = sub(capture.Buffer, 1, math.max(0, #capture.Buffer - 1))
                elseif name == "space" then
                    capture.Buffer = capture.Buffer .. " "
                elseif key.Character and #capture.Buffer < 32 then
                    local character = RimuruUI.IsShiftDown() and (key.Shifted or key.Character) or key.Character
                    capture.Buffer = capture.Buffer .. tostring(character)
                end
                if item then item.DropdownQuery = capture.Buffer end
            end
        end
        return
    end
    if capture.Kind == "number" then
        local item = capture.Item
        local bounds = item and item.NumberInputBounds
        if Keys.m1.Pressed and type(bounds) == "table" and
            not RimuruUI.IsMouseOver(bounds.X, bounds.Y, bounds.Width, bounds.Height) then
            finishNumberCapture(capture, true)
            return
        end
        for i = 1, #Order do
            local name = Order[i]
            local key = Keys[name]
            if key.Pressed then
                key.Pressed = false
                if name == "enter" then
                    finishNumberCapture(capture, true)
                    return
                elseif name == "esc" then
                    finishNumberCapture(capture, false)
                    return
                elseif name == "backspace" then
                    capture.Buffer = sub(capture.Buffer, 1, math.max(0, #capture.Buffer - 1))
                elseif name == "period" and not string.find(capture.Buffer, "%.", 1, true) then
                    capture.Buffer = capture.Buffer == "" and "0." or capture.Buffer .. "."
                elseif name == "minus" and capture.Buffer == "" then
                    capture.Buffer = "-"
                elseif name >= "0" and name <= "9" then
                    if #capture.Buffer < 12 then capture.Buffer = capture.Buffer .. name end
                end
            end
        end
        return
    end
    if capture.Armed == false then
        if not Keys.m1.Down and not Keys.m2.Down then capture.Armed = true end
        return
    end
    for i = 1, #Order do
        local name = Order[i]
        local key = Keys[name]
        local banned = isBanned(capture.Banned, name)
        if key.Pressed and not banned then
            local result = name == "esc" and nil or name
            state.Capture = nil
            key.Pressed = false
            if name == "m1" then state.MousePressConsumed = true end
            if name == "m2" then state.MouseRightConsumed = true end
            if type(capture.Callback) == "function" then capture.Callback(result) end
            return result
        end
    end
end

