local Pool = { Square = {}, Line = {}, Circle = {}, Triangle = {}, Image = {}, Text = {} }
local Used = { Square = 0, Line = 0, Circle = 0, Triangle = 0, Image = 0, Text = 0 }
local ImageDataCache = {}
local StableImages, StableImageUsed = {}, {}

local function takePrimitive(kind)
    if not lifecycleToken.Alive or runtimeEnvironment.RimuruUIGeneration ~= runtimeGeneration then
        return nil
    end
    Used[kind] = Used[kind] + 1
    local index = Used[kind]
    local object = Pool[kind][index]
    if object then return object end
    local ok, created = pcall(Drawing.new, kind)
    if not ok or not created then return nil end
    Pool[kind][index] = created
    registeredPrimitives[#registeredPrimitives + 1] = created
    pcall(function() created.Visible = false end)
    return created
end

local function primitivePosition(object, x, y)
    object.Position = Vector2Type(x, y)
end

local function setDrawingProperty(object, property, value)
