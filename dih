    setDrawingProperty(object, "Color", colour)
    object.Transparency = renderTransparency(transparency)
    object.ZIndex = z or 1
    object.Filled = filled ~= false
    if filled == false then object.Thickness = thickness or 1 end
    if radius then pcall(function() object.Corner = radius end) end
    object.Visible = true
end

