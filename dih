local function renderSectionItem(item, x, y, width, z)
    local row = { x, y, width, item.Height or 28 }
    local rowHeight = item.Height or 30
    local textY = y + math.floor((rowHeight - 11) / 2)
    if item.Type == "label" then
        local lines = labelLines(item.Text, 11, width)
        item.WrappedLines = lines
        if not item.FixedHeight then item.Height = math.max(30, #lines * 15 + 10) end
        local lineHeight = 15
        local lineY = y + math.floor((rowHeight - #lines * lineHeight) / 2) + 2
        for index = 1, #lines do
            paintText(lines[index], x, lineY + (index - 1) * lineHeight,
                Theme.HoverText, 11, 1, z + index - 1)
        end
    elseif item.Type == "colorpicker" then
        renderColorPicker(item, x, y, width, z, false)
    elseif item.Type == "toggle" then
        local hovered = RimuruUI.IsMouseOver(x, y, width, rowHeight)
        item.Hover = approach(item.Hover or 0, hovered and 1 or 0, 18)
        if item.Hover > 0.01 then
            paintRect(x, y + 2, width, rowHeight - 4, Theme.CardHover,
                item.Hover * 0.22, z - 1, 5)
        end
        paintText(item.Text, x, textY,
            colourMix(Theme.Text, Theme.HoverText, item.Hover), 11, 1, z)
        local bx, by = x + width - 22, y + math.floor((rowHeight - 18) / 2)
        if item.Keybind then
            local keyLabelWidth = math.max(24, #keyLabel(item.Keybind.Value or "None") * 5 + 12)
            renderKeybindBadge(item.Keybind, bx - keyLabelWidth - 8,
                y + math.floor((rowHeight - 18) / 2), keyLabelWidth, z + 2, 18, 10)
        end
        if item.ColorPicker then
            renderColorPicker(item.ColorPicker, bx - 28, y + math.floor((rowHeight - 18) / 2), 20, z + 2, true)
        end
        paintRect(bx, by, 18, 18, Theme.Panel, 0.86, z, 5)
            paintRect(bx, by, 18, 18, item.Value and Theme.Accent or Theme.Border,
            item.Value and 0.18 or 0.72, z + 1, 5, false, 1)
        item.Fill = approach(item.Fill or 0, item.Value and 1 or 0, 18)
        local fillSize = 12 * item.Fill
        if fillSize > 0.2 then
            paintRect(bx + 3 + (12 - fillSize) / 2, by + 3 + (12 - fillSize) / 2,
                fillSize, fillSize, Theme.Accent, 0.92, z + 2, 3)
        end
        if RimuruUI.ConsumeMousePress(x, y, width, item.Height or 28) then
            item.Value = not item.Value
            debugLog("toggle", item.Text, item.Value)
            invoke(item.Callback, item.Value, item)
        end
    elseif item.Type == "keybind" then
        local hovered = RimuruUI.IsMouseOver(x, y, width, rowHeight)
        item.Hover = approach(item.Hover or 0, hovered and 1 or 0, 18)
        paintText(item.Text, x, textY,
            colourMix(Theme.Text, Theme.HoverText, item.Hover), 11, 1, z)
        local valueLabel = keyLabel(item.Value or "None")
        local badgeWidth = math.max(24, #valueLabel * 5 + 12)
        local bx = x + width - badgeWidth
        local badgeY = y + math.floor((rowHeight - 18) / 2)
        local captured = renderKeybindBadge(item, bx, badgeY, badgeWidth, z, 18, 10)
        if not captured and RimuruUI.ConsumeMousePress(x, y, width, item.Height or 28) then
            item.Capturing = true
            RimuruUI.CaptureKey({}, function(key)
                item.Value = key or "None"
                item.Capturing = false
                invoke(item.Callback, item.Value, item)
            end)
        end
    elseif item.Type == "button" then
        local hovered = RimuruUI.IsMouseOver(x, y, width, item.Height or 30)
        local buttonY, buttonHeight = y + 4, 22
        local buttonWidth, buttonX = 116, x + width - 116
        item.Hover = approach(item.Hover or 0, hovered and 1 or 0, 18)
        item.Press = approach(item.Press or 0, 0, 24)
        local pressOffset = item.Press * 1.25
        buttonY = buttonY + pressOffset
        buttonHeight = buttonHeight - pressOffset * 2
        buttonWidth = buttonWidth - pressOffset * 2
        buttonX = buttonX + pressOffset
        local hoverAmount = item.Hover
        local buttonRadius = 8 + math.floor(hoverAmount * 2)
        paintText(item.Text, x, textY, colourMix(Theme.Text, Theme.HoverText, hoverAmount), 11, 1, z)
        paintRect(buttonX, buttonY, buttonWidth, buttonHeight,
            colourMix(Theme.Accent, Theme.AccentDark, hoverAmount),
            0.98, z, buttonRadius)
        paintRect(buttonX, buttonY, buttonWidth, buttonHeight,
            colourMix(Theme.Accent, Theme.AccentDark, hoverAmount),
            0.98, z + 1, buttonRadius, false, 1)



        local clickColour = item.Window and item.Window.ThemeName == "Rimuru Dark" and
            Theme.Background or Theme.Text
        paintIcon("click", buttonX + buttonWidth / 2, buttonY + buttonHeight / 2,
            clickColour, z + 2, 1)
        if RimuruUI.ConsumeMousePress(x, y, width, item.Height or 30) then
            item.Press = 1
            debugLog("button click", item.Text)
            invoke(item.Callback, true, item)
        end
    elseif item.Type == "slider" then
        local clipTop = state.ClipTop or -math.huge
        local clipBottom = state.ContentFadeBottom or state.ClipBottom or math.huge
        local textOpacity = viewportOpacity(y + 5, 11, clipTop, clipBottom, 8)
        local sliderHovered = RimuruUI.IsMouseOver(x, y, width, item.Height or 28)
        item.Hover = approach(item.Hover or 0, sliderHovered and 1 or 0, 18)
        paintText(item.Text, x, y + 5,
            colourMix(Theme.Text, Theme.HoverText, item.Hover), 11, textOpacity, z)
        local minValue, maxValue = item.Min, item.Max
        local range = math.max(1, maxValue - minValue)
        item.VisualValue = approach(item.VisualValue or item.Value, item.Value, 20)
        local amount = math.max(0, math.min(1, (item.VisualValue - minValue) / range))
        local valueBoxWidth, valueBoxHeight = 42, 16
        local lineX, lineY = x + 1, y + 26
        local lineWidth = math.max(24, width - 2)
        local sliderOpacity = viewportOpacity(lineY - 5, 10, clipTop, clipBottom, 8)
        paintRect(lineX, lineY - 5, lineWidth, 10,
            Theme.Card, sliderOpacity * 0.88, z, 5)
        paintRect(lineX, lineY - 5, lineWidth, 10,
            Theme.Border, sliderOpacity * 0.82, z + 1, 5, false, 1)
        if amount > 0 then
            paintRect(lineX, lineY - 5, math.max(1, lineWidth * amount), 10,
                Theme.Accent, sliderOpacity, z + 2, 5)
            local capX = lineX + math.max(1, math.min(lineWidth - 1, lineWidth * amount))
            paintRect(capX - 1, lineY - 4, 2, 8, Theme.Card, sliderOpacity, z + 3, 1)
        end
        local editing = state.Capture and state.Capture.Kind == "number" and state.Capture.Item == item
        local shownValue = editing and state.Capture.Buffer or
            tostring(math.floor(item.Value * 100 + 0.5) / 100)
        local valueBoxX, valueBoxY = x + width - valueBoxWidth, y + 2
        item.NumberInputBounds = {
            X = valueBoxX,
            Y = valueBoxY,
            Width = valueBoxWidth,
            Height = valueBoxHeight,
        }
        if editing then
            paintRect(valueBoxX, valueBoxY, valueBoxWidth, valueBoxHeight, Theme.Panel, 0.92, z + 2, 5)
            paintRect(valueBoxX, valueBoxY, valueBoxWidth, valueBoxHeight,
                Theme.HoverText, 0.82, z + 3, 5, false, 1)
        end
        local displayValue = ellipsize(tostring(shownValue), 10, valueBoxWidth - 6)
        local valueTextWidth = #displayValue * 10 * 0.53
        paintText(displayValue, valueBoxX + (valueBoxWidth - valueTextWidth) / 2,
            valueBoxY + math.floor((valueBoxHeight - 10) / 2) - 1,
            Theme.Muted, 10, textOpacity, z + 4)
        local sliderHit = RimuruUI.IsMouseOver(lineX - 3, lineY - 6, lineWidth + 6, 22)
        if RimuruUI.ConsumeMousePress(valueBoxX, valueBoxY, valueBoxWidth, valueBoxHeight) then
            debugLog("slider edit", item.Text)
            RimuruUI.CaptureNumber(item)
        elseif item.SliderDragging then
            if not RimuruUI.IsDown("m1") then
                item.SliderDragging = false
                item.SliderDragOffset = nil
            else
                local cursorX = state.MouseX - (item.SliderDragOffset or 0)
                local nextAmount = math.max(0, math.min(1, (cursorX - lineX) / lineWidth))
                item.Value = minValue + (maxValue - minValue) * nextAmount
                debugLog("slider value", item.Text, item.Value)
                invoke(item.Callback, item.Value, item)
            end
        elseif sliderHit and RimuruUI.ConsumeMousePress(lineX - 3, lineY - 6, lineWidth + 6, 22) then
            item.SliderDragging = true
            item.SliderDragOffset = 0
            local nextAmount = math.max(0, math.min(1,
                (state.MouseX - lineX) / lineWidth))
            item.Value = minValue + (maxValue - minValue) * nextAmount
            debugLog("slider value", item.Text, item.Value)
            invoke(item.Callback, item.Value, item)
        end
    elseif item.Type == "dropdown" then
        item.OpenProgress = approach(item.OpenProgress or 0, item.Open and 1 or 0, 24)
        local dropdownHovered = RimuruUI.IsMouseOver(x, y, width, rowHeight)
        item.Hover = approach(item.Hover or 0, dropdownHovered and 1 or 0, 18)
        local label = dropdownLabel(item)
        local maxBadgeWidth = math.max(92, math.min(160, floor(width * 0.55)))
        local badgeWidth = math.min(maxBadgeWidth, math.max(92, #label * 6 + 24))
        local itemLabel = ellipsize(item.Text, 11, math.max(24, width - badgeWidth - 12))
        paintText(itemLabel, x, textY,
            colourMix(Theme.Text, Theme.HoverText, item.Hover), 11, 1, z)
        local bx = x + width - badgeWidth
        local badgeY = y + math.floor((rowHeight - 22) / 2)
        local badgeHover = RimuruUI.IsMouseOver(bx, badgeY, badgeWidth, 22)
        item.BadgeHover = approach(item.BadgeHover or 0, badgeHover and 1 or 0, 18)
        local badgeColour = colourMix(Theme.Panel, Theme.CardHover, item.BadgeHover)
        paintRect(bx, badgeY, badgeWidth, 22,
            item.Open and Theme.CardHover or badgeColour,
            0.86 + item.BadgeHover * 0.08, z, 6)
        paintRect(bx, badgeY, badgeWidth, 22,
            item.Open and Theme.HoverText or colourMix(Theme.Border, Theme.HoverText, item.BadgeHover),
            item.Open and 0.86 or 0.72 + item.BadgeHover * 0.12, z + 1, 6, false, 1)
        paintText(ellipsize(label, 11, badgeWidth - 30), bx + 10,
            y + math.floor((rowHeight - 11) / 2),
            colourMix(Theme.Muted, Theme.HoverText, item.BadgeHover), 11, 1, z + 1)
        local chevronX, chevronY = bx + badgeWidth - 14, badgeY + 10
        if item.Open then
            bubbleLine(chevronX - 4, chevronY + 2, chevronX, chevronY - 2, Theme.Muted, 1, z + 1, 1)
            bubbleLine(chevronX, chevronY - 2, chevronX + 4, chevronY + 2, Theme.Muted, 1, z + 1, 1)
        else
            bubbleLine(chevronX - 4, chevronY - 2, chevronX, chevronY + 2, Theme.Muted, 1, z + 1, 1)
            bubbleLine(chevronX, chevronY + 2, chevronX + 4, chevronY - 2, Theme.Muted, 1, z + 1, 1)
        end
        if RimuruUI.ConsumeMousePress(x, y, width, item.Height or 28) then
            if not item.Open then RimuruUI.CloseTransientMenus(item) end
            item.Open = not item.Open
            debugLog("dropdown " .. (item.Open and "open" or "close"), item.Text)
        end
        if (item.Open or item.OpenProgress > 0.01) and #item.Options > 0 then
            local menuX, menuY = bx - 7, badgeY + 27 - (1 - item.OpenProgress) * 4
            local menuAlpha = item.OpenProgress
            local optionHeight = 24
            local searchHeight = 24
            local controlHeight = item.Multi and 24 or 0
            local controlGap = 7
            local query = lower(tostring(item.DropdownQuery or ""))
            local filteredOptions = {}
            for _, option in ipairs(item.Options) do
                if query == "" or lower(tostring(option)):find(query, 1, true) then
                    filteredOptions[#filteredOptions + 1] = option
                end
            end
            local visibleCount = math.min(5, math.max(1, #filteredOptions))
            local menuWidth = math.max(badgeWidth + 12, item.Multi and 176 or 154)
            local contentLeft = state.ContentLeft or x
            local contentRight = state.ContentRight or (x + width)
            menuX = math.max(contentLeft, math.min(menuX, contentRight - menuWidth))
            local menuHeight = 6 + searchHeight + controlGap +
                (item.Multi and (controlHeight + controlGap) or 0) + visibleCount * optionHeight + 6
            local contentX = menuX + 6
            local searchY = menuY + 6
            local controlsY = searchY + searchHeight + controlGap
            local contentY = item.Multi and (controlsY + controlHeight + controlGap) or controlsY
            local contentWidth, contentHeight = menuWidth - 24, visibleCount * optionHeight
            local clipTop = state.ClipTop or -math.huge
            local clipBottom = state.ClipBottom or math.huge
            local menuVisibleY = math.max(menuY, clipTop)
            local menuVisibleBottom = math.min(menuY + menuHeight, clipBottom)
            local menuVisibleHeight = menuVisibleBottom - menuVisibleY
            local optionClipTop = math.max(contentY, clipTop)
            local optionClipBottom = math.min(contentY + contentHeight, clipBottom)
            local totalHeight = #item.Options * optionHeight
            local maxScroll = math.max(0, totalHeight - contentHeight)
            item.DropdownScroll = item.DropdownScroll or 0
            if RimuruUI.IsMouseOver(menuX, menuY, menuWidth, menuHeight) and state.Wheel ~= 0 then
                item.DropdownScroll = item.DropdownScroll - state.Wheel * optionHeight
            end
            item.DropdownScroll = math.max(0, math.min(maxScroll, item.DropdownScroll))
            if menuVisibleHeight > 0 then
                local topRadius = menuVisibleY == menuY and 7 or 0
                local bottomRadius = menuVisibleBottom == menuY + menuHeight and 7 or 0
                paintRect(menuX, menuVisibleY, menuWidth, menuVisibleHeight, Theme.Panel, menuAlpha * 0.94, z + 9, topRadius)
                paintRect(menuX, menuVisibleY, menuWidth, menuVisibleHeight, Theme.BorderSoft, menuAlpha * 0.82, z + 10, bottomRadius, false, 1)
            end
            local searchFocused = state.Capture and state.Capture.Kind == "dropdownSearch" and state.Capture.Item == item
            local searchHover = RimuruUI.IsMouseOver(contentX, searchY, contentWidth, searchHeight - 3)
            paintRect(contentX, searchY, contentWidth, searchHeight - 3,
                searchFocused or searchHover and Theme.CardHover or Theme.Card, menuAlpha * 0.96, z + 11, 5)
            paintRect(contentX, searchY, contentWidth, searchHeight - 3,
                searchFocused and Theme.HoverText or Theme.Border,
                menuAlpha * (searchFocused and 0.82 or 0.68), z + 12, 5, false, 1)
            paintIcon("search", contentX + 10, searchY + 9,
                searchFocused or searchHover and Theme.HoverText or Theme.Muted, z + 13, menuAlpha * 0.9)
            local searchLabel = item.DropdownQuery ~= "" and item.DropdownQuery or "Search..."
            paintText(ellipsize(searchLabel, 10, contentWidth - 24), contentX + 19, searchY + 5,
                item.DropdownQuery ~= "" and Theme.Text or Theme.Muted, 10, menuAlpha, z + 13)
            if RimuruUI.ConsumeMousePress(contentX, searchY, contentWidth, searchHeight - 3) then
                RimuruUI.CaptureDropdownSearch(item)
            elseif state.Capture and state.Capture.Kind == "dropdownSearch" and
                state.Capture.Item == item and RimuruUI.IsDown("m1") and
                not RimuruUI.IsMouseOver(menuX, menuY, menuWidth, menuHeight) then
                RimuruUI.CancelCapture()
            end
            if item.Multi then
                local halfWidth = math.floor((contentWidth - 4) / 2)
                local selectHover = RimuruUI.IsMouseOver(contentX, controlsY, halfWidth, 20)
                local clearHover = RimuruUI.IsMouseOver(contentX + halfWidth + 4, controlsY, halfWidth, 20)
                paintRect(contentX, controlsY, halfWidth, 20, selectHover and Theme.CardHover or Theme.Card,
                    menuAlpha * 0.94, z + 11, 5)
                paintRect(contentX, controlsY, halfWidth, 20, Theme.Border,
                    menuAlpha * (selectHover and 0.92 or 0.72), z + 12, 5, false, 1)
                paintRect(contentX + halfWidth + 4, controlsY, halfWidth, 20,
                    clearHover and Theme.CardHover or Theme.Card, menuAlpha * 0.94, z + 11, 5)
                paintRect(contentX + halfWidth + 4, controlsY, halfWidth, 20, Theme.Border,
                    menuAlpha * (clearHover and 0.92 or 0.72), z + 12, 5, false, 1)
                paintText("Select all", contentX + 7, controlsY + 4, selectHover and Theme.HoverText or Theme.Muted,
                    9, menuAlpha, z + 12)
                paintText("Unselect all", contentX + halfWidth + 10, controlsY + 4,
                    clearHover and Theme.HoverText or Theme.Muted, 9, menuAlpha, z + 12)
                if RimuruUI.ConsumeMousePress(contentX, controlsY, halfWidth, 20) then
                    item.Value = {}
                    for _, option in ipairs(item.Options) do item.Value[option] = true end
                    debugLog("dropdown select all", item.Text)
                    invoke(item.Callback, item.Value, item)
                elseif RimuruUI.ConsumeMousePress(contentX + halfWidth + 4, controlsY, halfWidth, 20) then
                    item.Value = {}
                    debugLog("dropdown unselect all", item.Text)
                    invoke(item.Callback, item.Value, item)
                end
            end
            for optionIndex, option in ipairs(filteredOptions) do
                local optionY = contentY + (optionIndex - 1) * optionHeight - item.DropdownScroll
                    local optionOpacity = menuAlpha
                if maxScroll > 0 and item.DropdownScroll > 0 and optionY < contentY + 8 then
                    optionOpacity = math.min(optionOpacity,
                        (optionY + optionHeight - contentY) / 8)
                end
                if maxScroll > 0 and optionY + optionHeight > contentY + contentHeight - 8 then
                    optionOpacity = math.min(optionOpacity,
                        (contentY + contentHeight - optionY) / 8)
                end
                if optionY + optionHeight > optionClipTop and
                    optionY < optionClipBottom and optionOpacity > 0 then
                    local visibleY = math.max(optionY, optionClipTop)
                    local visibleBottom = math.min(optionY + optionHeight, optionClipBottom)
                    local visibleHeight = visibleBottom - visibleY
                    local optionHover = RimuruUI.IsMouseOver(contentX, visibleY, contentWidth, visibleHeight)
                    paintRect(contentX, visibleY, contentWidth, visibleHeight,
                        optionHover and Theme.CardHover or Theme.Panel, optionOpacity * 0.94, z + 10, 5)
                    paintRect(contentX, visibleY, contentWidth, visibleHeight,
                        dropdownHasValue(item, option) and Theme.HoverText or Theme.Border,
                        optionOpacity * (optionHover and 0.82 or 0.64), z + 11, 5, false, 1)
                    local textPosition = optionY + math.floor((optionHeight - 11) / 2)
                    local textClipTop = optionClipTop + 2
                    local textClipBottom = math.max(textClipTop + 1, optionClipBottom - 2)
                    local textOpacity = viewportOpacity(textPosition, 11,
                        textClipTop, textClipBottom, 8)
                    paintText(ellipsize(option, 11, contentWidth - 14), contentX + 7, textPosition,
                        dropdownHasValue(item, option) and Theme.Text or (optionHover and Theme.HoverText or Theme.Muted),
                        11, optionOpacity * textOpacity, z + 12)
                    if item.Open and RimuruUI.ConsumeMousePress(contentX, optionY, contentWidth, optionHeight) then
                        if item.Multi then
                            item.Value = type(item.Value) == "table" and item.Value or {}
                            item.Value[option] = not dropdownHasValue(item, option)
                            debugLog("dropdown value", item.Text, option, item.Value[option])
                            invoke(item.Callback, item.Value, item)
                        else
                            item.Value, item.Open = option, false
                            item.DropdownScroll = 0
                            debugLog("dropdown value", item.Text, item.Value)
                            invoke(item.Callback, item.Value, item)
                        end
                    end
                end
            end



            if maxScroll > 0 and item.DropdownScroll > 0 then
                for fadeIndex = 1, 4 do
                    paintRect(menuX + 1, optionClipTop + (fadeIndex - 1) * 2,
                        menuWidth - 2, 2, Theme.Panel,
                        menuAlpha * (5 - fadeIndex) / 5, z + 25, 5)
                end
            end
            if maxScroll > 0 and item.DropdownScroll < maxScroll then
                for fadeIndex = 1, 4 do
                    paintRect(menuX + 1, optionClipBottom - fadeIndex * 2,
                        menuWidth - 2, 2, Theme.Panel,
                        menuAlpha * (5 - fadeIndex) / 5, z + 25, 5)
                end
            end
            if menuVisibleHeight > 0 then
                paintRect(menuX, menuVisibleY, menuWidth, 3, Theme.Panel, menuAlpha, z + 25, 7)
                paintRect(menuX, menuVisibleBottom - 3, menuWidth, 3, Theme.Panel, menuAlpha, z + 25, 7)
                paintRect(menuX, menuVisibleY, menuWidth, menuVisibleHeight, Theme.BorderSoft, menuAlpha * 0.82, z + 26, 7, false, 1)
            end
            if maxScroll > 0 then
                local trackX = menuX + menuWidth - 9
                local trackY = math.max(menuY + 8, clipTop + 4)
                local trackBottom = math.min(menuY + menuHeight - 8, clipBottom - 4)
                local trackHeight = math.max(1, trackBottom - trackY)
                local thumbHeight = math.max(18, trackHeight * contentHeight / totalHeight)
                local thumbY = trackY + (trackHeight - thumbHeight) * (item.DropdownScroll / maxScroll)
                paintRect(trackX, trackY, 3, trackHeight, Theme.BorderSoft, menuAlpha * 0.86, z + 27, 2)
                local thumbHovered = RimuruUI.IsMouseOver(trackX - 5, thumbY, 13, thumbHeight)
                local thumbColour = colourMix(Theme.Muted, Theme.HoverText,
                    (thumbHovered or item.DropdownDragging) and 1 or 0)
                paintRect(trackX - 1, thumbY, 5, thumbHeight, thumbColour,
                    menuAlpha * ((thumbHovered or item.DropdownDragging) and 0.78 or 0.50), z + 28, 2)
                if item.DropdownDragging then
                    if not RimuruUI.IsDown("m1") then
                        item.DropdownDragging = false
                    else
                        local nextScroll = (state.MouseY - trackY - item.DropdownDragOffset) /
                            math.max(1, trackHeight - thumbHeight)
                        item.DropdownScroll = math.max(0, math.min(maxScroll, nextScroll * maxScroll))
                    end
                elseif RimuruUI.ConsumeMousePress(trackX - 5, thumbY, 13, thumbHeight) then
                    item.DropdownDragging = true
                    item.DropdownDragOffset = state.MouseY - thumbY
                end
            end
        end
    end
    return row
end

local function hidePrimitives()
    for kind, list in pairs(Pool) do
        for i = Used[kind] + 1, #list do
            pcall(function() list[i].Visible = false end)
        end
        Used[kind] = 0
    end
    for key, object in pairs(StableImages) do
        if not StableImageUsed[key] then pcall(function() object.Visible = false end) end
    end
    StableImageUsed = {}
end

local function removePrimitives()
    removeRegisteredPrimitives()
    for kind, list in pairs(Pool) do
        for i = 1, #list do
            local object = list[i]
            pcall(function()
                if object and type(object.Remove) == "function" then
                    object:Remove()
                end
            end)
            pcall(function()
                if object and type(object.Destroy) == "function" then
                    object:Destroy()
                end
            end)
            pcall(function()
                if object then object.Visible = false end
            end)
        end
    end
    Pool = {
        Square = {}, Line = {}, Circle = {}, Triangle = {},
        Image = {}, Text = {},
    }
    Used = {
        Square = 0, Line = 0, Circle = 0, Triangle = 0,
        Image = 0, Text = 0,
    }
    ImageDataCache = {}
    StableImages, StableImageUsed = {}, {}
end

viewport = function()
    local width, height = 1920, 1080
    if DrawingAvailable and Drawing.Viewport then
        pcall(function() width, height = Drawing.Viewport.X, Drawing.Viewport.Y end)
    end
    if workspace and workspace.CurrentCamera then
        pcall(function()
            local size = workspace.CurrentCamera.ViewportSize
            if size.X > 0 and size.Y > 0 then width, height = size.X, size.Y end
        end)
    end
    return width, height
end

local function resolveLogo(value)
    if type(value) ~= "string" or value == "" then return nil end
    if value:match("^https?://") and game then
        local ok, data = pcall(function() return game:HttpGet(value) end)
        return ok and type(data) == "string" and data or nil
    end
    if ReadFile and IsFile and IsFile(value) then
        local ok, data = pcall(ReadFile, value)
        return ok and data or nil
    end
    return value
end

local function resolvePlayerAvatar()
    if not game then return nil end
    local ok, data = pcall(function()
        local player = game:GetService("Players").LocalPlayer
        if not player or not player.UserId then return nil end
        local response = game:HttpGet("https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" ..
            tostring(player.UserId) .. "&size=150x150&format=Png&isCircular=false")
        local imageUrl = type(response) == "string" and response:match('"imageUrl"%s*:%s*"(.-)"')
        return imageUrl and resolveLogo(imageUrl) or nil
    end)
    return ok and data or nil
end

function Window:_updateDrag()
    if self.Dragging then
        if not RimuruUI.IsDown("m1") then
            self.Dragging = false
        else
            self.X = state.MouseX - self.DragOffsetX
            self.Y = state.MouseY - self.DragOffsetY
        end
    else
        local minimizeX = self.X + self.Width - 60
        local keyText = keyLabel(self.ToggleKey)
        local keyPillWidth = math.max(112, 64 + #keyText * 5.3)
        local keyPillX = minimizeX - 10 - keyPillWidth
        local titleText = self.ActiveTab and tostring(self.ActiveTab.Name or "") or ""
        local titlePillWidth = math.max(86, math.min(142, #titleText * 6 + 22))
        local searchX = self.X + self.SidebarWidth + 32 + titlePillWidth
        local searchRight = keyPillX - 10
        local searchWidth = math.min(210, searchRight - searchX)
        local overSearch = searchWidth >= 72 and RimuruUI.IsMouseOver(searchX, self.Y + 12, searchWidth, 22)
        if state.Capture and state.Capture.Kind == "search" and state.Capture.Window == self and
            RimuruUI.IsDown("m1") and not overSearch then
            RimuruUI.CancelCapture()
        end
        if not overSearch and RimuruUI.ConsumeMousePress(self.X, self.Y, self.Width - 68, self.TopbarHeight) then
        self.Dragging = true
        self.DragOffsetX = state.MouseX - self.X
        self.DragOffsetY = state.MouseY - self.Y
        end
    end
end

function Window:Render()
    if self.Loading then return end
    if not lifecycleToken.Alive or self.Removed or (not self.Visible and not self.Closing) then return end
    self.RenderAlpha = approach(self.RenderAlpha or 1, self.AlphaTarget or 1, 18)
    self.MinimizeProgress = approach(self.MinimizeProgress or 0, self.MinimizeTarget or 0, 24)
    if self.Closing and self.RenderAlpha <= 0.02 then
        self.Visible = false
        self.Closing = false
        self:Destroy()
        return
    end
    if self.Hidden and self.RenderAlpha <= 0.02 then
        self.Visible = false
        return
    end
    local previousRenderAlpha = state.RenderAlpha
    local previousLocalAlpha = state.LocalAlpha

    state.RenderAlpha = self.RenderAlpha
    state.LocalAlpha = 1
    self:_updateDrag()

    local x, y, width, height = self.X, self.Y, self.Width, self.Height
    local side = self.SidebarWidth
    local topbar = self.TopbarHeight
    local drawHeight = topbar + (height - topbar) * (1 - self.MinimizeProgress)


    paintRect(x - 2, y - 2, width + 4, drawHeight + 4, Theme.Border, 0.90, 8,
        self.CornerRadius + 2, false, 3)
    paintRect(x - 1, y - 1, width + 2, drawHeight + 2, Theme.BorderSoft, 0.78, 9,
        self.CornerRadius + 1, false, 2)
    paintRect(x, y, width, drawHeight, Theme.Background, 0.97, 11, self.CornerRadius)
    paintRect(x, y, side, drawHeight, Theme.Sidebar, 1, 12, self.CornerRadius)
    if self.BackgroundEnabled and self.MinimizeTarget == 0 and self.MinimizeProgress < 0.02 and self.BackgroundData then
        paintImageRect(self.BackgroundData, x, y, width, drawHeight, self.CornerRadius, 0.65, 13)
    end
    paintLine(x + side, y + 1, x + side, y + drawHeight - 1, Theme.Border, 0.80, 31, 1)

    paintLine(x + 17, y + topbar, x + side - 17, y + topbar, Theme.BorderSoft, 0.72, 31, 1)
    paintLine(x + side + 17, y + topbar, x + width - 17, y + topbar, Theme.BorderSoft, 0.72, 31, 1)

    local logoX, logoY, logoSize = x + 16, y + 8, 32
    paintRect(logoX, logoY, logoSize, logoSize, Theme.Panel, 0.88, 34, 8)
    if self.LogoData then
        paintStableImage(self.StableImagePrefix .. ":header", self.LogoData,
            logoX, logoY, logoSize, 8, 1, 35)
    end
    paintRect(logoX, logoY, logoSize, logoSize, Theme.Border, 0.68, 36, 8, false, 1)

    local titleX = x + self.LogoSpace + 20
    paintText(self.Title, titleX, y + 9, Theme.Text, 16, 1, 40)
    if self.Subtitle ~= "" then
        local subtitleWidth = side - self.LogoSpace - 30
        paintText(ellipsize(self.Subtitle, 10, subtitleWidth), titleX, y + 29, Theme.Muted, 10, 1, 40)
    end
    local minimizeX, closeX = x + width - 60, x + width - 32
    local keyText = keyLabel(self.ToggleKey)
    local keyPillWidth = math.max(112, 64 + #keyText * 5.3)
    local keyPillX, keyPillY = minimizeX - 10 - keyPillWidth, y + 12
    paintRect(keyPillX, keyPillY, keyPillWidth, 22, Theme.Panel, 0.90, 37, 6)
    paintRect(keyPillX, keyPillY, keyPillWidth, 22, Theme.BorderSoft, 0.78, 38, 6, false, 1)
    paintText("Keybind", keyPillX + 10, keyPillY + 6, Theme.Muted, 10, 1, 40)
    local dividerX = keyPillX + 54
    paintLine(dividerX, keyPillY + 4, dividerX, keyPillY + 18, Theme.BorderSoft, 0.82, 40, 1)
    local valueWidth = #keyText * 10 * 0.53
    paintText(keyText, dividerX + (keyPillX + keyPillWidth - dividerX - valueWidth) / 2,
        keyPillY + 6, Theme.HoverText, 10, 1, 40)

    paintWindowButton("minimize", minimizeX, y + 12, RimuruUI.IsMouseOver(minimizeX, y + 12, 22, 22))
    paintWindowButton("close", closeX, y + 12, RimuruUI.IsMouseOver(closeX, y + 12, 22, 22))
    if RimuruUI.ConsumeMousePress(minimizeX, y + 12, 22, 22) then
        self:Minimize()
        state.RenderAlpha = previousRenderAlpha
        state.LocalAlpha = previousLocalAlpha
        return
    end
    if RimuruUI.ConsumeMousePress(closeX, y + 12, 22, 22) then
        self:Close()
        state.RenderAlpha = previousRenderAlpha
        state.LocalAlpha = previousLocalAlpha
        return
    end



    local bodyFadeRate = self.ActiveTab and self.ActiveTab.IsHome and 3.4 or 1
    state.RenderAlpha = self.RenderAlpha * math.max(0, 1 - self.MinimizeProgress * bodyFadeRate)
    if self.MinimizeProgress >= 0.995 then
        state.RenderAlpha = previousRenderAlpha
        state.LocalAlpha = previousLocalAlpha
        return
    end

    local navTop, navBottom = y + topbar + 8, y + drawHeight - 50
    local homeHeight, categoryTop = 42, navTop + 42
    local navItemWidth = side - 28
    local fadeSize = 16
    local totalNavHeight = 0
    for categoryIndex = 1, #self.Categories do
        totalNavHeight = totalNavHeight + 20 + #self.Categories[categoryIndex].Tabs * 31 + 8
    end
    self.TabScroll = self.TabScroll or 0
    if RimuruUI.IsMouseOver(x, categoryTop, side, navBottom - categoryTop) and state.Wheel ~= 0 then
        self.TabScroll = self.TabScroll - state.Wheel * 34
    end
    local categoryViewportHeight = navBottom - categoryTop
    local maxTabScroll = math.max(0, totalNavHeight - categoryViewportHeight)
    self.TabScroll = math.max(0, math.min(self.TabScroll, maxTabScroll))

    local function navOpacity(position, itemHeight, fadeTop)
        local topBoundary = categoryTop
        if position + itemHeight <= topBoundary or position >= navBottom then return 0 end
        local opacity = 1
        if fadeTop and position < categoryTop then
            local visibleRatio = (position + itemHeight - categoryTop) / math.max(1, itemHeight)
            opacity = math.min(opacity, visibleRatio * visibleRatio)
        end
        if position + itemHeight > navBottom - fadeSize then
            opacity = math.min(opacity, (navBottom - position - itemHeight + fadeSize) / fadeSize)
        end
        return math.max(0, math.min(1, opacity))
    end

    local cursorY = categoryTop - self.TabScroll
    local home = self.HomeTab
    local homeX, homeY = x + 10, navTop + 4
    local homeOpacity = 1
    local homeHovered = homeOpacity > 0 and RimuruUI.IsMouseOver(homeX, homeY - 4, navItemWidth, 32)
    local homeActive = self.ActiveTab == home
    home.Selection = approach(home.Selection or 0, homeActive and 1 or 0, 14)
    if homeOpacity > 0 and (homeActive or homeHovered) then
        paintRect(homeX, homeY - 4, navItemWidth, 32, homeActive and Theme.SidebarSelected or Theme.SidebarHover,
            homeOpacity * (homeActive and 0.92 or 0.96), 20, 8)
        paintRect(homeX, homeY - 4, navItemWidth, 32,
            homeActive and Theme.BorderSoft or Theme.Border,
            homeOpacity * (homeActive and 0.84 or 0.90), 21, 8, false, 1)
    end
    if homeOpacity > 0 then
        paintIcon("home", x + 25, homeY + 11,
            Theme.Text, 40, homeOpacity)
        paintText("Home Page", x + 43, homeY + 5,
            Theme.Text, 11, homeOpacity, 40)
        if RimuruUI.ConsumeMousePress(homeX, homeY - 4, navItemWidth, 32) then self.ActiveTab = home end
    end
    paintLine(x + 17, homeY + 34, x + side - 17, homeY + 34,
        Theme.BorderSoft, 0.78, 31, 1)
    local indicatorTargetX, indicatorTargetY, indicatorOpacity
    for categoryIndex = 1, #self.Categories do
        local category = self.Categories[categoryIndex]
        local categoryOpacity = navOpacity(cursorY, 14, self.TabScroll > 0)
        if categoryOpacity > 0 then
            paintText(category.Name, x + 10, cursorY, Theme.Text, 10, categoryOpacity, 40)
        end
        cursorY = cursorY + 20
        for tabIndex = 1, #category.Tabs do
            local tab = category.Tabs[tabIndex]
            local active = self.ActiveTab == tab
            local tabX, tabY = x + 10, cursorY
            local opacity = navOpacity(tabY - 4, 30, true)
            local hovered = opacity > 0 and RimuruUI.IsMouseOver(tabX, tabY - 4, navItemWidth, 30)
            if active then
                indicatorTargetX, indicatorTargetY, indicatorOpacity = tabX, tabY - 4, opacity
            end
            local visualSelection = active and 1 or (hovered and 0.30 or 0)
            if opacity > 0 and hovered and not active then
                paintRect(tabX, tabY - 4, navItemWidth, 30, Theme.SidebarHover,
                    opacity * (0.97 - visualSelection * 0.06), 20, 7)
                paintRect(tabX, tabY - 4, navItemWidth, 30,
                    colourMix(Theme.Border, Theme.HoverText, visualSelection),
                    opacity * (0.70 + visualSelection * 0.18), 21, 7, false, 1)
            end
            if opacity > 0 then
                local tabColour = Theme.Text
                local textColour = Theme.Text
                paintIcon(tab.Icon, x + 25, tabY + 10, tabColour, 40, opacity)
                paintText(tab.Name, x + 43, tabY + 4, textColour, 11, opacity, 40)
                if RimuruUI.ConsumeMousePress(tabX, tabY - 4, navItemWidth, 30) then self.ActiveTab = tab end
            end
            cursorY = cursorY + 31
        end
        cursorY = cursorY + 8
    end

    if indicatorTargetX and indicatorOpacity and indicatorOpacity > 0 then
        if self.Dragging then
            self.TabIndicatorX = indicatorTargetX
            self.TabIndicatorY = indicatorTargetY
        else
            self.TabIndicatorX = approach(self.TabIndicatorX or indicatorTargetX, indicatorTargetX, 52)
            self.TabIndicatorY = approach(self.TabIndicatorY or indicatorTargetY, indicatorTargetY, 52)
            if math.abs(self.TabIndicatorX - indicatorTargetX) < 0.5 and
                math.abs(self.TabIndicatorY - indicatorTargetY) < 0.5 then
                self.TabIndicatorTab = self.ActiveTab
            end
        end
        paintRect(self.TabIndicatorX, self.TabIndicatorY, navItemWidth, 30, Theme.SidebarSelected,
            indicatorOpacity * 0.94, 20, 7)
        paintRect(self.TabIndicatorX, self.TabIndicatorY, navItemWidth, 30, Theme.Border,
            indicatorOpacity * 0.88, 21, 7, false, 1)
    end




    for fadeIndex = 1, 4 do
        paintRect(x + 1, categoryTop - 8 + (fadeIndex - 1) * 2, side - 2, 2,
            Theme.Sidebar, fadeIndex / 15, 45, 0)
        paintRect(x + 1, navBottom - fadeIndex * 2, side - 2, 2,
            Theme.Sidebar, (5 - fadeIndex) / 15, 45, 0)
    end

    if maxTabScroll > 0 then
        local trackX, trackY = x + side - 9, categoryTop + 4
        local trackHeight = math.max(1, categoryViewportHeight - 8)
        local thumbHeight = math.max(24, trackHeight * categoryViewportHeight / totalNavHeight)
        local thumbY = trackY + (trackHeight - thumbHeight) * (self.TabScroll / maxTabScroll)
        paintRect(trackX, trackY, 4, trackHeight, Theme.BorderSoft, 0.82, 50, 2)
            local thumbHovered = RimuruUI.IsMouseOver(trackX - 4, thumbY, 12, thumbHeight)
            local thumbColour = colourMix(Theme.Muted, Theme.HoverText,
                (thumbHovered or self.ScrollDragging) and 1 or 0)
            paintRect(trackX - 1, thumbY, 6, thumbHeight, thumbColour,
                (thumbHovered or self.ScrollDragging) and 0.68 or 0.40, 51, 3)
        if self.ScrollDragging then
            if not RimuruUI.IsDown("m1") then
                self.ScrollDragging = false
            else
                local next = (state.MouseY - trackY - self.ScrollDragOffset) / math.max(1, trackHeight - thumbHeight)
                self.TabScroll = math.max(0, math.min(maxTabScroll, next * maxTabScroll))
            end
        elseif RimuruUI.ConsumeMousePress(trackX - 4, thumbY, 12, thumbHeight) then
            self.ScrollDragging = true
            self.ScrollDragOffset = state.MouseY - thumbY
        end
    end


    local settings = self.SettingsTab
    local settingsX, settingsY = x + 10, y + drawHeight - 38
    local settingsHovered = RimuruUI.IsMouseOver(settingsX, settingsY - 4, navItemWidth, 32)
    local settingsActive = self.ActiveTab == settings
    paintLine(x + 17, settingsY - 12, x + side - 17, settingsY - 12,
        Theme.BorderSoft, 0.78, 52, 1)
    if settingsActive or settingsHovered then
        paintRect(settingsX, settingsY - 4, navItemWidth, 32,
            settingsActive and Theme.SidebarSelected or Theme.SidebarHover,
            settingsActive and 0.92 or 0.96, 50, 8)
        paintRect(settingsX, settingsY - 4, navItemWidth, 32,
            settingsActive and Theme.BorderSoft or Theme.Border,
            settingsActive and 0.84 or 0.90, 51, 8, false, 1)
    end
    self.SettingsSpin = approach(self.SettingsSpin or 0, self.SettingsSpinTarget or 0, 7)
    paintIcon("settings", x + 25, settingsY + 11,
        settingsActive and Theme.Text or (settingsHovered and Theme.HoverText or Theme.Text),
        52, 1, self.SettingsSpin)
    paintText("Settings", x + 43, settingsY + 5,
            settingsActive and Theme.Text or (settingsHovered and Theme.HoverText or Theme.Text), 11, 1, 52)
    if RimuruUI.ConsumeMousePress(settingsX, settingsY - 4, navItemWidth, 32) then
        if self.ActiveTab ~= settings then
            self.SettingsSpinTarget = (self.SettingsSpinTarget or self.SettingsSpin or 0) + math.pi * 2
            self.ActiveTab = settings
            self.ContentScroll = 0
        end
    end

    local activeTab = self.ActiveTab
    local titleText = activeTab and tostring(activeTab.Name or "") or ""
    local titlePillX, titlePillY = x + side + 20, y + 12
    local titlePillWidth = math.max(86, math.min(142, #titleText * 6 + 22))
    if activeTab then
        paintRect(titlePillX, titlePillY, titlePillWidth, 22, Theme.Panel, 0.90, 37, 6)
        paintRect(titlePillX, titlePillY, titlePillWidth, 22, Theme.BorderSoft, 0.78, 38, 6, false, 1)
        local shownTitle = ellipsize(titleText, 11, titlePillWidth - 18)
        local shownWidth = #shownTitle * 11 * 0.53
        paintText(shownTitle, titlePillX + (titlePillWidth - shownWidth) / 2,
            titlePillY + 6, Theme.Text, 11, 1, 40)
    end

    local searchX = titlePillX + titlePillWidth + 12
    local searchRight = keyPillX - 10
    local searchWidth = math.min(210, searchRight - searchX)
    if searchWidth >= 72 then
        local searchY = y + 12
        local searchFocused = state.Capture and state.Capture.Kind == "search" and state.Capture.Window == self
        local searchValue = tostring(self.SearchQuery or "")
        local searchHover = RimuruUI.IsMouseOver(searchX, searchY, searchWidth, 24)
        paintRect(searchX, searchY, searchWidth, 22,
            searchFocused or searchHover and Theme.CardHover or Theme.Panel,
            0.88, 37, 6)
        paintRect(searchX, searchY, searchWidth, 22,
            searchFocused and Theme.HoverText or Theme.Border,
            searchFocused and 0.78 or 0.62, 38, 6, false, 1)
        paintIcon("search", searchX + 11, searchY + 11,
            searchFocused or searchHover and Theme.HoverText or Theme.Muted, 39, 1)
        local searchText = searchValue ~= "" and searchValue or "Search widgets..."
        paintText(ellipsize(searchText, 11, searchWidth - 24), searchX + 21, searchY + 6,
            searchValue ~= "" and Theme.Text or Theme.Muted, 11, 1, 39)
        if RimuruUI.ConsumeMousePress(searchX, searchY, searchWidth, 22) then
            RimuruUI.CaptureSearch(self)
            debugLog("search focus", self.SearchQuery or "")
        end
    end
    if activeTab and activeTab.IsHome then
        local homeX, homeY = x + side + 20, y + topbar + 16
        local homeWidth = width - side - 40
        local username = "Player"
        pcall(function()
            local player = game:GetService("Players").LocalPlayer
            username = tostring(player.DisplayName or player.Name or username)
        end)
        local profileHeight = 62
        paintRect(homeX, homeY, homeWidth, profileHeight, Theme.Panel,
            self.GlassEnabled and 0.62 or 0.97, 42, 8)
        paintRect(homeX, homeY, homeWidth, profileHeight, Theme.Border, 0.78, 43, 8, false, 1)
        paintRect(homeX + 10, homeY + 9, 44, 44, Theme.Card,
            self.GlassEnabled and 0.68 or 0.98, 44, 7)
        paintRect(homeX + 10, homeY + 9, 44, 44, Theme.BorderSoft, 0.84, 45, 7, false, 1)
        self.AvatarData = self.AvatarData or resolvePlayerAvatar()
        if self.AvatarData then
            paintStableImage(self.StableImagePrefix .. ":avatar", self.AvatarData,
                homeX + 10, homeY + 9, 44, 7, 1, 46)
        end
        paintText("Welcome, " .. username .. "...", homeX + 66, homeY + 14, Theme.Text, 13, 1, 46)
        paintText("Playing " .. tostring(self.Subtitle or "game") .. "...", homeX + 66, homeY + 34, Theme.Muted, 10, 1, 46)


        local panelY, panelGap = homeY + profileHeight + 18, 14
        local leftWidth = math.floor((homeWidth - panelGap) * 0.43)
        local panelHeight = math.min(leftWidth, math.max(190, drawHeight - (panelY - y) - 18))
        local rightWidth = homeWidth - leftWidth - panelGap
        paintRect(homeX, panelY, leftWidth, panelHeight, Theme.Panel,
            self.GlassEnabled and 0.58 or 0.97, 42, 8)
        paintRect(homeX, panelY, leftWidth, panelHeight, Theme.Border, 0.76, 43, 8, false, 1)
        local previewSize = math.min(leftWidth - 24, panelHeight - 24)
        local previewX = homeX + math.floor((leftWidth - previewSize) / 2)
        local previewY = panelY + math.floor((panelHeight - previewSize) / 2)
        paintRect(previewX, previewY, previewSize, previewSize, Theme.Background, 0.98, 44, 7)
        paintRect(previewX, previewY, previewSize, previewSize, Theme.BorderSoft, 0.72, 45, 7, false, 1)
        if self.LogoData then
            paintStableImage(self.StableImagePrefix .. ":preview", self.LogoData,
                previewX, previewY, previewSize, 7, 1, 46)
        end
        local rightX = homeX + leftWidth + panelGap
        paintRect(rightX, panelY, rightWidth, panelHeight, Theme.Panel,
            self.GlassEnabled and 0.68 or 0.97, 42, 8)
        paintRect(rightX, panelY, rightWidth, panelHeight, Theme.Border, 0.76, 43, 8, false, 1)
        local changes = self.Changelogs or {}
        local changeY = panelY + 42
        local discordY = panelY + panelHeight - 40
        local changeBottom = discordY - 8
        local changeHeight = math.max(1, changeBottom - changeY)
        local changeRowHeight = 38
        local totalChangeHeight = #changes * changeRowHeight
        local maxChangeScroll = math.max(0, totalChangeHeight - changeHeight)
        self.ChangelogScroll = math.max(0, math.min(maxChangeScroll, self.ChangelogScroll or 0))
        if RimuruUI.IsMouseOver(rightX + 10, changeY, rightWidth - 20, changeHeight) and state.Wheel ~= 0 then
            self.ChangelogScroll = math.max(0, math.min(maxChangeScroll,
                self.ChangelogScroll - state.Wheel * changeRowHeight))
        end
        if #changes == 0 then
            paintText("No updates yet", rightX + 14, changeY + 2, Theme.Muted, 11, 1, 44)
        else
            for changeIndex = 1, #changes do
                local change = changes[changeIndex]
                local rowY = changeY + (changeIndex - 1) * changeRowHeight - self.ChangelogScroll
                local rowBottom = rowY + 32
                if rowBottom > changeY and rowY < changeBottom then
                    local rowOpacity = viewportOpacity(rowY, 32, changeY, changeBottom, 3)
                    if rowY < changeY then
                        rowOpacity = math.min(rowOpacity,
                            math.max(0, (rowY + 32 - changeY) / 1.5))
                    end
                    local visibleRowY = math.max(rowY - 3, changeY)
                    local visibleRowBottom = math.min(rowBottom, changeBottom)
                    local visibleRowHeight = visibleRowBottom - visibleRowY
                    local rowHover = rowOpacity > 0.6 and RimuruUI.IsMouseOver(
                        rightX + 10, visibleRowY, rightWidth - 28, visibleRowHeight)
                    if rowHover and visibleRowHeight > 0 then
                        paintRect(rightX + 10, visibleRowY, rightWidth - 28, visibleRowHeight,
                            Theme.CardHover, rowOpacity * 0.54, 44, 6)
                    end
                    local titleOpacity = viewportOpacity(rowY, 11,
                        changeY, changeBottom, 4)
                    local descriptionOpacity = viewportOpacity(rowY + 16, 10,
                        changeY, changeBottom, 4)
                    paintCircle(rightX + 17, rowY + 7, 2,
                        rowHover and Theme.HoverText or Theme.Muted,
                        titleOpacity * 0.92, 45, true)
                    paintText(ellipsize(change.Title, 10, rightWidth - 58), rightX + 27, rowY,
                        rowHover and Theme.HoverText or Theme.Text, 10, titleOpacity, 45)
                    paintText(ellipsize(change.Description, 9, rightWidth - 48), rightX + 27, rowY + 16,
                        Theme.Muted, 9, descriptionOpacity, 45)
                    if changeIndex < #changes then
                        local separatorOpacity = viewportOpacity(rowY + 33, 1,
                            changeY, changeBottom, 5)
                        paintLine(rightX + 14, rowY + 33, rightX + rightWidth - 22, rowY + 33,
                            Theme.BorderSoft, separatorOpacity * 0.55, 44, 1)
                    end
                end
            end
        end




        paintText("Changelog", rightX + 14, panelY + 13, Theme.Text, 12, 1, 48)
        paintLine(rightX + 14, panelY + 34, rightX + rightWidth - 14, panelY + 34,
            Theme.BorderSoft, 0.72, 48, 1)
        if maxChangeScroll > 0 then
            local changeTrackX = rightX + rightWidth - 9
            local changeTrackY = changeY + 2
            local changeTrackHeight = math.max(1, changeHeight - 4)
            local changeThumbHeight = math.max(18,
                changeTrackHeight * changeHeight / totalChangeHeight)
            local changeThumbY = changeTrackY + (changeTrackHeight - changeThumbHeight) *
                (self.ChangelogScroll / maxChangeScroll)
            local changeThumbHover = RimuruUI.IsMouseOver(
                changeTrackX - 4, changeThumbY, 11, changeThumbHeight)
            paintRect(changeTrackX, changeTrackY, 3, changeTrackHeight,
                Theme.BorderSoft, 0.70, 48, 2)
            paintRect(changeTrackX - 1, changeThumbY, 5, changeThumbHeight,
                (changeThumbHover or self.ChangelogDragging) and Theme.HoverText or Theme.Muted,
                (changeThumbHover or self.ChangelogDragging) and 0.72 or 0.46, 49, 2)
            if self.ChangelogDragging then
                if not RimuruUI.IsDown("m1") then
                    self.ChangelogDragging = false
                else
                    local nextScroll = (state.MouseY - changeTrackY - self.ChangelogDragOffset) /
                        math.max(1, changeTrackHeight - changeThumbHeight)
                    self.ChangelogScroll = math.max(0, math.min(maxChangeScroll,
                        nextScroll * maxChangeScroll))
                end
            elseif RimuruUI.ConsumeMousePress(
                changeTrackX - 4, changeThumbY, 11, changeThumbHeight) then
                self.ChangelogDragging = true
                self.ChangelogDragOffset = state.MouseY - changeThumbY
            end
        end
        local discord = "https://discord.com/invite/Xr4tSBPahf"
        self.DiscordPress = approach(self.DiscordPress or 0, 0, 24)
        if self.DiscordFeedbackUntil and clock() >= self.DiscordFeedbackUntil then
            self.DiscordFeedback = ""
        end
        local discordX, discordWidth = rightX + 12, rightWidth - 24
        local discordHover = RimuruUI.IsMouseOver(discordX, discordY, discordWidth, 28)
        local pressScale = 1 - math.min(0.06, (self.DiscordPress or 0) * 0.06)
        local pressInsetX = discordWidth * (1 - pressScale) * 0.5
        local pressInsetY = 28 * (1 - pressScale) * 0.5
        local drawDiscordX, drawDiscordY = discordX + pressInsetX, discordY + pressInsetY
        local drawDiscordWidth, drawDiscordHeight = discordWidth - pressInsetX * 2, 28 - pressInsetY * 2
        paintRect(drawDiscordX, drawDiscordY, drawDiscordWidth, drawDiscordHeight,
            discordHover and Theme.CardHover or Theme.Card,
            self.GlassEnabled and 0.68 or 0.98, 44, 7)
        paintRect(drawDiscordX, drawDiscordY, drawDiscordWidth, drawDiscordHeight, Theme.Border,
            discordHover and 0.92 or 0.72, 45, 7, false, 1)
        local discordText = self.DiscordFeedback ~= "" and self.DiscordFeedback or "Join Discord"
        paintText(ellipsize(discordText, 11, drawDiscordWidth - 20), drawDiscordX + 10, drawDiscordY + 8,
            discordHover and Theme.Text or Theme.Muted, 11, 1, 46)
        if RimuruUI.ConsumeMousePress(discordX, discordY, discordWidth, 28) then
            setClipboard(discord)
            self.DiscordPress = 1
            self.DiscordFeedback = "Copied to clipboard..."
            self.DiscordFeedbackUntil = clock() + 1.6
            debugLog("discord copied", discord)
        end
        local footerY = panelY + panelHeight + 13
        local footerHeight, footerGap = 42, 12
        if footerY + footerHeight <= y + drawHeight - 10 then
            local ownerWidth = math.floor((homeWidth - footerGap) * 0.66)
            local runtimeX = homeX + ownerWidth + footerGap
            local runtimeWidth = homeWidth - ownerWidth - footerGap
            paintRect(homeX, footerY, ownerWidth, footerHeight, Theme.Panel,
                self.GlassEnabled and 0.58 or 0.97, 42, 8)
            paintRect(homeX, footerY, ownerWidth, footerHeight, Theme.Border, 0.78, 43, 8, false, 1)
            paintIcon("info", homeX + 18, footerY + 21, Theme.HoverText, 44, 0.92)
            paintText("Rimuru.temp Script Hub", homeX + 34, footerY + 7,
                Theme.Text, 12, 1, 44)
            paintText("Owned by @catscure and @0klayt", homeX + 34, footerY + 23,
                Theme.Muted, 10, 1, 44)

            paintRect(runtimeX, footerY, runtimeWidth, footerHeight, Theme.Panel,
                self.GlassEnabled and 0.58 or 0.97, 42, 8)
            paintRect(runtimeX, footerY, runtimeWidth, footerHeight, Theme.Border,
                0.78, 43, 8, false, 1)
            paintIcon("terminal", runtimeX + 18, footerY + 21, Theme.HoverText, 44, 0.92)
            paintText("Matcha", runtimeX + 34, footerY + 7, Theme.Text, 12, 1, 44)
            paintText("LuaU VM Only", runtimeX + 34, footerY + 23, Theme.Muted, 10, 1, 44)
        end
    end
    if activeTab and activeTab.Sections and not activeTab.IsHome then
        local contentX = x + side + 20
        local contentY = y + topbar + 16
        local contentBottom = y + drawHeight - 12
        local contentViewportHeight = math.max(1, contentBottom - contentY)
        local contentWidth = width - side - 40
        local gap, defaultHeight = 14, 148
        local cardWidth = (contentWidth - gap) / 2
        local columnHeights = { 0, 0 }
        local sectionLayouts = {}
        local searchQuery = lower(tostring(self.SearchQuery or ""))
        local function itemMatches(item)
            if searchQuery == "" then return true end
            return lower(tostring(item.Text or "")):find(searchQuery, 1, true) ~= nil
        end
        local function sectionMatches(section)
            if searchQuery == "" then return true end
            for i = 1, #section.Items do
                if itemMatches(section.Items[i]) then return true end
            end
            return false
        end
        local visibleSections = {}
        for sectionIndex = 1, #activeTab.Sections do
            local section = activeTab.Sections[sectionIndex]
            if sectionMatches(section) then visibleSections[#visibleSections + 1] = section end
        end
        local nextAutomaticColumn = 0
        for sectionIndex = 1, #visibleSections do
            local section = visibleSections[sectionIndex]
            local column = section.Column
            if column == nil then
                column = nextAutomaticColumn
                nextAutomaticColumn = 1 - nextAutomaticColumn
            end
            section:PrepareLabels(cardWidth - 28, itemMatches)
            local cardHeight = section:GetHeight(defaultHeight, itemMatches)
            sectionLayouts[sectionIndex] = {
                Column = column,
                Offset = columnHeights[column + 1],
                Height = cardHeight,
            }
            columnHeights[column + 1] = columnHeights[column + 1] + cardHeight + 17 + gap
        end
        local totalContentHeight = math.max(columnHeights[1], columnHeights[2])
        local maxContentScroll = math.max(0, totalContentHeight - gap - contentViewportHeight)
        self.ContentScroll = self.ContentScroll or 0
        if RimuruUI.IsMouseOver(contentX, contentY, contentWidth, contentViewportHeight) and state.Wheel ~= 0 then
            self.ContentScroll = self.ContentScroll - state.Wheel * 34
        end
        self.ContentScroll = math.max(0, math.min(maxContentScroll, self.ContentScroll))
        state.ClipTop = contentY
        state.ClipBottom = contentBottom
        state.ContentLeft = contentX
        state.ContentRight = contentX + contentWidth
        state.ContentFadeBottom = contentBottom + 3
        for sectionIndex = 1, #visibleSections do
            local section = visibleSections[sectionIndex]
            local layout = sectionLayouts[sectionIndex]
            local column = layout.Column
            local cardX = contentX + column * (cardWidth + gap)
            local cardY = contentY + layout.Offset - self.ContentScroll
            local cardHeight = layout.Height
            local cardTop, cardBottom = cardY + 17, cardY + 17 + cardHeight
            local sectionVisible = cardBottom > contentY and cardTop < contentBottom
            local visibleCardTop = math.max(cardTop, contentY - 8)
            local visibleCardBottom = math.min(cardBottom, contentBottom)
            local visibleCardHeight = visibleCardBottom - visibleCardTop
            section.CollapseProgress = approach(section.CollapseProgress or 0,
                section.Collapsed and 1 or 0, 18)
            local headerVisible = cardY + 17 > contentY and cardY < contentBottom
            if headerVisible then
                local titleOpacity = viewportOpacity(cardY, 14, contentY, contentBottom + 3, 10)
                local headerHovered = RimuruUI.IsMouseOver(cardX, cardY - 3, cardWidth, 18)
                section.Hover = approach(section.Hover or 0, headerHovered and 1 or 0, 18)
                local headerColour = colourMix(Theme.Text, Theme.HoverText, section.Hover)
                paintText(section.Title, cardX, cardY, headerColour, 11, titleOpacity, 40)
                local arrowX, arrowY = cardX + cardWidth - 9, cardY + 6
                if section.Collapsed then
                    bubbleLine(arrowX - 3, arrowY + 1, arrowX, arrowY - 2,
                        headerColour, titleOpacity, 41, 1)
                    bubbleLine(arrowX, arrowY - 2, arrowX + 3, arrowY + 1,
                        headerColour, titleOpacity, 41, 1)
                else
                    bubbleLine(arrowX - 3, arrowY - 1, arrowX, arrowY + 2,
                        headerColour, titleOpacity, 41, 1)
                    bubbleLine(arrowX, arrowY + 2, arrowX + 3, arrowY - 1,
                        headerColour, titleOpacity, 41, 1)
                end
                if RimuruUI.ConsumeMousePress(cardX, cardY - 3, cardWidth, 18) then
                    section.Collapsed = not section.Collapsed
                    debugLog("section " .. (section.Collapsed and "collapsed" or "expanded"), section.Title)
                end
            end
            local bodyOpacity = 1 - (section.CollapseProgress or 0)
            if bodyOpacity > 0.01 and sectionVisible and visibleCardHeight > 0 then
                paintRect(cardX, visibleCardTop, cardWidth, visibleCardHeight,
                    Theme.Card, bodyOpacity * (self.GlassEnabled and 0.58 or 0.97), 20, 11)
                paintRect(cardX, visibleCardTop, cardWidth, visibleCardHeight, Theme.Border,
                    bodyOpacity * 0.86, 30, 11, false, 1)
            end
            local itemX, itemY = cardX + 14, cardY + 21
            local itemWidth = cardWidth - 28
            if bodyOpacity > 0.01 then
                local renderedItemIndex = 0
                for itemIndex = 1, #section.Items do
                    local item = section.Items[itemIndex]
                    if itemMatches(item) then
                        renderedItemIndex = renderedItemIndex + 1
                        local itemHeight = item.Height or 28
                        local itemOpacity = viewportOpacity(itemY, itemHeight,
                            contentY, contentBottom + 3, 10) * bodyOpacity
                        if itemOpacity > 0 then
                            state.LocalAlpha = itemOpacity
                            if renderedItemIndex > 1 then
                                local separatorOpacity = viewportOpacity(itemY - 1, 1,
                                    contentY, contentBottom + 3, 8)
                                state.LocalAlpha = 1
                                paintLine(itemX, itemY - 1, itemX + itemWidth, itemY - 1,
                                    Theme.BorderSoft, separatorOpacity * 0.68, 33 + renderedItemIndex, 1)
                                state.LocalAlpha = itemOpacity
                            end
                            renderSectionItem(item, itemX, itemY, itemWidth, 34 + renderedItemIndex)
                            state.LocalAlpha = 1
                        end
                        itemY = itemY + itemHeight
                    end
                end
            end
            state.LocalAlpha = 1
        end
        state.LocalAlpha = 1

        state.ClipTop = nil
        state.ClipBottom = nil
        state.ContentLeft = nil
        state.ContentRight = nil
        state.ContentFadeBottom = nil
        if maxContentScroll > 0 then
            local trackX, trackY = x + width - 9, contentY
            local trackHeight = contentViewportHeight
            local thumbHeight = math.max(26, trackHeight * contentViewportHeight / totalContentHeight)
            local thumbY = trackY + (trackHeight - thumbHeight) * (self.ContentScroll / maxContentScroll)
            paintRect(trackX, trackY, 4, trackHeight, Theme.BorderSoft, 0.82, 80, 2)
            local thumbHovered = RimuruUI.IsMouseOver(trackX - 4, thumbY, 12, thumbHeight)
            local thumbColour = colourMix(Theme.Muted, Theme.HoverText,
                (thumbHovered or self.ContentScrollDragging) and 1 or 0)
            paintRect(trackX - 1, thumbY, 6, thumbHeight, thumbColour,
                (thumbHovered or self.ContentScrollDragging) and 0.68 or 0.40, 81, 3)
            if self.ContentScrollDragging then
                if not RimuruUI.IsDown("m1") then
                    self.ContentScrollDragging = false
                else
                    local next = (state.MouseY - trackY - self.ContentScrollDragOffset) /
                        math.max(1, trackHeight - thumbHeight)
                    self.ContentScroll = math.max(0, math.min(maxContentScroll, next * maxContentScroll))
                end
            elseif RimuruUI.ConsumeMousePress(trackX - 4, thumbY, 12, thumbHeight) then
                self.ContentScrollDragging = true
                self.ContentScrollDragOffset = state.MouseY - thumbY
            end
        end
    end
    state.RenderAlpha = previousRenderAlpha
    state.LocalAlpha = previousLocalAlpha
end

