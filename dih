local function safeConfigName(value)
    local name = tostring(value or "default"):gsub("[^%w%-%._]", "_")
    return name ~= "" and name or "default"
end

local function safeConfigFolder(value)
    local folder = tostring(value or "RimuruUI")
    folder = folder:gsub("\\", "/"):gsub("^/+", ""):gsub("/+$", "")
    folder = folder:gsub("%.%.", "_"):gsub("[^%w%-%._/]", "_")
    return folder ~= "" and folder or "RimuruUI"
end

local function configFolder(window)
    return safeConfigFolder(window.ConfigFolder or
        ("RimuruUI_" .. safeConfigName(window.Title)))
end

local function configPath(window, name)
    return configFolder(window) .. "/" .. safeConfigName(name) .. ".json"
end

local function preferencesPath(window)
    return configFolder(window) .. "/preferences.json"
end

local function configFileExists(path)
    local checked, exists = pcall(filesystemIsFile, path)
    if checked and exists ~= nil then
        return exists == true
    end
    if filesystemCanRead() then
        local read = pcall(filesystemRead, path)
        return read
    end
    return false
end

local function ensureConfigFolders(window)
    local folder = configFolder(window)
    local checked, exists = pcall(filesystemIsFolder, folder)
    if checked and exists == true then return true end
    if type(makefolder) ~= "function" and type(MakeFolder) ~= "function" then
        return true
    end
    local ok, message = pcall(filesystemMakeFolder, folder)
    if not ok then return false, tostring(message) end
    return true
end

local function fallbackJsonEncode(value)
    local active = {}
    local function encode(current)
        local kind = type(current)
        if kind == "nil" then return "null" end
        if kind == "boolean" then return current and "true" or "false" end
        if kind == "number" then
            if current ~= current or current == math.huge or current == -math.huge then return "0" end
            return tostring(current)
        end
        if kind == "string" then
            return '"' .. current:gsub('[%z\1-\31\\"]', function(character)
                local escapes = { ['"'] = '\\"', ['\\'] = '\\\\', ['\b'] = '\\b',
                    ['\f'] = '\\f', ['\n'] = '\\n', ['\r'] = '\\r', ['\t'] = '\\t' }
                return escapes[character] or string.format("\\u%04x", string.byte(character))
            end) .. '"'
        end
        if kind ~= "table" then return "null" end
        if active[current] then error("cyclic config value") end
        active[current] = true
        local count, maximum, array = 0, 0, true
        for key in pairs(current) do
            count = count + 1
            if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then
                array = false
            elseif key > maximum then
                maximum = key
            end
        end
        array = array and maximum == count
        local output = {}
        if array then
            for index = 1, maximum do output[index] = encode(current[index]) end
            active[current] = nil
            return "[" .. table.concat(output, ",") .. "]"
        end
        local keys = {}
        for key in pairs(current) do keys[#keys + 1] = tostring(key) end
        table.sort(keys)
        for index = 1, #keys do
            local key = keys[index]
            output[index] = encode(key) .. ":" .. encode(current[key])
        end
        active[current] = nil
        return "{" .. table.concat(output, ",") .. "}"
    end
    return encode(value)
end

local function encodeJson(value)
    if game then
        local ok, result = pcall(function()
            return game:GetService("HttpService"):JSONEncode(value)
        end)
        if ok and type(result) == "string" then return result end
        debugLog("HttpService JSONEncode fallback", result)
    end
    local ok, result = pcall(fallbackJsonEncode, value)
    return ok and result or nil
end

local function decodeJson(value)
    if type(value) ~= "string" then return nil end
    if game then
        local ok, result = pcall(function()
            return game:GetService("HttpService"):JSONDecode(value)
        end)
        if ok and type(result) == "table" then return result end
        debugLog("HttpService JSONDecode fallback", result)
    end
    local position = 1
    local length = #value
    local function skipWhitespace()
        while position <= length and value:sub(position, position):match("%s") do
            position = position + 1
        end
    end
    local function parseString()
        if value:sub(position, position) ~= '"' then error("expected string") end
        position = position + 1
        local output = {}
        while position <= length do
            local character = value:sub(position, position)
            position = position + 1
            if character == '"' then return table.concat(output) end
            if character ~= "\\" then
                output[#output + 1] = character
            else
                local escaped = value:sub(position, position)
                position = position + 1
                local map = { ['"'] = '"', ["\\"] = "\\", ["/"] = "/",
                    ["b"] = "\b", ["f"] = "\f", ["n"] = "\n", ["r"] = "\r", ["t"] = "\t" }
                if escaped == "u" then
                    local hex = value:sub(position, position + 3)
                    position = position + 4
                    local code = tonumber(hex, 16) or 63
                    output[#output + 1] = code < 128 and string.char(code) or "?"
                else
                    output[#output + 1] = map[escaped] or escaped
                end
            end
        end
        error("unterminated string")
    end
    local parseValue
    local function parseArray()
        position = position + 1
        local output = {}
        skipWhitespace()
        if value:sub(position, position) == "]" then position = position + 1; return output end
        while true do
            output[#output + 1] = parseValue()
            skipWhitespace()
            local delimiter = value:sub(position, position)
            position = position + 1
            if delimiter == "]" then return output end
            if delimiter ~= "," then error("expected array delimiter") end
            skipWhitespace()
        end
    end
    local function parseObject()
        position = position + 1
        local output = {}
        skipWhitespace()
        if value:sub(position, position) == "}" then position = position + 1; return output end
        while true do
            skipWhitespace()
            local key = parseString()
            skipWhitespace()
            if value:sub(position, position) ~= ":" then error("expected object colon") end
            position = position + 1
            output[key] = parseValue()
            skipWhitespace()
            local delimiter = value:sub(position, position)
            position = position + 1
            if delimiter == "}" then return output end
            if delimiter ~= "," then error("expected object delimiter") end
        end
    end
    parseValue = function()
        skipWhitespace()
        local character = value:sub(position, position)
        if character == '"' then return parseString() end
        if character == "{" then return parseObject() end
        if character == "[" then return parseArray() end
        if value:sub(position, position + 3) == "true" then position = position + 4; return true end
        if value:sub(position, position + 4) == "false" then position = position + 5; return false end
        if value:sub(position, position + 3) == "null" then position = position + 4; return nil end
        local number = value:sub(position):match("^-?%d+%.?%d*[eE]?[+-]?%d*")
        if number and number ~= "" then position = position + #number; return tonumber(number) end
        error("invalid JSON value")
    end
    local ok, result = pcall(function()
        local decoded = parseValue()
        skipWhitespace()
        if position <= length then error("trailing JSON data") end
        return decoded
    end)
    return ok and result or nil
end

local function eachConfigWidget(window, callback)
    local function visitTab(tab)
        if not tab or type(tab.Sections) ~= "table" then return end
        for sectionIndex = 1, #tab.Sections do
            local section = tab.Sections[sectionIndex]
            for itemIndex = 1, #section.Items do callback(section.Items[itemIndex]) end
        end
    end
    visitTab(window.SettingsTab)
    for categoryIndex = 1, #window.Categories do
        local category = window.Categories[categoryIndex]
        for tabIndex = 1, #category.Tabs do visitTab(category.Tabs[tabIndex]) end
    end
end

local function savedColour(picker)
    if not picker then return nil end
    local red, green, blue = colorComponents(picker.Value)
    return { Red = red, Green = green, Blue = blue, Alpha = picker.Alpha or 1 }
end

local function cloneConfigValue(value, seen)
    if type(value) ~= "table" then return value end
    seen = seen or {}
    if seen[value] then return seen[value] end
    local copy = {}
    seen[value] = copy
    for key, nested in pairs(value) do
        copy[cloneConfigValue(key, seen)] = cloneConfigValue(nested, seen)
    end
    return copy
end

local function restoreColour(picker, saved)
    if not picker or type(saved) ~= "table" then return end
    picker.Value = makeColor(tonumber(saved.Red) or 1, tonumber(saved.Green) or 1,
        tonumber(saved.Blue) or 1)
    picker.Alpha = clamp(tonumber(saved.Alpha) or 1, 0, 1)
    picker.HsvReady = false
    if type(picker.Callback) == "function" then pcall(picker.Callback, picker.Value, picker) end
end

local function saveWidget(item)
    if item.NoConfig or item.Type == "button" or item.Type == "label" then return nil end
    local saved = { Type = item.Type }
    if item.Type == "colorpicker" then
        saved.Colour = savedColour(item)
    elseif item.Type == "dropdown" and item.Multi then
        local selected = {}
        for index = 1, #(item.Options or {}) do
            local option = item.Options[index]
            if dropdownHasValue(item, option) then selected[#selected + 1] = option end
        end
        saved.Value = selected
    else
        saved.Value = cloneConfigValue(item.Value)
    end
    if item.Type == "keybind" then saved.Mode = item.Mode end
    if item.Keybind then
        saved.Keybind = { Value = item.Keybind.Value, Mode = item.Keybind.Mode }
    end
    if item.ColorPicker then saved.AttachedColour = savedColour(item.ColorPicker) end
    return saved
end

local function restoreWidget(item, saved)
    if type(saved) ~= "table" then return end
    if item.Type == "colorpicker" then
        restoreColour(item, saved.Colour)
    elseif saved.Value ~= nil then
        RimuruUI.SetWidgetValue(item, cloneConfigValue(saved.Value), false)
    end
    if item.Type == "keybind" and saved.Mode then item.Mode = lower(tostring(saved.Mode)) end
    if item.Keybind and type(saved.Keybind) == "table" then
        item.Keybind.Value = lower(tostring(saved.Keybind.Value or "None"))
        item.Keybind.Mode = lower(tostring(saved.Keybind.Mode or "toggle"))
    end
    restoreColour(item.ColorPicker, saved.AttachedColour)
end

function Config:Collect()
    local values = {}
    eachConfigWidget(self.Window, function(item)
        local saved = saveWidget(item)
        if saved then values[item.ConfigKey] = saved end
    end)
    return { Version = 1, Theme = self.Window.ThemeName or "Rimuru Hub", Values = values }
end

function Config:GetFolder()
    return configFolder(self.Window)
end

function Config:GetPath(name)
    return configPath(self.Window, name or self.Name)
end

function Config:Save(name)
    name = safeConfigName(name or self.Name)
    local path = configPath(self.Window, name)
    debugLog("config save requested", path)
    local collected, data = pcall(function() return self:Collect() end)
    if not collected then return false, "pack failed: " .. tostring(data) end
    if not filesystemCanWrite() then return false, "Matcha writefile is unavailable" end
    local encoded = encodeJson(data)
    if not encoded then return false, "JSON encode failed" end
    local folderOk, folderError = ensureConfigFolders(self.Window)
    if not folderOk then return false, "folder failed: " .. tostring(folderError) end
    debugLog("config write attempt", path, #encoded .. " bytes")
    local ok, writeError = pcall(filesystemWrite, path, encoded)
    if not ok then return false, "write failed: " .. tostring(writeError) end
    local checked, exists = pcall(filesystemIsFile, path)
    if checked and exists ~= nil and exists ~= true then
        return false, "writefile returned but the file does not exist"
    end
    if filesystemCanRead() then
        local read, persisted = pcall(filesystemRead, path)
        if not read then return false, "write verification failed: " .. tostring(persisted) end
        if type(decodeJson(persisted)) ~= "table" then
            return false, "write verification failed: persisted JSON is invalid"
        end
    end
    self.Name, self.LastSave = name, clock()
    self.Window.ConfigName = name
    self:SavePreferences()
    self:RefreshControls()
    debugLog("config saved", name, path)
    return true, path
end

function Config:Load(name)
    name = safeConfigName(name or self.Name)
    local path = configPath(self.Window, name)
    debugLog("config load requested", path)
    if not filesystemCanRead() then return false, "Matcha readfile is unavailable" end
    if not configFileExists(path) then return false, "config not found: " .. path end
    local ok, encoded = pcall(filesystemRead, path)
    if not ok then return false, "read failed: " .. tostring(encoded) end
    local data = decodeJson(encoded)
    if type(data) ~= "table" or type(data.Values) ~= "table" then
        debugLog("config decode failed", path)
        return false, "JSON decode failed"
    end
    self.Window.ConfigLoading = true
    if data.Theme and type(RimuruUI.ApplyTheme) == "function" then
        RimuruUI.ApplyTheme(data.Theme, self.Window)
    end
    eachConfigWidget(self.Window, function(item)
        restoreWidget(item, data.Values[item.ConfigKey])
    end)
    self.Window.ConfigLoading = false
    self.Name = name
    self.Window.ConfigName = name
    self:SavePreferences()
    self:RefreshControls()
    debugLog("config loaded", name)
    return true
end

function Config:Delete(name)
    name = safeConfigName(name or self.Name)
    local path = configPath(self.Window, name)
    if configFileExists(path) then
        local deleted, deleteError = pcall(filesystemDelete, path)
        if not deleted then return false, tostring(deleteError) end
    end
    if self.AutoLoadName == name then self.AutoLoadName = nil end
    if self.Name == name then
        self.Name = safeConfigName(self.Window.DefaultConfigName or "default")
        self.Window.ConfigName = self.Name
    end
    self:SavePreferences()
    self:RefreshControls()
    debugLog("config deleted", name)
    return true
end

function Config:List()
    local found, names = {}, {}
    local folder = configFolder(self.Window)
    local checked, folderReady = pcall(filesystemIsFolder, folder)
    if not checked or folderReady == nil then folderReady = true end
    if folderReady then
        local listed, files = pcall(filesystemList, folder)
        if listed and type(files) == "table" then
            for _, listedPath in ipairs(files) do
                local name = tostring(listedPath):match("([^/\\]+)%.json$")
                if name and name ~= "preferences" and name:sub(1, 1) ~= "_" then
                    found[name] = true
                end
            end
        end
    end
    for name in pairs(found) do names[#names + 1] = name end
    table.sort(names)
    return names
end

function Config:RefreshControls()
    local names = self:List()
    if self.ConfigDropdown and type(self.ConfigDropdown.SetOptions) == "function" then
        self.ConfigDropdown:SetOptions(names, self.Name, true)
    end
    local autoLoadOptions = { "None" }
    for index = 1, #names do autoLoadOptions[#autoLoadOptions + 1] = names[index] end
    if self.AutoLoadDropdown and type(self.AutoLoadDropdown.SetOptions) == "function" then
        self.AutoLoadDropdown:SetOptions(autoLoadOptions, self.AutoLoadName or "None", true)
    end
    return names
end

function Config:SetSelected(name)
    self.Name = safeConfigName(name or self.Name)
    self.Window.ConfigName = self.Name
    self:SavePreferences()
    self:RefreshControls()
    debugLog("config selected", self.Name)
    return self.Name
end

function Config:CreateUnique(prefix)
    prefix = tostring(prefix or "Config")
    local occupied = {}
    for _, name in ipairs(self:List()) do occupied[lower(name)] = true end
    local index, name = 1, prefix .. " 1"
    while occupied[lower(name)] do
        index = index + 1
        name = prefix .. " " .. tostring(index)
    end
    local previousName = self.Name
    self.Name = safeConfigName(name)
    self.Window.ConfigName = self.Name
    local ok, message = self:Save(self.Name)
    if not ok then
        self.Name = previousName
        self.Window.ConfigName = previousName
    end
    self:RefreshControls()
    return ok, ok and safeConfigName(name) or previousName, message
end

function Config:SavePreferences()
    local values = {
        AutoSave = self.AutoSave == true,
        AutoLoad = self.AutoLoadName ~= nil,
        AutoLoadConfig = self.AutoLoadName or "None",
        Config = self.Name,
    }
    local path = preferencesPath(self.Window)
    if filesystemCanWrite() then
        local encoded = encodeJson(values)
        if encoded then
            local folderOk = ensureConfigFolders(self.Window)
            if folderOk then
                local ok, message = pcall(filesystemWrite, path, encoded)
                if not ok then debugLog("preferences write failed", message) end
            end
        end
    end
    return values
end

function Config:LoadPreferences()
    local path = preferencesPath(self.Window)
    local values
    if filesystemCanRead() and configFileExists(path) then
        local read, encoded = pcall(filesystemRead, path)
        if read then values = decodeJson(encoded) end
    end
    if type(values) == "table" then
        self.AutoSave = values.AutoSave == true
        self.Name = safeConfigName(values.Config or self.Name)
        self.Window.ConfigName = self.Name
        local autoLoadName = values.AutoLoadConfig
        if autoLoadName == nil and values.AutoLoad == true then autoLoadName = self.Name end
        if autoLoadName and lower(tostring(autoLoadName)) ~= "none" then
            self.AutoLoadName = safeConfigName(autoLoadName)
        else
            self.AutoLoadName = nil
        end
    end
    return {
        AutoSave = self.AutoSave == true,
        AutoLoad = self.AutoLoadName ~= nil,
        AutoLoadConfig = self.AutoLoadName or "None",
        Config = self.Name,
    }
end

function Config:SetAutoSave(enabled)
    self.AutoSave = enabled == true
    self:SavePreferences()
    if self.AutoSave then self:Save(self.Name) end
    debugLog("auto save", self.AutoSave)
    return self.AutoSave
end

function Config:SetAutoLoad(name)
    if name == true then name = self.Name end
    if name == false or name == nil or lower(tostring(name)) == "none" then
        self.AutoLoadName = nil
    else
        self.AutoLoadName = safeConfigName(name)
    end
    self:SavePreferences()
    self:RefreshControls()
    debugLog("auto load", self.AutoLoadName or "None")
    return self.AutoLoadName
end

function Config:LoadAutoLoad()
    if not self.AutoLoadName then return false, "auto load disabled" end
    return self:Load(self.AutoLoadName)
end

function Config:BuildSettings()
    if self.ControlsBuilt then return self.SettingsSection end
    self.ControlsBuilt = true
    local section = self.Window.SettingsTab:CreateSection("CONFIGURATION")
    self.SettingsSection = section
    self.ConfigDropdown = section:AddDropdown("Config", {
        Options = self:List(),
        Default = self.Name,
        NoConfig = true,
        Callback = function(value) self:SetSelected(value) end,
    })
    self.AutoSaveToggle = section:AddToggle("Auto Save", {
        Default = false,
        NoConfig = true,
        Callback = function(value) self:SetAutoSave(value) end,
    })
    self.AutoLoadDropdown = section:AddDropdown("Auto Load", {
        Options = { "None" },
        Default = self.AutoLoadName or "None",
        NoConfig = true,
        Callback = function(value) self:SetAutoLoad(value) end,
    })
    section:AddButton("Create Config", {
        Callback = function()
            debugLog("config create requested", self:GetFolder())
            local ok, name, message = self:CreateUnique("Config")
            RimuruUI.Notify({
                Title = ok and "Config created" or "Config error",
                Description = ok and (name .. " is now selected.") or tostring(message),
                Type = ok and "success" or "error",
            })
        end,
    })
    section:AddButton("Save Config", {
        Callback = function()
            local ok, message = self:Save(self.Name)
            RimuruUI.Notify({
                Title = ok and "Config saved" or "Save failed",
                Description = ok and (self.Name .. " was saved.") or tostring(message),
                Type = ok and "success" or "error",
            })
        end,
    })
    section:AddButton("Load Config", {
        Callback = function()
            local ok, message = self:Load(self.Name)
            RimuruUI.Notify({
                Title = ok and "Config loaded" or "Load failed",
                Description = ok and (self.Name .. " was loaded.") or tostring(message),
                Type = ok and "success" or "error",
            })
        end,
    })
    section:AddButton("Delete Config", {
        Callback = function()
            local deleted = self.Name
            local ok = self:Delete(deleted)
            RimuruUI.Notify({
                Title = ok and "Config deleted" or "Delete failed",
                Description = ok and (deleted .. " was deleted.") or "Could not delete the config.",
                Type = ok and "warning" or "error",
            })
        end,
    })
    section:AddButton("Refresh Configs", {
        Callback = function()
            local names = self:RefreshControls()
            RimuruUI.Notify({
                Title = "Configs refreshed",
                Description = tostring(#names) .. " config(s) available.",
                Type = "info",
            })
        end,
    })

    local themeSection = self.Window.SettingsTab:CreateSection("THEME")
    self.ThemeDropdown = themeSection:AddDropdown("Theme", {
        Options = type(RimuruUI.GetThemes) == "function" and RimuruUI.GetThemes() or { "Rimuru Hub" },
        Default = self.Window.ThemeName or "Rimuru Hub",
        Flag = "Settings/Theme",
        Callback = function(value)
            if type(RimuruUI.ApplyTheme) == "function" then
                RimuruUI.ApplyTheme(value, self.Window)
            end
        end,
    })

    local interfaceSection = self.Window.SettingsTab:CreateSection("INTERFACE")
    self.KeybindOverlayToggle = interfaceSection:AddToggle("Keybind Overlay", {
        Default = self.Window.ShowKeybindOverlay ~= false,
        Flag = "Settings/KeybindOverlay",
        Callback = function(value) self.Window.ShowKeybindOverlay = value == true end,
    })
    self.WatermarkToggle = interfaceSection:AddToggle("Watermark", {
        Default = self.Window.ShowWatermark ~= false,
        Flag = "Settings/Watermark",
        Callback = function(value) self.Window.ShowWatermark = value == true end,
    })
    return section
end

function Config:Initialize()
    if self.Initialized then return true end
    self.Initialized = true
    self:RefreshControls()
    if self.AutoSaveToggle then self.AutoSaveToggle:SetValue(self.AutoSave, true) end
    local autoLoadAttempted = self.AutoLoadName ~= nil
    if autoLoadAttempted then
        local ok, message = self:LoadAutoLoad()
        if ok ~= true then
            RimuruUI.Notify({
                Title = "Auto Load failed",
                Description = tostring(message or self.AutoLoadName),
                Type = "error",
                Duration = 5,
            })
        end
    end



    local currentPath = configPath(self.Window, self.Name)
    if not configFileExists(currentPath) then
        local created, message = self:Save(self.Name)
        if not created then
            RimuruUI.Notify({
                Title = "Config creation failed",
                Description = tostring(message),
                Type = "error",
                Duration = 7,
            })
            debugLog("config creation failed", currentPath, message)
        else
            debugLog("config created", currentPath)
        end
    end
    debugLog("config initialized", self.Name, self.AutoLoadName or "None")
    return true
end

function Window:Finalize()
    self.ActiveTab = self.HomeTab
    self.TabScroll = 0
    self.ContentScroll = 0
    self.Ready = true
    return self
end

function Window:CreateConfig(name)
    if self.Config then return self.Config end
    self.ConfigFolder = safeConfigFolder(self.ConfigFolder)
    self.ConfigName = safeConfigName(name or self.ConfigName or "default")
    self.DefaultConfigName = safeConfigName(self.DefaultConfigName or self.ConfigName)
    local config = setmetatable({
        Window = self,
        Name = self.ConfigName,
        AutoSave = false,
        AutoLoadName = nil,
        DirtyVersion = 0,
        Folder = self.ConfigFolder,
        StorageAvailable = filesystemCanWrite() and filesystemCanRead(),
    }, Config)
    self.Config = config
    local folderReady, folderError = ensureConfigFolders(self)
    config.FolderReady = folderReady == true
    if not folderReady then
        debugLog("config folder failed", config.Folder, folderError)
    else
        debugLog("config folder ready", config.Folder)
    end
    config:LoadPreferences()
    config:BuildSettings()
    debugLog("config storage", config.Folder, config.Name,
        config.StorageAvailable and "Matcha filesystem" or "filesystem unavailable")
    return config
end

