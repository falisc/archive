local NonUIIconMasks, NonUIIconSheets = {}, {}
local NonUIIconSheetCount = 0
local Base64Values = {}
for index = 1, 64 do
    Base64Values[string.byte("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", index)] = index - 1
end

local function decodeIconMask(encoded)
    if type(base64decode) == "function" then
        local ok, decoded = pcall(base64decode, encoded)
        if ok and type(decoded) == "string" and #decoded >= 576 then return decoded end
    end
    local bytes, hold, bits = {}, 0, 0
    for index = 1, #encoded do
        local value = Base64Values[string.byte(encoded, index)]
        if value then
            hold = hold * 64 + value
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local place = 2 ^ bits
                local decoded = floor(hold / place)
                hold = hold - decoded * place
                bytes[#bytes + 1] = string.char(decoded)
            end
        end
    end
    return concat(bytes)
end

local function iconBitHelpers()
    if bit32 then return bit32.bxor, bit32.band, bit32.rshift end
    local function bxor(first, second)
        local result, place = 0, 1
        for _ = 1, 32 do
            local a, b = first % 2, second % 2
            if a ~= b then result = result + place end
            first, second, place = (first - a) / 2, (second - b) / 2, place * 2
        end
        return result
    end
    local function band(first, second)
        local result, place = 0, 1
        for _ = 1, 32 do
            local a, b = first % 2, second % 2
            if a == 1 and b == 1 then result = result + place end
            first, second, place = (first - a) / 2, (second - b) / 2, place * 2
        end
        return result
    end
    return bxor, band, function(value, amount) return floor(value / 2 ^ amount) end
end

local IconBxor, IconBand, IconRshift = iconBitHelpers()
local IconCrcTable = {}
for value = 0, 255 do
    local crc = value
    for _ = 1, 8 do
        if IconBand(crc, 1) == 1 then
            crc = IconBxor(0xEDB88320, IconRshift(crc, 1))
        else
            crc = IconRshift(crc, 1)
        end
    end
    IconCrcTable[value] = crc
end

local function iconCrc32(value)
    local crc = 0xFFFFFFFF
    for index = 1, #value do
        crc = IconBxor(IconRshift(crc, 8), IconCrcTable[IconBand(IconBxor(crc,
            string.byte(value, index)), 255)])
    end
    return IconBxor(crc, 0xFFFFFFFF)
end

local function iconAdler32(value)
    local first, second = 1, 0
    for index = 1, #value do
        first = (first + string.byte(value, index)) % 65521
        second = (second + first) % 65521
    end
    return second * 65536 + first
end

local function iconBe32(value)
    return string.char(floor(value / 16777216) % 256, floor(value / 65536) % 256,
        floor(value / 256) % 256, value % 256)
end

local function iconDeflate(raw)
    local output, offset = { string.char(120, 1) }, 1
    while offset <= #raw do
        local size = math.min(#raw - offset + 1, 65535)
        local final = offset + size - 1 >= #raw and 1 or 0
        local function little16(value)
            return string.char(value % 256, floor(value / 256) % 256)
        end
        output[#output + 1] = string.char(final) .. little16(size) .. little16(65535 - size) ..
            sub(raw, offset, offset + size - 1)
        offset = offset + size
    end
    output[#output + 1] = iconBe32(iconAdler32(raw))
    return concat(output)
end

local function rgbaPng(width, height, rows)
    local function chunk(name, data)
        return iconBe32(#data) .. name .. data .. iconBe32(iconCrc32(name .. data))
    end
    return string.char(137, 80, 78, 71, 13, 10, 26, 10) ..
        chunk("IHDR", iconBe32(width) .. iconBe32(height) .. string.char(8, 6, 0, 0, 0)) ..
        chunk("IDAT", iconDeflate(rows)) .. chunk("IEND", "")
end

local function iconPng(mask, red, green, blue)
    local rows, offset = {}, 0
    local colour = string.char(red, green, blue)
    for _ = 1, 24 do
        rows[#rows + 1] = string.char(0)
        local row = {}
        for column = 1, 24 do
            offset = offset + 1
            row[column] = colour .. string.char(string.byte(mask, offset) or 0)
        end
        rows[#rows + 1] = concat(row)
    end
    local pixels = concat(rows)
    return rgbaPng(24, 24, pixels)
end

local function rotateIconMask(mask, step)
    if step == 0 then return mask end
    local radians = step / 24 * math.pi * 2
    local cosine, sine = math.cos(radians), math.sin(radians)
    local output = {}
    for targetY = 0, 23 do
        for targetX = 0, 23 do
            local dx, dy = targetX - 11.5, targetY - 11.5
            local sourceX = floor(cosine * dx + sine * dy + 11.5 + 0.5)
            local sourceY = floor(-sine * dx + cosine * dy + 11.5 + 0.5)
            local alpha = 0
            if sourceX >= 0 and sourceX < 24 and sourceY >= 0 and sourceY < 24 then
                alpha = string.byte(mask, sourceY * 24 + sourceX + 1) or 0
            end
            output[#output + 1] = string.char(alpha)
        end
    end
    return concat(output)
end

local function iconColourBytes(colour)
    local ok, red, green, blue = pcall(function() return colour.R, colour.G, colour.B end)
    if not ok then return 255, 255, 255 end
    return floor(clamp(red or 1, 0, 1) * 255 + 0.5),
        floor(clamp(green or 1, 0, 1) * 255 + 0.5),
        floor(clamp(blue or 1, 0, 1) * 255 + 0.5)
end

local function nonUIIconSheet(kind, colour, rotation)
    local encoded = NonUIIconArt[kind]
    if not encoded then return nil end
    local red, green, blue = iconColourBytes(colour)
    local step = kind == "settings" and floor((((rotation or 0) % (math.pi * 2)) /
        (math.pi * 2)) * 24 + 0.5) % 24 or 0
    local cacheKey = kind .. ":" .. red .. ":" .. green .. ":" .. blue .. ":" .. step
    local sheet = NonUIIconSheets[cacheKey]
    if sheet then return sheet end
    local mask = NonUIIconMasks[kind]
    if not mask then
        mask = decodeIconMask(encoded)
        NonUIIconMasks[kind] = mask
    end
    if #mask < 576 then return nil end
    if step ~= 0 then mask = rotateIconMask(mask, step) end
    sheet = iconPng(mask, red, green, blue)
    if NonUIIconSheetCount > 160 then
        NonUIIconSheets, NonUIIconSheetCount = {}, 0
    end
    NonUIIconSheets[cacheKey] = sheet
    NonUIIconSheetCount = NonUIIconSheetCount + 1
    return sheet
end

