    Wheel = 0,
    DeltaTime = 0,
    Frame = 0,
    Focused = true,
    ToggleKey = "comma",
    Binds = {},
    Capture = nil,
    TextFocus = nil,
    MousePressConsumed = false,
    MouseRightConsumed = false,
    InputArmed = false,
    HasStarted = false,
}

RimuruUI.Keys = Keys
