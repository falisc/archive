local function invoke(callback, ...)
    local arguments = { ... }
    if type(callback) == "function" then
        local ok, message = pcall(callback, ...)
        if not ok then debugLog("widget callback error", message) end
    end
    local item = arguments[#arguments]
    local target = type(item) == "table" and (item.ParentItem or item) or nil
    if target and target.Type and type(RimuruUI.MarkConfigDirty) == "function" then
        RimuruUI.MarkConfigDirty(target)
    end
end

local function dropdownHasValue(item, option)
    if not item.Multi then return item.Value == option end
    if type(item.Value) ~= "table" then return false end
    if item.Value[option] ~= nil then return item.Value[option] == true end
    for i = 1, #item.Value do
        if item.Value[i] == option then return true end
    end
    return false
end

local function dropdownLabel(item)
    if not item.Multi then return tostring(item.Value or "None") end
    local selected = {}
    for i = 1, #item.Options do
        local option = item.Options[i]
        if dropdownHasValue(item, option) then selected[#selected + 1] = tostring(option) end
    end
    if #selected == 0 then return "None" end
    if #selected == 1 then return selected[1] end
    return tostring(#selected) .. " Selected"
end

local function colorComponents(value)
    if value and type(value) == "table" then
        local r = value.R or value[1] or 1
        local g = value.G or value[2] or 1
        local b = value.B or value[3] or 1
        if r > 1 or g > 1 or b > 1 then r, g, b = r / 255, g / 255, b / 255 end
        return clamp(tonumber(r) or 1, 0, 1), clamp(tonumber(g) or 1, 0, 1), clamp(tonumber(b) or 1, 0, 1)
    end
    local ok, r, g, b = pcall(function() return value.R, value.G, value.B end)
    if ok then return clamp(r or 1, 0, 1), clamp(g or 1, 0, 1), clamp(b or 1, 0, 1) end
    return 1, 1, 1
end

local function makeColor(r, g, b)
    if Color3 and type(Color3.new) == "function" then
        return Color3.new(clamp(r, 0, 1), clamp(g, 0, 1), clamp(b, 0, 1))
    end
    return { R = r, G = g, B = b }
end

local function colorValue(item)
    local r, g, b = colorComponents(item.Value)
    return makeColor(r, g, b), r, g, b
end

local function pickerAlpha(config)
    config = type(config) == "table" and config or {}
    if config.Transparency ~= nil then
        local transparency = tonumber(config.Transparency) or 0
        if transparency > 1 then transparency = transparency / 100 end
        return 1 - clamp(transparency, 0, 1)
    end
    return clamp(tonumber(config.Alpha or config.Opacity) or 1, 0, 1)
end

local function rgbToHsv(r, g, b)
    local maximum, minimum = math.max(r, g, b), math.min(r, g, b)
    local delta = maximum - minimum
    local h = 0
    if delta > 0 then
        if maximum == r then h = ((g - b) / delta) % 6
        elseif maximum == g then h = (b - r) / delta + 2
        else h = (r - g) / delta + 4 end
        h = h / 6
    end
    local s = maximum == 0 and 0 or delta / maximum
    return h, s, maximum
end

local function hsvToRgb(h, s, v)
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
    local slot = i % 6
    if slot == 0 then return v, t, p end
    if slot == 1 then return q, v, p end
    if slot == 2 then return p, v, t end
    if slot == 3 then return p, q, v end
    if slot == 4 then return t, p, v end
    return v, p, q
end




local ColourSvSheets, ColourSvSheetCount = {}, 0
local ColourHueSheet
local ColourAlphaSheets, ColourAlphaSheetCount = {}, 0

local function colourSvSheet(hue)
    local step = floor(clamp(hue or 0, 0, 1) * 47 + 0.5)
    local cached = ColourSvSheets[step]
    if cached then return cached end
    local rows = {}
    local tint = step / 47
    for y = 0, 63 do
        rows[#rows + 1] = string.char(0)
        local pixels = {}
        for x = 0, 63 do
            local r, g, b = hsvToRgb(tint, x / 63, 1 - y / 63)
            pixels[#pixels + 1] = string.char(
                floor(r * 255 + 0.5), floor(g * 255 + 0.5), floor(b * 255 + 0.5), 255)
        end
        rows[#rows + 1] = concat(pixels)
    end
    if ColourSvSheetCount > 20 then
        ColourSvSheets, ColourSvSheetCount = {}, 0
    end
    cached = rgbaPng(64, 64, concat(rows))
    ColourSvSheets[step] = cached
    ColourSvSheetCount = ColourSvSheetCount + 1
    return cached
end

local function colourHueSheet()
    if ColourHueSheet then return ColourHueSheet end
    local rows = {}
    for y = 0, 127 do
        local r, g, b = hsvToRgb(y / 127, 1, 1)
        local pixel = string.char(
            floor(r * 255 + 0.5), floor(g * 255 + 0.5), floor(b * 255 + 0.5), 255)
        rows[#rows + 1] = string.char(0) .. string.rep(pixel, 4)
    end
    ColourHueSheet = rgbaPng(4, 128, concat(rows))
    return ColourHueSheet
end

local function colourAlphaSheet(r, g, b)
    local red, green, blue = floor(r * 255 + 0.5), floor(g * 255 + 0.5), floor(b * 255 + 0.5)
    local key = tostring(red) .. ":" .. tostring(green) .. ":" .. tostring(blue)
    local cached = ColourAlphaSheets[key]
    if cached then return cached end
    local rows = {}
    for _ = 1, 2 do
        local pixels = {}
        for x = 0, 95 do
            pixels[#pixels + 1] = string.char(red, green, blue, floor(x / 95 * 255 + 0.5))
        end
        rows[#rows + 1] = string.char(0) .. concat(pixels)
    end
    if ColourAlphaSheetCount > 16 then
        ColourAlphaSheets, ColourAlphaSheetCount = {}, 0
    end
    cached = rgbaPng(96, 2, concat(rows))
    ColourAlphaSheets[key] = cached
    ColourAlphaSheetCount = ColourAlphaSheetCount + 1
    return cached
end

local function applyColorPickerPoint(item, kind, px, py, pw, ph)
    local mx = clamp((state.MouseX - px) / math.max(1, pw), 0, 1)
    local my = clamp((state.MouseY - py) / math.max(1, ph), 0, 1)
    if kind == "sv" then
        item.Saturation, item.ValueLevel = mx, 1 - my
    elseif kind == "hue" then
        item.Hue = my
    elseif kind == "alpha" then
        item.Alpha = mx
        if type(item.Callback) == "function" then pcall(item.Callback, item.Value, item) end
        if type(RimuruUI.MarkConfigDirty) == "function" then RimuruUI.MarkConfigDirty(item) end
        return
    end
    local r, g, b = hsvToRgb(item.Hue or 0, item.Saturation or 0, item.ValueLevel or 1)
    item.Value = makeColor(r, g, b)
    if type(item.Callback) == "function" then pcall(item.Callback, item.Value, item) end
    if type(RimuruUI.MarkConfigDirty) == "function" then RimuruUI.MarkConfigDirty(item) end
end

local function processColorPickerModal()
    local item = state.ColorPickerOpen
    local bounds = item and item.PopupBounds
    if not item or not item.Open or type(bounds) ~= "table" then
        state.ColorPickerOpen = nil
        return
    end
    local inside = RimuruUI.IsMouseOver(bounds.X, bounds.Y, bounds.Width, bounds.Height)
    if Keys.m1.Pressed then

        state.MousePressConsumed = true
        if bounds.Copy and RimuruUI.IsMouseOver(bounds.Copy.X, bounds.Copy.Y,
            bounds.Copy.Width, bounds.Copy.Height) then
            local r, g, b = colorComponents(item.Value)
            local hex = string.format("#%02X%02X%02X",
                floor(r * 255 + 0.5), floor(g * 255 + 0.5), floor(b * 255 + 0.5))
            pcall(setClipboard, hex)
            debugLog("color copied", hex)
            return
        end
        for _, channel in ipairs(bounds.Channels or {}) do
            if RimuruUI.IsMouseOver(channel.X, channel.Y, channel.Width, channel.Height) then
                item.ColorDragging = channel.Name
                applyColorPickerPoint(item, channel.Name, channel.X, channel.Y, channel.Width, channel.Height)
                break
            end
        end
        if not inside and state.MousePressConsumed then
            item.Open = false
            item.ColorDragging = nil
            state.ColorPickerOpen = nil
        end
    elseif item.ColorDragging then
        if RimuruUI.IsDown("m1") then
            state.MousePressConsumed = true
            for _, channel in ipairs(bounds.Channels or {}) do
                if channel.Name == item.ColorDragging then
                    applyColorPickerPoint(item, channel.Name, channel.X, channel.Y, channel.Width, channel.Height)
                    break
                end
            end
        else
            item.ColorDragging = nil
        end
    end
end

local function renderKeybindBadge(item, bx, badgeY, badgeWidth, z, badgeHeight, textSize)
    badgeHeight = badgeHeight or 22
    textSize = textSize or 11
    local capturing = item.Capturing == true
    local valueLabel = keyLabel(item.Value or "None")
    local label = capturing and "..." or valueLabel
    local characterWidth = textSize == 10 and 5 or 6
    local labelWidth = #label * characterWidth
    local labelX = bx + math.max(2, math.floor((badgeWidth - labelWidth) / 2))
    local badgeHover = RimuruUI.IsMouseOver(bx, badgeY, badgeWidth, badgeHeight)
    paintRect(bx, badgeY, badgeWidth, badgeHeight,
        capturing and Theme.CardHover or badgeHover and Theme.CardHover or Theme.Panel,
        0.86, z, math.floor(badgeHeight / 3))
    paintRect(bx, badgeY, badgeWidth, badgeHeight,
        capturing and Theme.HoverText or Theme.Border,
        capturing and 0.86 or 0.72, z + 1, math.floor(badgeHeight / 3), false, 1)
    paintText(label, labelX,
        badgeY + math.floor((badgeHeight - textSize) / 2),
        capturing and Theme.Text or Theme.Muted, textSize, 1, z + 2)
    if RimuruUI.ConsumeMouseRightPress(bx, badgeY, badgeWidth, badgeHeight) then
        if state.KeybindModeItem == item then
            state.KeybindModeItem = nil
            debugLog("keybind menu close", item.Text or item.Value)
        else
            state.KeybindModeItem = item
            debugLog("keybind menu open", item.Text or item.Value)
        end
    end
    if state.KeybindModeItem == item then
        local modes = { "Always", "Toggle", "Hold", "Click" }
        local menuWidth, optionHeight = math.max(78, badgeWidth + 18), 19
        local menuHeight = #modes * optionHeight + 6
        local menuX, menuY = bx, badgeY + badgeHeight + 4
        local clipTop = state.ClipTop or -math.huge
        local clipBottom = state.ClipBottom or math.huge
        if menuY + menuHeight > clipBottom then
            menuY = badgeY - menuHeight - 4
        end
        if menuY < clipTop then menuY = clipTop end
        local visibleY = math.max(menuY, clipTop)
        local visibleBottom = math.min(menuY + menuHeight, clipBottom)
        local visibleHeight = visibleBottom - visibleY
        if visibleHeight > 0 then
            paintRect(menuX, visibleY, menuWidth, visibleHeight,
                Theme.Panel, 0.98, z + 20, 7)
            paintRect(menuX, visibleY, menuWidth, visibleHeight,
                Theme.BorderSoft, 0.84, z + 21, 7, false, 1)
        end
        for modeIndex = 1, #modes do
            local optionY = menuY + 3 + (modeIndex - 1) * optionHeight
            local modeName = modes[modeIndex]
            local active = lower(tostring(item.Mode or "toggle")) == lower(modeName)
            local optionBottom = optionY + optionHeight - 1
            if optionBottom > clipTop and optionY < clipBottom then
                local optionVisibleY = math.max(optionY, clipTop)
                local optionVisibleBottom = math.min(optionBottom, clipBottom)
                local optionVisibleHeight = optionVisibleBottom - optionVisibleY
                local hovered = RimuruUI.IsMouseOver(menuX + 3, optionVisibleY,
                    menuWidth - 6, optionVisibleHeight)
                local optionOpacity = viewportOpacity(optionY, optionHeight,
                    clipTop, clipBottom, 7)
                if hovered or active then
                    paintRect(menuX + 3, optionVisibleY, menuWidth - 6, optionVisibleHeight,
                        hovered and Theme.CardHover or Theme.Card, optionOpacity * 0.92, z + 22, 5)
                end
                paintText(modeName, menuX + 9, optionY + 4,
                    active and Theme.Text or (hovered and Theme.HoverText or Theme.Muted),
                    10, optionOpacity, z + 23)
                if RimuruUI.ConsumeMousePress(menuX + 3, optionY, menuWidth - 6, optionHeight - 1) then
                    item.Mode = lower(modeName)
                    state.KeybindModeItem = nil
                    debugLog("keybind mode", item.Text or item.Value, item.Mode)
                    if type(RimuruUI.MarkConfigDirty) == "function" then
                        RimuruUI.MarkConfigDirty(item.ParentItem or item)
                    end
                end
            end
        end
        item.ModePopupBounds = {
            X = menuX,
            Y = visibleY,
            Width = menuWidth,
            Height = math.max(0, visibleHeight),
            Options = {},
        }
        for modeIndex = 1, #modes do
            local optionY = menuY + 3 + (modeIndex - 1) * optionHeight
            local optionBottom = optionY + optionHeight - 1
            local optionVisibleY = math.max(optionY, clipTop)
            local optionVisibleBottom = math.min(optionBottom, clipBottom)
            if optionVisibleBottom > optionVisibleY then
                item.ModePopupBounds.Options[#item.ModePopupBounds.Options + 1] = {
                    Name = modes[modeIndex],
                    X = menuX + 3,
                    Y = optionVisibleY,
                    Width = menuWidth - 6,
                    Height = optionVisibleBottom - optionVisibleY,
                }
            end
        end
    else
        item.ModePopupBounds = nil
    end
    if RimuruUI.ConsumeMousePress(bx, badgeY, badgeWidth, badgeHeight) then
        item.Capturing = true
        state.KeybindModeItem = nil
        debugLog("keybind capture", item.Text or item.Value)
        RimuruUI.CaptureKey({}, function(key)
            item.Value = key or "None"
            item.Capturing = false
            invoke(item.Callback, item.Value, item)
        end)
        return true
    end
    return false
end

