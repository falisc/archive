local function host(name, fallback)
    local value = runtimeEnvironment and runtimeEnvironment[name]
    if type(value) ~= "function" then value = _G[name] end
    return type(value) == "function" and value or fallback
end

local function clock()
    return (type(tick) == "function" and tick()) or os.clock()
end

local function clamp(value, minimum, maximum)
    if value < minimum then return minimum end
    if value > maximum then return maximum end
    return value
end

local function keyLabel(name)
    local aliases = {
        rshift = "Right Shift", lshift = "Left Shift", shift = "Shift",
        rctrl = "Right Ctrl", lctrl = "Left Ctrl", ctrl = "Ctrl",
        esc = "Escape", m1 = "Mouse 1", m2 = "Mouse 2",
    }
    name = lower(tostring(name or ""))
    return aliases[name] or name:gsub("^%l", string.upper)
end

local function approach(value, target, speed)
    return value + (target - value) * math.min(1, ((RimuruUI.State and RimuruUI.State.DeltaTime) or 1 / 60) * speed)
end

local function colourMix(first, second, amount)
    amount = math.max(0, math.min(1, amount or 0))
    if first and second and Color3 and Color3.new then
        local ok, r1, g1, b1 = pcall(function() return first.R, first.G, first.B end)
        local ok2, r2, g2, b2 = pcall(function() return second.R, second.G, second.B end)
        if ok and ok2 then
            return Color3.new(
                r1 + (r2 - r1) * amount,
                g1 + (g2 - g1) * amount,
                b1 + (b2 - b1) * amount
            )
        end
    end
    return amount >= 0.5 and second or first
end

local function isBanned(list, name)
    if type(list) ~= "table" then return false end
    if list[name] then return true end
    for i = 1, #list do
        if lower(tostring(list[i])) == name then return true end
    end
    return false
end

