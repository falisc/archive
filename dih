local function updateOverlayDrag(window, kind, x, y, width, height)
    local screenWidth, screenHeight = viewport()
    local drag = window.OverlayDrag
    if drag and drag.Kind == kind then
        if not RimuruUI.IsDown("m1") then
            window.OverlayDrag = nil
        else
            x = clamp(state.MouseX - drag.OffsetX, 4, math.max(4, screenWidth - width - 4))
            y = clamp(state.MouseY - drag.OffsetY, 4, math.max(4, screenHeight - height - 4))
        end
    elseif not drag and Keys.m1.Pressed and RimuruUI.IsMouseOver(x, y, width, height) then
        state.MousePressConsumed = true
        window.OverlayDrag = {
            Kind = kind,
            OffsetX = state.MouseX - x,
            OffsetY = state.MouseY - y,
        }
    end
    if kind == "watermark" then
        window.WatermarkX, window.WatermarkY = x, y
    else
        window.KeybindOverlayX, window.KeybindOverlayY = x, y
    end
    return x, y
end

