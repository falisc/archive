local function fitTextSize(value, size, maximumWidth)
    local estimate = #tostring(value) * size * 0.53
    if estimate <= maximumWidth then return size end
    return math.max(7, size * maximumWidth / estimate)
end

local function ellipsize(value, size, maximumWidth)
    value = tostring(value or "")
    if #value * size * 0.53 <= maximumWidth then return value end
    local characters = math.max(1, floor(maximumWidth / (size * 0.53)) - 3)
    return sub(value, 1, characters) .. "..."
end

local function normalizeLabelText(value)
    return tostring(value or ""):gsub("\\n", "\n")
end

local function labelLines(value, size, maximumWidth)
    local lines = {}
    value = normalizeLabelText(value)
    local maximumCharacters = maximumWidth and math.max(1,
        floor(maximumWidth / ((size or 11) * 0.53))) or nil
    for line in (value .. "\n"):gmatch("(.-)\n") do
        if maximumCharacters then
            local remaining = line
            while #remaining > maximumCharacters do
                local chunk = sub(remaining, 1, maximumCharacters)
                local splitAt = chunk:match("^.*()%s+")
                if not splitAt or splitAt < 2 then splitAt = maximumCharacters end
                lines[#lines + 1] = sub(remaining, 1, splitAt):gsub("%s+$", "")
                remaining = sub(remaining, splitAt + 1):gsub("^%s+", "")
            end
            lines[#lines + 1] = remaining
        else
            lines[#lines + 1] = line
        end
    end
    if #lines == 0 then lines[1] = "" end
    return lines
end

local function labelHeight(value, maximumWidth)
    return math.max(30, #labelLines(value, 11, maximumWidth) * 15 + 10)
end

