function Section:Add(item)
    item.Section = self
    item.Window = self.Tab.Window or (self.Tab.Category and self.Tab.Category.Window)
    local tabName = tostring(self.Tab.Name or "Tab")
    local baseKey = tabName .. "/" .. tostring(self.Title or "Section") .. "/" ..
        tostring(item.Text or item.Type or (#self.Items + 1))
    local duplicate = 0
    for index = 1, #self.Items do
        if self.Items[index].ConfigBaseKey == baseKey then duplicate = duplicate + 1 end
    end
    item.ConfigBaseKey = baseKey
    item.ConfigKey = tostring(item.Flag or (duplicate > 0 and (baseKey .. "#" .. (duplicate + 1)) or baseKey))
    if item.Keybind then
        item.Keybind.Window = item.Window
        item.Keybind.ParentItem = item
    end
    if item.ColorPicker then
        item.ColorPicker.Window = item.Window
        item.ColorPicker.ParentItem = item
        item.ColorPicker.SetAlpha = function(widget, alpha, silent)
            widget.Alpha = clamp(tonumber(alpha) or widget.Alpha or 1, 0, 1)
            if not silent and type(widget.Callback) == "function" then
                pcall(widget.Callback, widget.Value, widget)
            end
            if not silent and type(RimuruUI.MarkConfigDirty) == "function" then
                RimuruUI.MarkConfigDirty(item)
            end
            return widget.Alpha
        end
        item.ColorPicker.SetTransparency = function(widget, transparency, silent)
            transparency = tonumber(transparency) or 0
            if transparency > 1 then transparency = transparency / 100 end
            return widget:SetAlpha(1 - clamp(transparency, 0, 1), silent)
        end
        item.ColorPicker.GetTransparency = function(widget)
            return (1 - clamp(widget.Alpha or 1, 0, 1)) * 100
        end
    end
    item.SetValue = item.SetValue or function(widget, value, silent)
        return RimuruUI.SetWidgetValue(widget, value, silent)
    end
    item.GetValue = item.GetValue or function(widget)
        return RimuruUI.GetWidgetValue(widget)
    end
    item.Refresh = item.Refresh or item.SetValue
    item.SetText = item.SetText or function(widget, value)
        widget.Text = widget.Type == "label" and normalizeLabelText(value) or tostring(value or "")
        if widget.Type == "label" and not widget.FixedHeight then
            widget.Height = labelHeight(widget.Text)
        end
        return widget.Text
    end
    if item.Type == "dropdown" then
        item.SetOptions = function(widget, options, defaultValue, silent)
            widget.Options = type(options) == "table" and options or {}
            widget.DropdownScroll, widget.DropdownQuery, widget.Open = 0, "", false
            if defaultValue ~= nil then RimuruUI.SetWidgetValue(widget, defaultValue, silent) end
            return widget.Options
        end
        item.RefreshOptions = item.SetOptions
    elseif item.Type == "colorpicker" then
        item.SetAlpha = function(widget, alpha, silent)
            widget.Alpha = clamp(tonumber(alpha) or widget.Alpha or 1, 0, 1)
            if not silent and type(widget.Callback) == "function" then
                pcall(widget.Callback, widget.Value, widget)
            end
            if not silent and type(RimuruUI.MarkConfigDirty) == "function" then
                RimuruUI.MarkConfigDirty(widget)
            end
            return widget.Alpha
        end
        item.SetTransparency = function(widget, transparency, silent)
            transparency = tonumber(transparency) or 0
            if transparency > 1 then transparency = transparency / 100 end
            return widget:SetAlpha(1 - clamp(transparency, 0, 1), silent)
        end
        item.GetTransparency = function(widget)
            return (1 - clamp(widget.Alpha or 1, 0, 1)) * 100
        end
    end
    self.Items[#self.Items + 1] = item
    debugLog("widget create", item.Type or "unknown", item.Text or "")
    return item
end

function Section:Find(text)
    local query = lower(tostring(text or ""))
    for i = 1, #self.Items do
        if lower(tostring(self.Items[i].Text or "")) == query then return self.Items[i] end
    end
end

function Section:SetValue(text, value, silent)
    local item = self:Find(text)
    return item and item:SetValue(value, silent) or nil
end

function Section:GetValue(text)
    local item = self:Find(text)
    return item and item:GetValue() or nil
end

function Section:GetHeight(defaultHeight, matcher)
    local contentHeight = 0
    for i = 1, #self.Items do
        local item = self.Items[i]
        if type(item) == "table" and (not matcher or matcher(item)) then
            contentHeight = contentHeight + (item.Height or 28)
        end
    end
    local hasItems = contentHeight > 0
    local calculated = hasItems and (contentHeight + 8) or (defaultHeight or 64)
    local fullHeight = math.max(self.Height or 0, calculated)
    if self.CollapseProgress ~= nil then
        return fullHeight * (1 - self.CollapseProgress)
    end
    return self.Collapsed and 0 or fullHeight
end

