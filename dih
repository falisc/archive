function RimuruUI.MarkConfigDirty(item)
    if type(item) == "table" and item.NoConfig then return end
    local window = type(item) == "table" and item.Window or nil
    local config = window and window.Config or nil
    if not config or not config.AutoSave or window.ConfigLoading then return end
    config.DirtyVersion = config.DirtyVersion + 1
    config.SaveDue = clock() + 0.35
end

function Section:PrepareLabels(width, matcher)
    for i = 1, #self.Items do
        local item = self.Items[i]
        if type(item) == "table" and item.Type == "label" and
            (not matcher or matcher(item)) then
            item.WrappedLines = labelLines(item.Text, 11, width)
            if not item.FixedHeight then
                item.Height = math.max(30, #item.WrappedLines * 15 + 10)
            end
        end
    end
end

