function Window:AddChangelog(title, description, date)
    local entry
    if type(title) == "table" then
        entry = {
            Title = tostring(title.Title or title.Name or "Update"),
            Description = tostring(title.Description or title.Text or ""),
            Date = tostring(title.Date or ""),
        }
    else
        entry = {
            Title = tostring(title or "Update"),
            Description = tostring(description or ""),
            Date = tostring(date or ""),
        }
    end
    self.Changelogs = self.Changelogs or {}
    self.Changelogs[#self.Changelogs + 1] = entry
    debugLog("changelog create", entry.Title)
    return entry
end

function Window:SetChangelog(entries)
    self.Changelogs = {}
    self.ChangelogScroll = 0
    for index = 1, #(type(entries) == "table" and entries or {}) do
        local source = entries[index]
        if type(source) == "table" then
            self.Changelogs[#self.Changelogs + 1] = {
                Title = tostring(source.Title or source.Name or "Update"),
                Description = tostring(source.Description or source.Text or ""),
                Date = tostring(source.Date or ""),
            }
        end
    end
    debugLog("changelog set", #self.Changelogs)
    return self.Changelogs
end

function Window:ClearChangelogs()
    self.Changelogs = {}
    return self
end

function Window:SetVisible(visible)
    if visible == true then
        self.Visible = true
        self.Closing = false
        self.Hidden = false
        self.AlphaTarget = 1
        if (self.RenderAlpha or 0) <= 0.02 then self.RenderAlpha = 0 end
    else
        self.Visible = true
        self.Closing = false
        self.Hidden = true
        self.AlphaTarget = 0
    end
    return self
end

function Window:Toggle()
    if self.Visible and not self.Hidden and (self.AlphaTarget or 1) > 0 then
        self:SetVisible(false)
    else
        self:SetVisible(true)
    end
    return self.Visible and not self.Closing
end

function Window:Minimize(value)
    local minimized = value == nil and (self.MinimizeTarget or 0) < 0.5 or value == true
    self.Minimized = minimized
    self.MinimizeTarget = minimized and 1 or 0
    return self.Minimized
end

function Window:Close()
    self.Visible = true
    self.Hidden = false
    self.Closing = true
    self.AlphaTarget = 0
end

function Window:SetPosition(x, y)
    self.X, self.Y = x, y
    return self
end

function Window:SetSize(width, height)
    self.Width, self.Height = width, height
    return self
end

function Window:Destroy()
    self.Removed = true
    self.Visible = false
    self.Closing = false
    for i = #Windows, 1, -1 do
        if Windows[i] == self then table.remove(Windows, i) break end
    end
end

local function keybindEntries(window)
    local entries = {
        {
            Name = "Menu", Key = keyLabel(window.ToggleKey), Mode = "Toggle",
            Active = window.Visible and not window.Hidden,
        },
    }
    local function visit(tab)
        for sectionIndex = 1, #(tab.Sections or {}) do
            local section = tab.Sections[sectionIndex]
            for itemIndex = 1, #section.Items do
                local item = section.Items[itemIndex]
                local bind = item.Keybind or (item.Type == "keybind" and item)
                if bind and bind.Value and lower(tostring(bind.Value)) ~= "none" then
                    local mode = lower(tostring(bind.Mode or "toggle"))
                    local hiddenHold = mode == "hold" and item.Type == "toggle" and item.Value ~= true
                    if not hiddenHold then
                        local key = Keys[lower(tostring(bind.Value))]
                        local active
                        if mode == "always" then
                            active = true
                        elseif mode == "hold" or mode == "click" then
                            active = key ~= nil and key.Down == true
                        elseif item.Type == "toggle" then
                            active = item.Value == true
                        else
                            active = item.Active == true
                        end
                        entries[#entries + 1] = {
                            Name = tostring(item.Text or "Keybind"),
                            Key = keyLabel(bind.Value),
                            Mode = mode:gsub("^%l", string.upper),
                            Active = active == true,
                        }
                    end
                end
            end
        end
    end
    for categoryIndex = 1, #window.Categories do
        local category = window.Categories[categoryIndex]
        for tabIndex = 1, #category.Tabs do visit(category.Tabs[tabIndex]) end
    end
    return entries
end

local function pcTimeLabel()
