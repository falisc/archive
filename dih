            window.GlassEnabled and 0.94 or 0.99, z, 8)
        paintRect(x, y, width, height, Theme.Border, 0.92, z + 1, 8, false, 1.4)
        paintRect(x + 2, y + 2, width - 4, height - 4, Theme.BorderSoft, 0.76,
            z + 2, 6, false, 1)
        paintIcon("keyboard", x + 15, y + 15, Theme.HoverText, z + 3, 0.92)
        paintText("Keybinds", x + 29, y + 9, Theme.Text, 11, 1, z + 3)
        paintLine(x + 10, y + 29, x + width - 10, y + 29, Theme.BorderSoft, 0.74, z + 3, 1)
        for index = 1, visibleCount do
            local entry = entries[index]
            local rowY = y + 34 + (index - 1) * 22
            local textColour = entry.Active and Theme.Text or Theme.Muted
            local keyColour = entry.Active and Theme.HoverText or Theme.Dim
            paintText(ellipsize(entry.Name, 10, 102), x + 11, rowY + 3,
