function RimuruUI.RegisterTheme(name, values)
    assert(type(name) == "string" and name ~= "", "theme name is required")
    assert(type(values) == "table", "theme values must be a table")
    local merged = copyTheme(Theme)
    for slot, colour in pairs(values) do
        if merged[slot] ~= nil then merged[slot] = colour end
    end
    RimuruUI.Themes[name] = merged
    RimuruUI.ThemeModes[name] = { Image = false, Glass = false }
    return merged
end

function RimuruUI.GetThemes()
    local names = {}
    for name in pairs(RimuruUI.Themes) do names[#names + 1] = name end
    table.sort(names)
    return names
end

function RimuruUI.ApplyTheme(name, window)
    local values = RimuruUI.Themes[tostring(name or "")]
    if not values then return false end
    RimuruUI.SetTheme(values)
    if window then
        local mode = RimuruUI.ThemeModes[tostring(name)] or {}
        window.ThemeName = tostring(name)
        window.BackgroundEnabled = mode.Image == true
        window.GlassEnabled = mode.Glass == true
    end
    debugLog("theme applied", name)
    return true
end

