local function renderTransparency(value)
    local alpha = (RimuruUI.State and RimuruUI.State.RenderAlpha) or 1
    local localAlpha = (RimuruUI.State and RimuruUI.State.LocalAlpha) or 1
    return (value or 1) * alpha * localAlpha
end

local function viewportOpacity(position, size, top, bottom, fadeSize)
    if position + size <= top or position >= bottom then return 0 end
    local opacity = 1
    if position < top then
        opacity = math.min(opacity, (position + size - top) / fadeSize)
    end
    if position + size > bottom - fadeSize then
        opacity = math.min(opacity, (bottom - position - size + fadeSize) / fadeSize)
    end
    return math.max(0, math.min(1, opacity))
end

local function paintRect(x, y, width, height, colour, transparency, z, radius, filled, thickness)
