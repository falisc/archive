function RimuruUI.EditText(editor, allowed, maximum)
    assert(type(editor) == "table", "editor must be a table")
    local value = tostring(editor.Value or "")
    editor.Cursor = clamp(editor.Cursor or #value, 0, #value)
    local cursor = editor.Cursor
    local changed = false

    if RimuruUI.IsCtrlDown() and Keys.a.Pressed then
        editor.SelectionStart, cursor = 0, #value
        Keys.a.Pressed = false
    elseif RimuruUI.IsCtrlDown() and Keys.v.Pressed then
        local paste = ""
        if getClipboard then
            local ok, result = pcall(getClipboard)
            if ok and type(result) == "string" then paste = result end
        end
        paste = paste:gsub("[\r\n]", "")
        if allowed then paste = paste:gsub("[^" .. allowed .. "]", "") end
        if maximum then paste = sub(paste, 1, maximum - #value) end
        value, cursor, changed = insertText(value, cursor, paste), cursor + #paste, paste ~= ""
        Keys.v.Pressed = false
    end

    if Keys.backspace.Pressed and cursor > 0 then
        value = sub(value, 1, cursor - 1) .. sub(value, cursor + 1)
        cursor, changed = cursor - 1, true
        Keys.backspace.Pressed = false
    elseif Keys.delete.Pressed and cursor < #value then
        value, changed = sub(value, 1, cursor) .. sub(value, cursor + 2), true
        Keys.delete.Pressed = false
    end

    if Keys.left.Pressed then cursor = math.max(0, cursor - 1); Keys.left.Pressed = false end
    if Keys.right.Pressed then cursor = math.min(#value, cursor + 1); Keys.right.Pressed = false end
    if Keys.home.Pressed then cursor = 0; Keys.home.Pressed = false end
    if Keys["end"].Pressed then cursor = #value; Keys["end"].Pressed = false end

    for i = 1, #Order do
        local key = Keys[Order[i]]
        if key.Character and key.Pressed then
            local character = (RimuruUI.IsShiftDown() and key.Shifted) or key.Character
            if (not allowed or character:find("[" .. allowed .. "]")) and (not maximum or #value < maximum) then
                value, cursor, changed = insertText(value, cursor, character), cursor + #character, true
            end
            key.Pressed = false
        end
    end

    editor.Value, editor.Cursor = value, cursor
    return value, changed
end




