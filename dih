    end
end

function RimuruUI.Notify(config, description, duration)
    if type(config) ~= "table" then
        config = { Title = tostring(config or "Notification"), Description = description, Duration = duration }
    end
    RimuruUI.NotificationSequence = RimuruUI.NotificationSequence + 1
    local now = clock()
    local notification = {
        Id = RimuruUI.NotificationSequence,
        Title = tostring(config.Title or config.Name or "Notification"),
        Description = tostring(config.Description or config.Text or ""),
        Type = lower(tostring(config.Type or "info")),
        Duration = math.max(0.8, tonumber(config.Duration or duration) or 4),
        Created = now,
        Deadline = now + math.max(0.8, tonumber(config.Duration or duration) or 4),
        Alpha = 0,
        Slide = 54,
        Closing = false,
    }
    local notifications = RimuruUI.Notifications
    notifications[#notifications + 1] = notification
    if #notifications > 7 then notifications[1].Closing = true end
    debugLog("notification", notification.Type, notification.Title)
    return notification
end

function RimuruUI.DismissNotification(notification)
    local id = type(notification) == "table" and notification.Id or notification
    for _, entry in ipairs(RimuruUI.Notifications) do
        if entry == notification or entry.Id == id then
            entry.Closing = true
            return true
        end
    end
    return false
end

function RimuruUI.RenderNotifications()
    local notifications = RimuruUI.Notifications
    local now = clock()
    local screenWidth = viewport()
    local width, height, gap, margin = 300, 68, 8, 14
    local y = margin
    local z = 700
    local icons = { success = "circlecheck", warning = "trianglealert", error = "circlex", info = "info" }
    for index = #notifications, 1, -1 do
        local notification = notifications[index]
        if not notification.Closing and now >= notification.Deadline then notification.Closing = true end
        notification.Alpha = approach(notification.Alpha or 0, notification.Closing and 0 or 1, 18)
        notification.Slide = approach(notification.Slide or 54, notification.Closing and 54 or 0, 20)
        if notification.Closing and notification.Alpha <= 0.02 then
            table.remove(notifications, index)
        else
            local x = screenWidth - width - margin + notification.Slide
            if RimuruUI.IsMouseOver(x, y, width, height) and not notification.Closing then
                notification.Deadline = notification.Deadline + (state.DeltaTime or 0)
                if RimuruUI.ConsumeMousePress(x, y, width, height) then notification.Closing = true end
            end
            local previousLocalAlpha = state.LocalAlpha
            state.LocalAlpha = (previousLocalAlpha or 1) * notification.Alpha
            paintRect(x, y, width, height, Theme.Background, 0.98, z, 9)
            paintRect(x, y, width, height, Theme.Border, 0.96, z + 1, 9, false, 1.6)
            paintRect(x + 2, y + 2, width - 4, height - 4, Theme.BorderSoft, 0.82,
                z + 2, 7, false, 1)
            paintIcon(icons[notification.Type] or "info", x + 19, y + 22,
                notification.Type == "success" and Theme.Accent or Theme.HoverText, z + 3, 1)
            paintText(ellipsize(notification.Title, 12, width - 56), x + 36, y + 10,
                Theme.Text, 12, 1, z + 3)
            paintText(ellipsize(notification.Description, 10, width - 52), x + 36, y + 35,
                Theme.Muted, 10, 1, z + 3)
            local progress = notification.Closing and 0 or
                clamp((notification.Deadline - now) / notification.Duration, 0, 1)
            paintRect(x + 8, y + height - 5, width - 16, 2, Theme.BorderSoft, 0.9, z + 3, 1)
            paintRect(x + 8, y + height - 5, (width - 16) * progress, 2,
                Theme.HoverText, 0.9, z + 4, 1)
            state.LocalAlpha = previousLocalAlpha
            y = y + height + gap
        end
    end
end

function Window:RenderLoader()
    if not self.Loading or self.Removed then return end
    local now = clock()
    local elapsed = now - (self.LoadingStarted or now)
    local rawProgress = clamp(elapsed / math.max(0.8, self.LoadingDuration or 1.65), 0, 1)
    self.LoadingProgress = approach(self.LoadingProgress or 0, rawProgress, 9)
    self.LoadingAlpha = approach(self.LoadingAlpha or 0, self.LoadingClosing and 0 or 1, 17)

    if rawProgress >= 1 and not self.LoadingInitialized and self.LoadingAlpha >= 0.90 then
        self.LoadingInitialized = true
        if self.Config and type(self.Config.Initialize) == "function" then
            local ok, message = pcall(function() self.Config:Initialize() end)
            if not ok then debugLog("config initialize failed", message) end
        end
        self.LoadingReadyAt = now
    elseif self.LoadingInitialized and not self.LoadingClosing and
        now - (self.LoadingReadyAt or now) >= 0.20 then
        self.LoadingClosing = true
    end

    if self.LoadingClosing and self.LoadingAlpha <= 0.025 then
        self.Loading = false
        self.LoadingClosing = false
        self:Finalize()
        self.RenderAlpha = 0
        self.AlphaTarget = self.Visible and 1 or 0
        debugLog("loader complete", self.Title)
        return
    end

    local screenWidth, screenHeight = viewport()
    local panelWidth, panelHeight = 350, 126
    local x = floor((screenWidth - panelWidth) / 2)
    local y = floor((screenHeight - panelHeight) / 2)
    local z = 1000
    local previousRenderAlpha = state.RenderAlpha
    local previousLocalAlpha = state.LocalAlpha
    state.RenderAlpha = self.LoadingAlpha
    state.LocalAlpha = 1

    paintRect(x - 2, y - 2, panelWidth + 4, panelHeight + 4,
        Theme.Border, 0.92, z, 13, false, 3)
    paintRect(x - 1, y - 1, panelWidth + 2, panelHeight + 2,
        Theme.BorderSoft, 0.90, z + 1, 12, false, 2)
    paintRect(x, y, panelWidth, panelHeight, Theme.Background, 0.985, z + 2, 11)
    paintRect(x + 2, y + 2, panelWidth - 4, panelHeight - 4,
        Theme.Panel, 0.62, z + 3, 9)

    local logoX, logoY, logoSize = x + 18, y + 18, 46
    paintRect(logoX, logoY, logoSize, logoSize, Theme.Card, 1, z + 4, 11)
    if self.LogoData then
        paintStableImage(self.StableImagePrefix .. ":loader", self.LogoData,
            logoX, logoY, logoSize, 11, 1, z + 5)
    else
        paintIcon("home", logoX + logoSize / 2, logoY + logoSize / 2,
            Theme.Text, z + 5, 1)
    end
    paintRect(logoX, logoY, logoSize, logoSize, Theme.Border,
        0.82, z + 6, 11, false, 1)

    paintText("RIMURU INTERFACE", x + 78, y + 17, Theme.Dim, 9, 1, z + 5)
    paintText(self.Title, x + 78, y + 34, Theme.Text, 15, 1, z + 5)
    local stages = {
        { 0.28, "Preparing renderer" },
        { 0.58, "Building interface" },
        { 0.88, "Restoring configuration" },
        { 1.01, "Ready" },
    }
    local status = stages[#stages][2]
    for index = 1, #stages do
        if rawProgress < stages[index][1] then status = stages[index][2] break end
    end
    local dotCount = rawProgress >= 1 and 0 or (floor(now * 3) % 3 + 1)
    paintText(status .. string.rep(".", dotCount), x + 78, y + 56,
        Theme.Muted, 10, 1, z + 5)

    local progressX, progressY, progressWidth = x + 18, y + 91, panelWidth - 36
    local shownProgress = clamp(self.LoadingProgress or 0, 0, 1)
    paintText("LOADING", progressX, y + 76, Theme.Dim, 9, 1, z + 5)
    local percentage = tostring(floor(shownProgress * 100 + 0.5)) .. "%"
    paintText(percentage, progressX + progressWidth - #percentage * 4.8,
        y + 76, Theme.HoverText, 9, 1, z + 5)
    paintRect(progressX, progressY, progressWidth, 8, Theme.BorderSoft, 1, z + 5, 4)
    if shownProgress > 0 then
        paintRect(progressX, progressY, math.max(4, progressWidth * shownProgress), 8,
            Theme.HoverText, 0.94, z + 6, 4)
    end
    paintRect(progressX, progressY, progressWidth, 8, Theme.Border,
        0.72, z + 7, 4, false, 1)

    state.RenderAlpha = previousRenderAlpha
    state.LocalAlpha = previousLocalAlpha
end

function RimuruUI.Render()
    if not lifecycleToken.Alive or not DrawingAvailable then return end
    local now = clock()
    for index = 1, #Windows do
        local config = Windows[index].Config
        if config and config.AutoSave and config.SaveDue and now >= config.SaveDue then
            config.SaveDue = nil
            local ok, message = config:Save(config.Name)
            if not ok then debugLog("auto save failed", message) end
        end
    end
    processKeybindModeModal()
    processColorPickerModal()
    if state.KeybindModeItem and Keys.m1.Pressed and not state.MousePressConsumed then


        state.KeybindModeItem.ModePopupBounds = nil
        state.KeybindModeItem = nil
    end


    local mainWindow = RimuruUI.MainWindow
    if mainWindow and mainWindow.Loading then
        mainWindow:RenderLoader()
    else
        RimuruUI.RenderOverlays()
        for i = 1, #Windows do Windows[i]:Render() end
        RimuruUI.RenderNotifications()
    end
    hidePrimitives()
end

function RimuruUI.SetTheme(values)
    assert(type(values) == "table", "theme must be a table")
    for name, colour in pairs(values) do
        if Theme[name] ~= nil then Theme[name] = colour end
    end
    return Theme
end

local function copyTheme(values)
    local copied = {}
    for name, colour in pairs(values) do copied[name] = colour end
    return copied
end

