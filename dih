function RimuruUI.Start()
    if state.Running then return end
    if not task or type(task.spawn) ~= "function" then
        error("RimuruUI.Start requires task.spawn; call RimuruUI.Step manually instead")
    end
    if not state.HasStarted then
        for index = 1, #Windows do
            local window = Windows[index]
            window.ActiveTab = window.HomeTab
            window.TabScroll = 0
            window.ContentScroll = 0
        end
        state.HasStarted = true
    end
    state.Running = true
    debugLog("render loop start", state.Generation)
    task.spawn(function()
        while state.Running and runtimeEnvironment.RimuruUIGeneration == state.Generation and
            runtimeEnvironment.RimuruUIInstance == RimuruUI do
            RimuruUI.Step()
            if task.wait then task.wait() elseif wait then wait() else break end
        end
    end)
end

function RimuruUI.Stop()
    state.Running = false
    state.Capture = nil
    for i = #state.Binds, 1, -1 do table.remove(state.Binds, i) end
    setGameInput(true)
end

function RimuruUI.Destroy()
    RimuruUI.Stop()
    for i = #Windows, 1, -1 do
        Windows[i]:Destroy()
    end
    removePrimitives()
    RimuruUI.MainWindow = nil
    if runtimeEnvironment.RimuruUIInstance == RimuruUI then
        runtimeEnvironment.RimuruUIInstance = nil
    end
end

