RimuruUI.State = state

local mouse, wheelValue, lastTime = nil, 0, nil

pcall(function()
    local input = game:GetService("UserInputService")
    input.InputChanged:Connect(function(object)
        if object.UserInputType == Enum.UserInputType.MouseWheel then
            wheelValue = object.Position.Z
        end
    end)
end)

local function clearEdges()
    for i = 1, #Order do
        local key = Keys[Order[i]]
        key.Pressed, key.Released = false, false
    end
end

local function sample(name, down)
    local key = Keys[name]
    key.Pressed = down and not key.Down
    key.Released = not down and key.Down
    key.Down = down
end

local function pollKeyboard()
    local focused = state.Focused
    for i = 1, #Order do
        local name = Order[i]
        local key = Keys[name]
        if name ~= "m1" and name ~= "m2" then
            local down
            if key.Id > 0xFF then
                down = (key.Id == 0x101 and state.Wheel > 0) or
                    (key.Id == 0x102 and state.Wheel < 0)
            else
                down = focused and keyDown(key.Id) == true or false
            end
            sample(name, down)
        end
    end
end

function RimuruUI.Step()
    if not lifecycleToken.Alive or
        runtimeEnvironment.RimuruUIGeneration ~= state.Generation or
        runtimeEnvironment.RimuruUIActiveGeneration ~= state.Generation or
        runtimeEnvironment.RimuruUIInstance ~= RimuruUI then
        state.Running = false
        return state
    end
    local current = clock()
    state.DeltaTime = clamp(current - (lastTime or current), 1 / 1000, 1 / 15)
    lastTime = current
    state.Frame = state.Frame + 1
    state.Wheel, wheelValue = wheelValue, 0
    clearEdges()

    state.Focused = isFocused() ~= false
    if not mouse then
        pcall(function() mouse = game:GetService("Players").LocalPlayer:GetMouse() end)
    end
    if mouse then
        state.HasMouse = pcall(function()
            state.MouseX, state.MouseY = mouse.X, mouse.Y
        end)
    end


    sample("m1", mouse1Down() == true)
    sample("m2", mouse2Down() == true)
    if not state.InputArmed then


        Keys.m1.Pressed, Keys.m1.Released = false, false
        Keys.m2.Pressed, Keys.m2.Released = false, false
        if not Keys.m1.Down and not Keys.m2.Down then state.InputArmed = true end
    end
    pollKeyboard()
    state.MousePressConsumed, state.MouseRightConsumed = false, false
    RimuruUI.ProcessBinds()
    RimuruUI.ProcessCapture()
    RimuruUI.ProcessWidgetKeybinds()
    local mainWindow = RimuruUI.MainWindow
    if mainWindow and not mainWindow.Loading then
        if RimuruUI.WasPressed(mainWindow.ToggleKey) then mainWindow:Toggle() end
    end
    RimuruUI.Render()
    return state
end

function RimuruUI.ProcessWidgetKeybinds()
    local windows = RimuruUI.Windows or {}
    for windowIndex = 1, #windows do
        local window = windows[windowIndex]
        if window.Visible and not window.Hidden then
            for categoryIndex = 1, #window.Categories do
                local category = window.Categories[categoryIndex]
                for tabIndex = 1, #category.Tabs do
                    local tab = category.Tabs[tabIndex]
                    for sectionIndex = 1, #tab.Sections do
                        local section = tab.Sections[sectionIndex]
                        for itemIndex = 1, #section.Items do
                            local item = section.Items[itemIndex]
                            local bind = item.Keybind or (item.Type == "keybind" and item)
                            if bind and bind.Value and bind.Value ~= "None" then
                                local keyName = lower(tostring(bind.Value))
                                local key = Keys[keyName]
                                local mode = lower(tostring(bind.Mode or "toggle"))
                                local active = item.Type == "toggle" and item.Value or item.Active == true
                                local function emit(value)
                                    if item.Type == "toggle" then item.Value = value else item.Active = value end
                                    if type(item.Callback) == "function" then
                                        pcall(item.Callback, value, item)
                                    end
                                    if type(RimuruUI.MarkConfigDirty) == "function" then
                                        RimuruUI.MarkConfigDirty(item)
                                    end
                                end
                                local function emitInput(value)
                                    item.KeybindActive = value == true
                                    local callback = item.KeybindCallback or
                                        (item.Keybind and item.Keybind.Callback)
                                    if type(callback) == "function" then
                                        pcall(callback, item.KeybindActive, item)
                                    elseif item.Type ~= "toggle" and type(item.Callback) == "function" then
                                        pcall(item.Callback, item.KeybindActive, item)
                                    end
                                end
                                if mode == "always" then
                                    if not active then
                                        emit(true)
                                        debugLog("keybind always", item.Text)
                                    end
                                elseif key and mode == "hold" then
                                    local nextInput = item.Type ~= "toggle" and key.Down or
                                        (item.Value == true and key.Down or false)
                                    if item.KeybindActive ~= nextInput then
                                        emitInput(nextInput)
                                        debugLog("keybind hold", item.Text, key.Down)
                                    end
                                elseif key and mode == "click" then
                                    if key.Pressed then
                                        emit(true)
                                        debugLog("keybind click", item.Text, true)
                                    elseif key.Released then
                                        emit(false)
                                        debugLog("keybind click", item.Text, false)
                                    end
                                elseif key and key.Pressed and mode == "toggle" then
                                    emit(not active)
                                    debugLog("keybind toggle", item.Text)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

function RimuruUI.GetState()
    return state
end

function RimuruUI.SetWidgetValue(item, value, silent)
    assert(type(item) == "table", "widget must be a table")
    if item.Type == "toggle" then
        item.Value = value == true
    elseif item.Type == "slider" then
        item.Value = clamp(tonumber(value) or item.Min, item.Min, item.Max)
    elseif item.Type == "dropdown" then
        item.Value = item.Multi and (type(value) == "table" and value or {}) or value
        item.Open, item.DropdownScroll, item.DropdownQuery = false, 0, ""
    elseif item.Type == "colorpicker" then
        item.Value, item.HsvReady = value, false
    elseif item.Type == "keybind" then
        item.Value = lower(tostring(value or "None"))
    else
        item.Value = value
    end
    if not silent and type(item.Callback) == "function" then pcall(item.Callback, item.Value, item) end
    if not silent and type(RimuruUI.MarkConfigDirty) == "function" then
        RimuruUI.MarkConfigDirty(item)
    end
    return item.Value
end

