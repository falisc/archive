function RimuruUI.CreateWindow(config)
    config = config or {}
    local screenWidth, screenHeight = viewport()
    local size = config.Size or {}
    local width = size[1] or config.Width or 680
    local height = size[2] or config.Height or 460
    local logoSpace = config.LogoSpace or 42
    local windowTitle = tostring(config.Title or "RimuruUI")
    local subtitle = tostring(config.Subtitle or detectGameName())
    local sidebar = config.SidebarWidth or 164
    local toggleKey = lower(tostring(config.ToggleKey or "comma"))
    local subtitleWidth = #subtitle * 10 * 0.53
    local requiredSidebar = logoSpace + 30 + subtitleWidth + 8
    if sidebar < requiredSidebar then sidebar = requiredSidebar end
    local defaultFolderTitle = windowTitle:gsub("[^%w%-%._]", "_")
    if defaultFolderTitle == "" then defaultFolderTitle = "RimuruUI" end
    local window = setmetatable({
        Title = windowTitle,
        Subtitle = subtitle,
        ConfigFolder = tostring(config.ConfigFolder or ("RimuruUI_" .. defaultFolderTitle)),
        ConfigName = tostring(config.ConfigName or "default"),
        DefaultConfigName = tostring(config.ConfigName or "default"),
        LogoData = config.LogoData or resolveLogo(config.Logo or RimuruUI.DefaultLogo),
        BackgroundData = config.BackgroundData or resolveLogo(config.BackgroundImage or RimuruUI.DefaultBackground),
        ThemeName = tostring(config.Theme or "Rimuru Hub"),
        ToggleKey = toggleKey,
        Width = width,
        Height = height,
        SidebarWidth = sidebar,
        TopbarHeight = config.TopbarHeight or 48,
        LogoSpace = logoSpace,
        CornerRadius = config.CornerRadius or 10,
        X = config.Position and config.Position[1] or floor((screenWidth - width) / 2),
        Y = config.Position and config.Position[2] or floor((screenHeight - height) / 2),
        Visible = config.Visible ~= false,
        Closing = false,
        RenderAlpha = (config.Visible == false or config.Loading ~= false) and 0 or 1,
        AlphaTarget = config.Visible == false and 0 or 1,
        Loading = config.Loading ~= false,
        LoadingStarted = clock(),
        LoadingDuration = math.max(0.8, tonumber(config.LoadingDuration) or 1.65),
        LoadingAlpha = 0,
        LoadingClosing = false,
        LoadingInitialized = false,
        LoadingProgress = 0,
        Ready = false,
        Minimized = false,
        MinimizeProgress = 0,
        MinimizeTarget = 0,
        Hidden = false,
        Dragging = false,
        Categories = {},
        ActiveTab = nil,
        SearchQuery = "",
        Changelogs = {},
        DiscordFeedback = "",
        DiscordFeedbackUntil = 0,
        DiscordPress = 0,
        ShowWatermark = config.Watermark ~= false,
        ShowKeybindOverlay = config.KeybindOverlay ~= false,
        StableImagePrefix = "window:" .. tostring(#Windows + 1),
        WatermarkX = config.WatermarkPosition and config.WatermarkPosition[1] or 14,
        WatermarkY = config.WatermarkPosition and config.WatermarkPosition[2] or 14,
        KeybindOverlayX = config.KeybindPosition and config.KeybindPosition[1] or 14,
        KeybindOverlayY = config.KeybindPosition and config.KeybindPosition[2] or 54,
        OverlayDrag = nil,
    }, Window)
    if type(RimuruUI.ApplyTheme) == "function" then
        RimuruUI.ApplyTheme(window.ThemeName, window)
    end
    window.HomeTab = setmetatable({
        Name = "Home Page", Icon = "home", Sections = {}, IsHome = true, Window = window,
    }, Tab)
    window.SettingsTab = setmetatable({
        Name = "Settings", Icon = "settings", Sections = {}, IsSettings = true, Window = window,
    }, Tab)
    window.ActiveTab = window.HomeTab
    Windows[#Windows + 1] = window
    debugLog("window create", window.Title, window.ToggleKey)
    if not RimuruUI.MainWindow then RimuruUI.MainWindow = window end
    window:CreateConfig(window.ConfigName)
    if not window.Loading then
        window.Config:Initialize()
        window:Finalize()
    end
    if config.AutoStart ~= false and type(RimuruUI.Start) == "function" then RimuruUI.Start() end
    return window
end

