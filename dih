local function normalizeSectionColumn(value)
    if type(value) == "number" then
        return value <= 0 and 0 or 1
    end
    value = lower(tostring(value or ""))
    if value == "left" or value == "0" then return 0 end
    if value == "right" or value == "1" then return 1 end
    return nil
end

function Tab:AddSection(title, config)
    config = type(config) == "table" and config or {}
    local section = setmetatable({
        Title = tostring(title or config.Title or "Section"),
        Height = config.Height,
        Column = normalizeSectionColumn(config.Column or config.column),
        Collapsed = config.Collapsed == true,
        CollapseProgress = config.Collapsed == true and 1 or 0,
        Items = {},
        Tab = self,
    }, Section)
    self.Sections[#self.Sections + 1] = section
    debugLog("section create", section.Title)
    return section
end

