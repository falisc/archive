local Keys, Order, Names = {}, {}, {}

local function register(name, id, character, shifted)
    if not Keys[name] then Order[#Order + 1] = name end
    Keys[name] = {
        Name = name,
        Id = id,
        Character = character,
        Shifted = shifted,
        Down = false,
        Pressed = false,
        Released = false,
    }
    Names[id] = name
end

