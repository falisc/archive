local function renderColorPicker(item, x, y, width, z, compact)
    local rowHeight = compact and 18 or (item.Height or 30)
    local textY = y + math.floor((rowHeight - 11) / 2)
    local pickerWidth = 16
    local pickerHeight = pickerWidth
    local pickerX = x + width - pickerWidth
    local pickerY = y + math.floor((rowHeight - pickerHeight) / 2)
    local colour, r, g, b = colorValue(item)
    item.Alpha = item.Alpha or 1
    if not item.HsvReady then
        item.Hue, item.Saturation, item.ValueLevel = rgbToHsv(r, g, b)
        item.HsvReady = true
    end
    local hovered = RimuruUI.IsMouseOver(x, y, width, rowHeight)
    item.Hover = approach(item.Hover or 0, hovered and 1 or 0, 18)
    if not compact then
        paintText(item.Text, x, textY, colourMix(Theme.Text, Theme.HoverText, item.Hover), 11, 1, z)
    end
    paintRect(pickerX, pickerY, pickerWidth, pickerHeight, colour, item.Alpha, z + 1, 4)
    paintRect(pickerX, pickerY, pickerWidth, pickerHeight,
        hovered and Theme.HoverText or Theme.Border, hovered and 0.9 or 0.72,
        z + 2, 4, false, 1)
    if RimuruUI.ConsumeMousePress(x, y, width, rowHeight) then
        if not item.Open then RimuruUI.CloseTransientMenus(item) end
        item.Open = not item.Open
        item.PopupAlpha = 0
        if item.Open then state.ColorPickerOpen = item else state.ColorPickerOpen = nil end
        debugLog("color picker " .. (item.Open and "open" or "close"), item.Text)
    end
    if not item.Open then return end
    local popupWidth, popupHeight = 202, 252
    local screenWidth, screenHeight = viewport()
    local contentLeft = state.ContentLeft or (x + 4)
    local contentRight = state.ContentRight or (x + width - 4)
    local contentTop = state.ClipTop or (y + rowHeight + 4)
    local contentBottom = state.ClipBottom or (screenHeight - 6)
    local popupMinX = contentLeft + 4
    local popupMaxX = math.max(popupMinX, contentRight - popupWidth - 4)
    local popupX = clamp(x + width - popupWidth, popupMinX, popupMaxX)
    local popupY = y + rowHeight + 5
    if popupY + popupHeight > contentBottom then popupY = y - popupHeight - 5 end
    local popupMinY = contentTop + 4
    local popupMaxY = math.max(popupMinY, contentBottom - popupHeight - 4)
    popupY = clamp(popupY, popupMinY, popupMaxY)
    item.PopupBounds = {
        X = popupX, Y = popupY, Width = popupWidth, Height = popupHeight, Channels = {},
    }
    local popupAlpha = approach(item.PopupAlpha or 0, 1, 24)
    item.PopupAlpha = popupAlpha
    local previousLocalAlpha = state.LocalAlpha
    state.LocalAlpha = (previousLocalAlpha or 1) * popupAlpha
    paintRect(popupX - 1, popupY - 1, popupWidth + 2, popupHeight + 2,
        Theme.Border, 0.94, z + 20, 10, false, 2)
    paintRect(popupX, popupY, popupWidth, popupHeight, Theme.Panel, 0.99, z + 21, 9)
    paintRect(popupX + 2, popupY + 2, popupWidth - 4, popupHeight - 4,
        Theme.BorderSoft, 0.86, z + 22, 7, false, 1)

    local pad = 12
    local field = popupWidth - pad * 2 - 26
    local fieldX, fieldY = popupX + pad, popupY + pad
    local hueX = popupX + popupWidth - pad - 18
    local svSheet = colourSvSheet(item.Hue)
    if svSheet then
        paintImageRect(svSheet, fieldX, fieldY, field, field, 5, 1, z + 23)
