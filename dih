            local keyX = x + width - 11 - #key * 10 * 0.53
            paintText(key, keyX, rowY + 3, keyColour, 10, 1, z + 3)
        end
        if #entries > visibleCount then
            paintText("+" .. tostring(#entries - visibleCount) .. " more", x + 11,
