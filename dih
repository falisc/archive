        keybindConfig = { Default = keybindConfig }
    end
    local keybind = keybindConfig and {
        Value = keybindConfig.Default or keybindConfig.Value or "None",
        Mode = lower(tostring(keybindConfig.Mode or "toggle")),
        Callback = keybindConfig.Callback,
    } or nil
    local colorConfig = config.ColorPicker or config.Color
    if colorConfig ~= nil and type(colorConfig) ~= "table" then
        colorConfig = { Default = colorConfig }
    end
    local colorPicker = colorConfig and {
        Type = "colorpicker", Text = tostring(text or "Color"),
        Value = colorConfig.Default or colorConfig.Value or makeColor(1, 1, 1),
        Alpha = pickerAlpha(colorConfig),
        Callback = colorConfig.Callback,
        Height = 20,
    } or nil
    return self:Add({
        Type = "toggle", Text = tostring(text or "Toggle"),
        Value = config.Default == true or config.Value == true, Height = 30,
        Keybind = keybind,
        KeybindCallback = keybindConfig and keybindConfig.Callback or nil,
        ColorPicker = colorPicker,
        Callback = config.Callback, Flag = config.Flag, NoConfig = config.NoConfig == true,
    })
end

