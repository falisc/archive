    local selectorY = fieldY + (1 - clamp(item.ValueLevel or 1, 0, 1)) * field
    paintCircle(selectorX, selectorY, 6, makeColor(0, 0, 0), 0.62, z + 25, false, 2)
    paintCircle(selectorX, selectorY, 5, makeColor(1, 1, 1), 1, z + 26, false, 1.6)

