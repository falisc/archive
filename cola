    self.lastMousePressed = false
    self.hoverAnim = 0
    self.pressAnim = 0
    return self
end

function Button:Render(x, y, width, mousePos)
    local h = 20
    local hovered = false
    local pressed = false

    if mousePos then
        hovered = mousePos.X >= x and mousePos.X <= x + width and
                  mousePos.Y >= y and mousePos.Y <= y + h
        pressed = hovered and _mouseDown
    end

    self.hoverAnim = approach(self.hoverAnim, hovered and 1 or 0, 16)
    self.pressAnim = approach(self.pressAnim, pressed and 1 or 0, 20)

    local scale = 1 - self.pressAnim * 0.06
    local sW = width * scale
    local sH = h * scale
    local sX = x + (width - sW) / 2
    local sY = y + (h - sH) / 2

    local hoverColor = rgb(60, 60, 60)
    local bg = lerpColor(rgb(28, 28, 28), hoverColor, self.hoverAnim)
    bg = lerpColor(bg, THEME.accent, self.pressAnim)
    local borderColor = rgb(55, 55, 55)

    rect(sX, sY, sW, sH, bg, 15, true, 0.9)
    if self.pressAnim > 0.01 then
        local segs = math.max(2, sW)
        local ga = self.pressAnim * 0.7
        for i = 0, segs - 1 do
            local t = i / (segs - 1)
            local segX = math.floor(sX + sW * i / segs)
            local segEnd = sX + sW * (i + 1) / segs
            local segW = math.max(1, math.floor(segEnd) - segX)
            rect(segX, sY, segW, sH, getGradientColor(t), 16, true, ga)
        end
    end
    rect(sX, sY, sW, 1, borderColor, 17, true, 0.9)
    rect(sX, sY + sH - 1, sW, 1, borderColor, 17, true, 0.9)
    rect(sX, sY, 1, sH, borderColor, 17, true, 0.9)
    rect(sX + sW - 1, sY, 1, sH, borderColor, 17, true, 0.9)

    -- Drawing's Center property anchors this text at its literal midpoint.
    local textObj, textCache = txt(self.text, sX + sW / 2, sY + sH / 2, THEME.text, 10, 17, 1)
    if textObj then
        textCache.center = true
        textCache.y = sY + sH / 2
        textObj.Center = true
        textObj.Position = Vector2.new(sX + sW / 2, sY + sH / 2)
    end
    if mousePos then
        if hovered and _mouseJustPressed then
            if self.callback then self.callback() end
        end
    end

    return h + 6
end
