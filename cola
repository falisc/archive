-- ColaUI instance registry: a new execution invalidates and cleans up prior UI instances.
local _colaEnv
pcall(function() _colaEnv = (getfenv and getfenv()) or _G end)
if type(_colaEnv) ~= "table" then _colaEnv = _G end
local function colaWriteGlobal(key, value)
    pcall(function() _colaEnv[key] = value end)
    pcall(function() if getgenv then getgenv()[key] = value end end)
    pcall(function() _G[key] = value end)
    pcall(function() if type(shared) == "table" then shared[key] = value end end)
end
local function colaReadGlobal(key)
    local value
    pcall(function() value = _colaEnv[key] end)
    if value ~= nil then return value end
    pcall(function() if getgenv then value = getgenv()[key] end end)
    if value ~= nil then return value end
    pcall(function() value = _G[key] end)
    if value ~= nil then return value end
    pcall(function() if type(shared) == "table" then value = shared[key] end end)
    return value
end
