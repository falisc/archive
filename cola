-- ===== Dropdown class =====
local Dropdown = {}
Dropdown.__index = Dropdown

function Dropdown.new(text, options, dtype, callback, default)
    local self = setmetatable({}, Dropdown)
    self.text = text
    self.options = options or {}
    self.type = dtype or "Single"
    self.callback = callback
    self.expanded = false
    self.expandAnim = 0
    self.hoverAnim = 0
    self.pressAnim = 0
    self.lastPressed = false
    self.searchQuery = ""
    self.inputFocused = false
    self.inputConnection = nil
    self.scrollOffset = 0
    self.scrollHeld = false
    self.selectionAnim = {}
    self.selectionPulse = {}
    self._isDropdown = true
    self.selectAllHover = 0
    self.unselectAllHover = 0
    if self.type == "Single" then
        self.selected = default or nil
    else
        self.selected = {}
        if default then
            for _, v in ipairs(default) do
                self.selected[v] = true
            end
        end
    end
    return self
end

function Dropdown:Render(x, y, width, mousePos, viewportTop, viewportBottom)
    local previousClipTop, previousClipBottom = drawingClipTop, drawingClipBottom
    drawingClipTop, drawingClipBottom = viewportTop, viewportBottom
    local h = 24
    local optionH = 20
    local searchH = 22
    local multiActionH = 18
    local multiActionGap = 3
    local isMulti = self.type ~= "Single"
    local controlsH = searchH + (isMulti and (multiActionH + multiActionGap) or 0)
    local optionBottomPadding = 6

    -- Filter options by search query
    local query = (self.searchQuery or ""):lower()
    local filteredOptions = {}
    for _, opt in ipairs(self.options) do
        if query == "" or opt:lower():find(query, 1, true) then
            table.insert(filteredOptions, opt)
        end
    end

    -- Label
    local label
    if self.type == "Single" then
        label = self.text .. ": " .. (self.selected or "None")
    else
        local count = 0
        for _, opt in ipairs(self.options) do
            if self.selected and self.selected[opt] then count = count + 1 end
        end
        label = self.text .. ": " .. count .. " selected"
    end

    self.expandAnim = approach(self.expandAnim, self.expanded and 1 or 0, 12)

    local optCount = #filteredOptions
    local contentH = optCount * optionH
    local maxVisible = math.min(contentH, 160)
    local animH = 0
    local searchAnim = math.floor(controlsH * self.expandAnim)
    if optCount > 0 and self.expandAnim > 0.01 then
        animH = math.floor((maxVisible + optionBottomPadding) * self.expandAnim)
    end
    local visualH = h + searchAnim + animH
    local total = visualH + 6

    -- Scroll
    local scrollMax = math.max(0, contentH - maxVisible)
    self.scrollOffset = math.max(0, math.min(self.scrollOffset or 0, scrollMax))

    -- Hover + press
    local hovered = mousePos and mousePos.X >= x and mousePos.X <= x + width and mousePos.Y >= y and mousePos.Y <= y + h or false
    self.hoverAnim = approach(self.hoverAnim, hovered and 1 or 0, 16)
    local pressed = mousePos and hovered and _mouseDown or false
    self.pressAnim = approach(self.pressAnim, pressed and 1 or 0, 20)
    local scale = 1 - self.pressAnim * 0.06
    local sW = width * scale
    local sH = h * scale
    local sX = x + (width - sW) / 2
    local sY = y + (h - sH) / 2

    -- Main row background
    local hoverColor = rgb(60, 60, 60)
    local rowBg = lerpColor(rgb(28, 28, 28), hoverColor, self.hoverAnim)
    rowBg = lerpColor(rowBg, THEME.accent, self.pressAnim)
    rect(sX, sY, sW, sH, rowBg, 15, true, 0.9)
    if self.pressAnim > 0.01 then
        local segs = math.max(2, sW)
        local ga = self.pressAnim * 0.7
        for i = 0, segs - 1 do
            local t = i / (segs - 1)
            local segX = math.floor(sX + sW * i / segs)
            local segEnd = sX + sW * (i + 1) / segs
            local segW = math.max(1, math.floor(segEnd) - segX)
            rect(segX, sY, segW, sH, getGradientColor(t), 16, true, ga)
        end
    end

    -- Expanded area background (covers search bar + options)
    local expandH = searchAnim + animH
    local borderColor = rgb(55, 55, 55)
    local accentColor = THEME.dropdownAccent
    local expandedDrawH = expandH
    if viewportBottom then
        expandedDrawH = math.max(0, math.min(y + h + expandH, viewportBottom) - (y + h))
    end
    if expandedDrawH > 0 then
        rect(x, y + h, width, expandedDrawH, rgb(24, 24, 24), 15, true, 0.9)
    end

    -- Multi-select actions sit above search and operate on the entire list.
    if isMulti and searchAnim > 0 then
        local actionX = x + 6
        local actionY = y + h + 2
        local actionW = width - 12
        local actionGap = 4
        local buttonW = (actionW - actionGap) / 2
        local selectHovered = mousePos and mousePos.X >= actionX and mousePos.X <= actionX + buttonW and mousePos.Y >= actionY and mousePos.Y <= actionY + multiActionH or false
        local clearX = actionX + buttonW + actionGap
        local clearHovered = mousePos and mousePos.X >= clearX and mousePos.X <= clearX + buttonW and mousePos.Y >= actionY and mousePos.Y <= actionY + multiActionH or false
        self.selectAllHover = approach(self.selectAllHover or 0, selectHovered and 1 or 0, 16)
        self.unselectAllHover = approach(self.unselectAllHover or 0, clearHovered and 1 or 0, 16)

        local function actionButton(bx, label, hover)
            local bg = lerpColor(rgb(22, 22, 22), rgb(30, 30, 30), hover)
            rect(bx, actionY, buttonW, multiActionH, bg, 18, true, 0.9 * self.expandAnim, 4)
            rect(bx, actionY, buttonW, multiActionH, rgb(80, 80, 80), 19, false, (0.3 + hover * 0.3) * self.expandAnim, 4)
            txt(label, bx + (buttonW - #label * 5.4) / 2, actionY + 4, THEME.text, 9, 20, self.expandAnim)
        end
        actionButton(actionX, "Select All", self.selectAllHover)
        actionButton(clearX, "Unselect All", self.unselectAllHover)

        if mousePos and _mouseJustPressed then
            if selectHovered then
                self.selected = {}
                for _, opt in ipairs(self.options) do self.selected[opt] = true end
                if self.callback then self.callback(self.selected) end
            elseif clearHovered then
                self.selected = {}
                if self.callback then self.callback(self.selected) end
            end
        end
    end
    -- Search bar inside expanded area
    if searchAnim > 0 then
        local sbx = x + 6
        local sby = y + h + 2 + (isMulti and (multiActionH + multiActionGap) or 0)
        local sbw = width - 12
        local sbh = searchH - 4
        local focused = self.inputFocused
        local sbBg = lerpColor(rgb(22, 22, 22), rgb(30, 30, 30), focused and 1 or 0)
        rect(sbx, sby, sbw, sbh, sbBg, 18, true, 0.9 * self.expandAnim, 4)
        rect(sbx, sby, sbw, sbh, rgb(80, 80, 80), 19, false, (focused and 0.6 or 0.3) * self.expandAnim, 4)
        local searchText = self.searchQuery or ""
        local textSpace = sbw - 30
        local visibleChars = math.floor(textSpace / 6)
        local textOff = math.max(0, #searchText - visibleChars)
        local visibleText = string.sub(searchText, textOff + 1)
        local textDrawing = nil
        if #searchText > 0 then
            textDrawing = txt(visibleText, sbx + 6, sby + (sbh - 10) / 2, THEME.text, 10, 20, self.expandAnim)
        elseif not focused then
            txt("search...", sbx + 6, sby + (sbh - 10) / 2, rgb(120, 120, 120), 10, 20, self.expandAnim)
        end
        if focused then
            -- A soft three-dot wave replaces the text caret in search fields.
            local phase = tick() * 4
            for i = 1, 3 do
                local wave = (math.sin(phase - (i - 1) * 0.8) + 1) * 0.5
                circle(sbx + sbw - 9 - (3 - i) * 5, sby + sbh / 2 - wave * 1.2, 1 + wave * 0.45, THEME.text, 21, true, (0.30 + wave * 0.55) * self.expandAnim)
            end
        end
    end

    -- Borders
    if expandH > 0 then
        local visibleBorderH = h + expandedDrawH
        rect(x, y, width, 1, borderColor, 17, true, 0.9)
        rect(x, y, 1, visibleBorderH, borderColor, 17, true, 0.9)
        rect(x + width - 1, y, 1, visibleBorderH, borderColor, 17, true, 0.9)
        rect(x, y + h - 1, width, 1, borderColor, 17, true, 0.9)
        -- Do not draw a false bottom edge where the window clipped us.
        if expandedDrawH >= expandH then
            rect(x, y + h + expandH - 1, width, 1, borderColor, 17, true, 0.9)
        end
    else
        rect(sX, sY, sW, 1, borderColor, 17, true, 0.9)
        rect(sX, sY + sH - 1, sW, 1, borderColor, 17, true, 0.9)
        rect(sX, sY, 1, sH, borderColor, 17, true, 0.9)
        rect(sX + sW - 1, sY, 1, sH, borderColor, 17, true, 0.9)
    end

    -- Label text
    txt(label, sX + 6, sY + (sH - 10) / 2, THEME.text, 10, 18, 1)

    -- Arrow
    local arrowColor = accentColor
    local bcx = math.floor(sX + sW - 14)
    local bcy = math.floor(sY + sH / 2)
    local mw = 9
    local anim = self.expandAnim
    for k = 1, 5 do
        local w = math.floor(mw - 2 * (k - 1) + anim * (4 * (k - 1) + 1 - mw))
        rect(bcx - math.floor(w / 2), bcy - 2 + (k - 1), w, 1, arrowColor, 18, true, 1)
    end

    -- Click handling
    if hovered and mousePos and _mouseDown and not self.lastPressed then
        self.expanded = not self.expanded
        if not self.expanded and self.inputFocused then
            textInputEnd()
            self.inputFocused = false
        end
    end

    -- Scroll via mouse wheel
    if self.expanded and animH > 1 and mousePos and mousePos.X >= x and mousePos.X <= x + width and mousePos.Y >= y + h + searchAnim and mousePos.Y <= y + h + searchAnim + animH then
        local scrollDelta = 0
        if isKeyDown(KEY_VK.pageup) then scrollDelta = scrollDelta - optionH * 3 end
        if isKeyDown(KEY_VK.pagedown) then scrollDelta = scrollDelta + optionH * 3 end
        if scrollDelta ~= 0 then
            self.scrollOffset = math.max(0, math.min(scrollMax, self.scrollOffset + scrollDelta))
        end
    end

    -- Also handle mouse wheel via InputBegan (store accumulated delta)
    if self.expanded and animH > 1 then
        local wheelDir = _dropdownWheel or 0
        if wheelDir ~= 0 then
            self.scrollOffset = math.max(0, math.min(scrollMax, self.scrollOffset + wheelDir * optionH * 2))
            _dropdownWheel = 0
        end
    end

    -- Keyboard input (per-frame polling, like friendsuilib)
    if self.inputFocused then
        pcall(setrobloxinput, false)
        if not self._lastKeyStates then self._lastKeyStates = {} end
        if not self._keyRepeatTimer then self._keyRepeatTimer = {} end
        local states = self._lastKeyStates
        local timers = self._keyRepeatTimer
        local shiftHeld = isKeyDown(KEY_VK.lshift) or isKeyDown(KEY_VK.rshift)
        for name, vk in pairs(_TEXT_KEYS) do
            local down = isKeyDown(vk)
            local prev = states[name]
            local isEdge = down and not prev

            if name == "esc" or name == "enter" then
                -- These shouldn't repeat while held, just fire once on press
                if isEdge then
                    if self.inputFocused then textInputEnd() end
                    self.inputFocused = false
                end
            else
                local fire = false
                if isEdge then
                    fire = true
                    timers[name] = KEY_REPEAT_DELAY
                elseif down then
                    local t = (timers[name] or KEY_REPEAT_DELAY) - FRAME_DT
                    if t <= 0 then
                        fire = true
                        t = KEY_REPEAT_INTERVAL
                    end
                    timers[name] = t
                else
                    timers[name] = nil
                end

                if fire then
