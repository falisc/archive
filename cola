local HttpService = game:GetService("HttpService")
local function configSafeName(name)
    name = tostring(name or "default"):gsub("[^%w%-%_ ]", "")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    return name ~= "" and name or "default"
end
local function configFolder(win) return win.configFolder or "ColaUI_configs" end
local function autoloadPrefsPath(win) return configFolder(win) .. "/_autoload.json" end
local function readAutoloadPref(win)
    local path = autoloadPrefsPath(win)
    if not (isfile and readfile and isfile(path)) then return nil end
    local raw; pcall(function() raw = readfile(path) end)
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    return ok and type(data) == "table" and data[tostring(win.configBaseName or "default")] or nil
end
local function readAutoSavePref(win)
    local path = autoloadPrefsPath(win)
    if not (isfile and readfile and isfile(path)) then return nil end
    local raw; pcall(function() raw = readfile(path) end)
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    local value = ok and type(data) == "table" and data["autosave:" .. tostring(win.configBaseName or "default")] or nil
    return type(value) == "boolean" and value or nil
end
local function writeAutoSavePref(win, enabled)
    if type(writefile) ~= "function" then return end
    local path, data = autoloadPrefsPath(win), {}
    if isfile and readfile and isfile(path) then
        local raw; pcall(function() raw = readfile(path) end)
        local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(decoded) == "table" then data = decoded end
    end
    data["autosave:" .. tostring(win.configBaseName or "default")] = enabled == true
    pcall(function() if isfolder and not isfolder(configFolder(win)) then makefolder(configFolder(win)) end end)
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if ok then pcall(writefile, path, encoded) end
end
local function writeAutoloadPref(win, name)
    if not writefile then return end
    local path, data = autoloadPrefsPath(win), {}
    if isfile and readfile and isfile(path) then
        local raw; pcall(function() raw = readfile(path) end)
        local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(decoded) == "table" then data = decoded end
    end
    data[tostring(win.configBaseName or "default")] = name
    pcall(function() if isfolder and not isfolder(configFolder(win)) then makefolder(configFolder(win)) end end)
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if ok then pcall(writefile, path, encoded) end
end
local function configEnsureFolder(win)
    pcall(function() if isfolder and not isfolder(configFolder(win)) then makefolder(configFolder(win)) end end)
end
local function configElementValue(element)
    if element.noSave then return nil end
    if getmetatable(element) == Checkbox then
        local data = { type = "checkbox", checked = element.checked, keybind = element.keybind, mode = element.keyMode }
        if element.colorPicker then data.color = { element.colorPicker.r, element.colorPicker.g, element.colorPicker.b } end
        return data
    elseif getmetatable(element) == Slider then return { type = "slider", value = element.value }
    elseif getmetatable(element) == Dropdown then
        local value = element.selected
        if element.type ~= "Single" then
            value = {}; for option, selected in pairs(element.selected) do if selected then table.insert(value, option) end end
        end
        return { type = "dropdown", value = value }
    elseif getmetatable(element) == Textbox then return { type = "textbox", value = element.value }
    elseif getmetatable(element) == Keybind then return { type = "keybind", value = element.keybind }
    elseif getmetatable(element) == ColorPicker then return { type = "color", value = { element.r, element.g, element.b } }
    end
end
local function configApplyElement(element, data)
    if type(data) ~= "table" then return end
    local kind = getmetatable(element)
    if kind == Checkbox and data.type == "checkbox" then
        element:SetValue(data.checked == true)
        element.keybind = normalizeKey(data.keybind)
        element.keyMode = data.mode or element.keyMode
        if data.color and element.colorPicker then element.colorPicker:SetValue(data.color, false) end
        return
    end
    if kind == Slider and data.type == "slider" then element:SetValue(data.value); return end
    if kind == Dropdown and data.type == "dropdown" then
        if element.type == "Single" then
            element.selected = data.value
        else
            element.selected = {}
            for _, value in ipairs(data.value or {}) do element.selected[value] = true end
        end
        if element.callback then element.callback(element.selected) end
        return
    end
    if kind == Textbox and data.type == "textbox" then element:SetValue(data.value); return end
    if kind == Keybind and data.type == "keybind" then
        element:SetKeybind(data.value)
        if element.callback then element.callback(element.keybind) end
        return
    end
    if kind == ColorPicker and data.type == "color" then element:SetValue(data.value, false) end
end
local function configControlKey(groupIndex, tabIndex, side, section, sectionIndex, element, elementIndex)
    local sectionName = tostring(section.name or sectionIndex):gsub("[|:]", "_")
    local elementName = tostring(element.text or element.label or elementIndex):gsub("[|:]", "_")
    return string.format("v2|%d|%s|%s|%s|%s|%d", groupIndex, tostring(tabIndex), side, sectionName, elementName, elementIndex)
end
local function legacyConfigControlKey(groupIndex, tabIndex, side, sectionIndex, elementIndex)
    return string.format("%d:%s:%s:%d:%d", groupIndex, tostring(tabIndex), side, sectionIndex, elementIndex)
end
function Window:SerializeConfig()
    local output = { version = 2, controls = {} }
    local groups = { self.tabSections, { self.settingsTabData } }
    for groupIndex, tabs in ipairs(groups) do
        for tabIndex, columns in pairs(tabs) do
            for side, sections in pairs(columns) do
                for sectionIndex, section in ipairs(sections) do
                    for elementIndex, element in ipairs(section.elements) do
                        local value = configElementValue(element)
                        if value then output.controls[configControlKey(groupIndex, tabIndex, side, section, sectionIndex, element, elementIndex)] = value end
                    end
                end
            end
        end
    end
    return output
end
function Window:ApplyConfigData(data)
    if type(data) ~= "table" then return self end
    local groups = { self.tabSections, { self.settingsTabData } }
    for groupIndex, tabs in ipairs(groups) do
        for tabIndex, columns in pairs(tabs) do
            for side, sections in pairs(columns) do
                for sectionIndex, section in ipairs(sections) do
                    for elementIndex, element in ipairs(section.elements) do
                        local key = configControlKey(groupIndex, tabIndex, side, section, sectionIndex, element, elementIndex)
                        local legacyKey = legacyConfigControlKey(groupIndex, tabIndex, side, sectionIndex, elementIndex)
                        configApplyElement(element, data.controls and (data.controls[key] or data.controls[legacyKey]))
                    end
                end
            end
        end
    end
    if self.uiKeybindControl and self.uiKeybindControl.keybind then
        self.keybind = self.uiKeybindControl.keybind
        self.keybindVK = KEY_VK[self.keybind]
        self.lastKeybindState = false
    end
    return self
end
function Window:CaptureDefaultConfig()
    self.defaultConfig = self:SerializeConfig()
    return self
end
function Window:SetAutoLoad(enabled, name)
    self.autoLoad = enabled == true
    local selected = name or self.configName or "Default"
    if self.autoLoad then writeAutoloadPref(self, selected) else writeAutoloadPref(self, nil) end
    return self
end
function Window:SetAutoSave(enabled)
    self.autoSave = enabled == true
    writeAutoSavePref(self, self.autoSave)
    return self
end
function Window:RestoreAutoLoad()
    local autoSave = readAutoSavePref(self)
    if autoSave ~= nil then
        self.autoSave = autoSave
        if self.autoSaveControl then self.autoSaveControl.checked = autoSave; self.autoSaveControl.fillAnim = autoSave and 1 or 0 end
    end
    local selected = readAutoloadPref(self)
    if type(selected) ~= "string" or selected == "" then return self end
    self.autoLoad, self.configName = true, selected
    if self.configDropdown then self.configDropdown.selected = selected end
    if self.configNameBox then self.configNameBox:SetValue(selected == "Default" and "" or selected, true) end
    if self.autoLoadControl then self.autoLoadControl.checked = true; self.autoLoadControl.fillAnim = 1 end
    return self:LoadConfig(selected)
end
function Window:MarkConfigLoaded()
    self._suspendAutoSaveUntil = tick() + 1.25
    local ok, encoded = pcall(function() return HttpService:JSONEncode(self:SerializeConfig()) end)
    if ok then self._lastAutoSaveSnapshot = encoded end
    return self
end
function Window:SaveConfig(name)
    local configName = configSafeName(name or self.configName)
    if string.lower(configName) == "default" then return self end
    self.configName = configName
    local encodedOk, encoded = pcall(function() return HttpService:JSONEncode(self:SerializeConfig()) end)
    if not encodedOk or type(writefile) ~= "function" then return self end
    configEnsureFolder(self)
    local path = configFolder(self) .. "/" .. configName .. ".json"
    local wrote = pcall(function() writefile(path, encoded) end)
    if wrote then
        self._lastAutoSaveSnapshot = encoded
        if self.configDropdown then
            self.configDropdown.options = self:ListConfigs()
            self.configDropdown.selected = configName
        end
    end
    return self
end
function Window:LoadConfig(name)
    local configName = configSafeName(name or self.configName)
    if string.lower(configName) == "default" then
        self.configName = "Default"
        self:ApplyConfigData(self.defaultConfig)
        return self:MarkConfigLoaded()
    end
    self.configName = configName
    local raw; local path = configFolder(self) .. "/" .. self.configName .. ".json"
    if not (isfile and readfile and isfile(path)) then return self end
    pcall(function() raw = readfile(path) end)
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if ok then self:ApplyConfigData(data); self:MarkConfigLoaded() end
    return self
end
function Window:ListConfigs()
    local list, seen = { "Default" }, { ["default"] = true }
    pcall(function()
        for _, file in ipairs(listfiles(configFolder(self))) do
            local name = file:match("([^/\\]+)%.json$")
            if name and name ~= "_autoload" and not seen[string.lower(name)] then seen[string.lower(name)] = true; table.insert(list, name) end
        end
    end)
    table.sort(list, function(a, b) if a == "Default" then return true elseif b == "Default" then return false else return a:lower() < b:lower() end end)
    return list
end
function Window:DeleteConfig(name)
    local configName = configSafeName(name or self.configName)
    if string.lower(configName) == "default" then return self end
    local path = configFolder(self) .. "/" .. configName .. ".json"
    if delfile then pcall(delfile, path) end
    return self
end
function Window:PollAutoSave()
    if not self.autoSave or not writefile then return end
    if isAnyTextInputFocused() then return end
    local now = tick()
    if now < (self._suspendAutoSaveUntil or 0) then return end
    if now < (self._nextAutoSave or 0) then return end
    self._nextAutoSave = now + 0.75
    local ok, encoded = pcall(function() return HttpService:JSONEncode(self:SerializeConfig()) end)
    if ok and encoded ~= self._lastAutoSaveSnapshot then
        self:SaveConfig()
    end
end
-- ===== Global window management =====
local windows = {}
local conn = nil

local function renderAll(dt)
    -- A later ColaUI execution owns the registry token. The older render loop
    -- removes all of its drawings and disconnects itself on its next frame.
    if colaReadGlobal("__ColaUI_Instance") ~= _colaInstanceToken then
        pcall(setrobloxinput, true)
        if conn then conn:Disconnect(); conn = nil end
        for _, drawing in pairs(pool) do pcall(function() drawing:Remove() end) end
        pool, poolTypes, poolCache = {}, {}, {}
        windows, notifications, idx = {}, {}, 0
        return
    end
    FRAME_DT = dt or FRAME_DT
    idx = 0
    currentRenderAlpha = 1
    currentSectionAlpha = 1

    local ok, down = pcall(ismouse1pressed)
    local mouseDown = ok and down or false
    _mouseJustPressed = mouseDown and not _mouseDown
    _mouseDown = mouseDown

    -- Release the modal input capture only after the click that chose a mode
    -- has fully ended, so it cannot also activate a control behind the menu.
    if not mouseDown and _modalBlockUntilRelease then _modalBlockUntilRelease = false end

    if not mouseDown and _keybindMenuBlockUntilRelease then
        _keybindMenuBlockUntilRelease = false
        if _activeKeybindMenu and not _activeKeybindMenu.modeMenuOpen and (_activeKeybindMenu.modeMenuAnim or 0) <= 0.01 then
            _activeKeybindMenu = nil
        end
    end
    if not mouseDown and _activeKeybindMenu and not _activeKeybindMenu.modeMenuOpen and (_activeKeybindMenu.modeMenuAnim or 0) <= 0.01 then
        _activeKeybindMenu = nil
    end
    if not mouseDown and _activeColorPicker and not _activeColorPicker.popupOpen and (_activeColorPicker.popupAnim or 0) <= 0.01 then
        _activeColorPicker = nil
    end

    local okRight, rightDown = pcall(ismouse2pressed)
    rightDown = okRight and rightDown or false
    _mouseRightJustPressed = rightDown and not _mouseRightDown
    _mouseRightDown = rightDown

    local okMouse, mouse = pcall(function() return game.Players.LocalPlayer:GetMouse() end)
    _frameMousePos = okMouse and mouse and Vector2.new(mouse.X, mouse.Y) or nil
    -- Overlay drag capture runs before the main window or watermark can see
    -- this mouse press, so they cannot start dragging underneath it.
    for _, item in ipairs(windows) do
        if getmetatable(item) == KeybindOverlay then item:CaptureDrag() end
    end

    if _mouseJustPressed and _activeTextBox and not _activeTextBox:Contains(_frameMousePos) then
        _activeTextBox:Blur()
    end

    -- Click UI to capture injected input; click the game outside every UI
    -- surface to restore normal Roblox input while the window stays open.
    if _mouseJustPressed and _frameMousePos then
        local mx, my = _frameMousePos.X, _frameMousePos.Y
        local hitUI = false
        for _, item in ipairs(windows) do
            if getmetatable(item) == Window and item.visible and mx >= item.x and mx <= item.x + item.w and my >= item.y and my <= item.y + item.h then
                hitUI = true
                break
            elseif getmetatable(item) == Watermark and item.visible and mx >= item.x and mx <= item.x + (item.renderW or 0) and my >= item.y and my <= item.y + (item.renderH or 0) then
                hitUI = true
                break
            elseif getmetatable(item) == KeybindOverlay and item.visible and mx >= item.x and mx <= item.x + (item.renderW or 215) and my >= item.y and my <= item.y + (item.renderH or 0) then
                hitUI = true
                break
            end
        end
        _uiInputCaptured = hitUI
    end
    if isAnyTextInputFocused() or _anyUIDragging or _modalBlockUntilRelease then
        pcall(setrobloxinput, false)
    else
        pcall(setrobloxinput, not _uiInputCaptured)
    end

    for _, win in ipairs(windows) do
        if getmetatable(win) == Window and not win.visible then win:PollHiddenKeybinds() end
        win:Render()
        if win.PollAutoSave then win:PollAutoSave() end
    end
    for i = #notifications, 1, -1 do
        if not notifications[i]:Render(i) then table.remove(notifications, i) end
    end
    hideUnused()
end

local function startRender()
    if not conn then conn = RunService.RenderStepped:Connect(renderAll) end
end

function stopRender()
    if conn then conn:Disconnect(); conn = nil end
    for i, d in ipairs(pool) do
        local c = poolCache[i]
        if c and c.visible ~= false then c.visible = false; d.Visible = false end
    end
end

-- ============================================================
--   Library table (module pattern)
-- ============================================================
local UILib = {}

function UILib:CreateWindow(config)
    local win = Window.new(config)
    win:Center()
    table.insert(windows, win)
    win.keybindOverlay = KeybindOverlay.new(win)
    win.keybindOverlay.visible = win.showKeybindOverlay
    table.insert(windows, win.keybindOverlay)
    startRender()
    return win
end

function UILib:CreateWatermark(config)
    local wm = Watermark.new(config)
    table.insert(windows, wm)
    startRender()
    return wm
end

function UILib:Notify(config, message, duration)
    if type(config) ~= "table" then
        config = { Title = config, Content = message, Duration = duration }
    end
    local notification = Notification.new(config or {})
    table.insert(notifications, notification)
    startRender()
    return notification
end
function UILib:DestroyAll()
    for i = #windows, 1, -1 do
        local item = windows[i]
        if item and item.Destroy then pcall(function() item:Destroy() end) end
    end
    windows, notifications = {}, {}
    stopRender()
    for _, drawing in pairs(pool) do pcall(function() drawing:Remove() end) end
    pool, poolTypes, poolCache, idx = {}, {}, {}, 0
    pcall(setrobloxinput, true)
end
UILib.Destroy = UILib.DestroyAll
UILib.Unload = UILib.DestroyAll

colaWriteGlobal("ColaUI", UILib)
colaWriteGlobal("ColaUIUI", UILib)

-- Loadstring/module return. The user creates windows from their own script.
return UILib
