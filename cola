-- ===== Color picker class =====
local ColorPicker = {}
ColorPicker.__index = ColorPicker

local function colorParts(value)
    if value and value.R then
        return math.floor(value.R * 255 + 0.5), math.floor(value.G * 255 + 0.5), math.floor(value.B * 255 + 0.5)
    elseif type(value) == "table" then
        return value[1] or value.R or 255, value[2] or value.G or 255, value[3] or value.B or 255
    end
    return 255, 255, 255
end
local function rgbToHSV(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local maximum, minimum = math.max(r, g, b), math.min(r, g, b)
    local delta = maximum - minimum
    local hue = 0
    if delta > 0 then
        if maximum == r then hue = ((g - b) / delta) % 6
        elseif maximum == g then hue = (b - r) / delta + 2
        else hue = (r - g) / delta + 4 end
        hue = hue / 6
    end
    return hue, maximum == 0 and 0 or delta / maximum, maximum
end

local function hsvToRGB(h, s, v)
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
    local r, g, b
    i = i % 6
    if i == 0 then r, g, b = v, t, p
    elseif i == 1 then r, g, b = q, v, p
    elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v
    elseif i == 4 then r, g, b = t, p, v
    else r, g, b = v, p, q end
    return math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5)
end
function ColorPicker.new(text, default, callback)
    local self = setmetatable({}, ColorPicker)
    self.text = tostring(text or "Color")
    self.r, self.g, self.b = colorParts(default)
    self.h, self.s, self.v = rgbToHSV(self.r, self.g, self.b)
    self.callback = callback
    self.popupOpen = false
    self.popupAnim = 0
    return self
end

function ColorPicker:GetValue()
    return Color3.fromRGB(self.r, self.g, self.b)
end

function ColorPicker:SetValue(value, silent)
    self.r, self.g, self.b = colorParts(value)
    self.h, self.s, self.v = rgbToHSV(self.r, self.g, self.b)
    if not silent and self.callback then self.callback(self:GetValue()) end
    return self
end

function ColorPicker:SetHSV(h, s, v)
    self.h = math.max(0, math.min(1, h))
    self.s = math.max(0, math.min(1, s))
    self.v = math.max(0, math.min(1, v))
    self.r, self.g, self.b = hsvToRGB(self.h, self.s, self.v)
    if self.callback then self.callback(self:GetValue()) end
end
function ColorPicker:Toggle()
    if self.popupOpen then
        self.closePending = true
        _modalBlockUntilRelease = true
        return
    end
    if _activeColorPicker and _activeColorPicker ~= self then
        _activeColorPicker.popupOpen = false
    end
    self.popupOpen = true
    _activeColorPicker = self
end

function ColorPicker:RenderPopup(anchorX, anchorY, mousePos)
    if self.closePending and not _mouseDown then
        self.closePending = false
        self.popupOpen = false
    end
    self.popupAnim = approach(self.popupAnim or 0, self.popupOpen and 1 or 0, 18)
    if self.popupAnim <= 0.01 then return end
    local a = self.popupAnim
    local popupW, popupH = 160, 160
    local popupX, popupY = anchorX - popupW + 14, anchorY + 18 - (1 - a) * 4
    local squareX, squareY, squareW, squareH = popupX + 8, popupY + 8, 120, 120
    local hueX, hueW = squareX + squareW + 8, 14
    rect(popupX, popupY, popupW, popupH, rgb(18, 18, 18), 40, true, 0.98 * a, 0)
    rect(popupX, popupY, popupW, popupH, rgb(78, 78, 78), 41, false, 0.82 * a, 0)

    -- A real two-dimensional saturation/value field, driven by the hue strip.
    local cols, rows = 22, 15
    for row = 0, rows - 1 do
        local value = 1 - row / (rows - 1)
        local cellY = squareY + squareH * row / rows
        local cellH = squareY + squareH * (row + 1) / rows - cellY + 0.5
        for col = 0, cols - 1 do
            local saturation = col / (cols - 1)
            local cr, cg, cb = hsvToRGB(self.h, saturation, value)
            local cellX = squareX + squareW * col / cols
            local cellW = squareX + squareW * (col + 1) / cols - cellX + 0.5
            rect(cellX, cellY, cellW, cellH, Color3.fromRGB(cr, cg, cb), 42, true, a)
        end
    end
    rect(squareX, squareY, squareW, squareH, rgb(110, 110, 110), 43, false, 0.85 * a)

    local hueSteps = 30
    for step = 0, hueSteps - 1 do
        local hr, hg, hb = hsvToRGB(step / (hueSteps - 1), 1, 1)
        local stripY = squareY + squareH * step / hueSteps
        local stripH = squareY + squareH * (step + 1) / hueSteps - stripY + 0.5
        rect(hueX, stripY, hueW, stripH, Color3.fromRGB(hr, hg, hb), 42, true, a)
    end
    rect(hueX, squareY, hueW, squareH, rgb(110, 110, 110), 43, false, 0.85 * a)

    local cursorX = squareX + self.s * squareW
    local cursorY = squareY + (1 - self.v) * squareH
    rect(cursorX - 3, cursorY - 3, 7, 7, rgb(255, 255, 255), 44, false, a)
    local hueY = squareY + self.h * squareH
    rect(hueX - 2, hueY - 1, hueW + 4, 3, rgb(255, 255, 255), 44, true, a)
    txt(string.format("%d, %d, %d", self.r, self.g, self.b), popupX + 8, popupY + 139, rgb(195, 195, 195), 9, 44, a)
    rect(popupX + popupW - 29, popupY + 138, 20, 10, self:GetValue(), 44, true, a)
    rect(popupX + popupW - 29, popupY + 138, 20, 10, rgb(90, 90, 90), 45, false, a)

    if self.popupOpen and mousePos and _mouseDown then
        if mousePos.X >= squareX and mousePos.X <= squareX + squareW and mousePos.Y >= squareY and mousePos.Y <= squareY + squareH then
            self:SetHSV(self.h, (mousePos.X - squareX) / squareW, 1 - (mousePos.Y - squareY) / squareH)
        elseif mousePos.X >= hueX - 2 and mousePos.X <= hueX + hueW + 2 and mousePos.Y >= squareY and mousePos.Y <= squareY + squareH then
            self:SetHSV((mousePos.Y - squareY) / squareH, self.s, self.v)
        end
    end
end
