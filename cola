function Section:Render(x, y, width, mousePos, clipTop, clipBottom)
    local headerHeight = 24
    local contentPadding = 6
    local lineThickness = 1
    local sectionPadding = 6

    local HEADER_FADE_ZONE = 18
    local headerClipAlpha = 1
    if clipTop then
        local topD = y - clipTop
        local botD = clipBottom - (y + headerHeight)
        local aTop = math.max(0, math.min(1, 1 + topD / HEADER_FADE_ZONE))
        local aBot = math.max(0, math.min(1, 1 + botD / HEADER_FADE_ZONE))
        headerClipAlpha = math.min(aTop, aBot)
    end

    local lineY = y + headerHeight / 2 - lineThickness / 2
    local lineStartX = x + sectionPadding
    local textStartX = x + sectionPadding + 8
    local textEstW = #self.name * 5.4
    local textEndX = textStartX + textEstW
    local buttonSize = 12
    local buttonX = x + width - buttonSize - sectionPadding
    local buttonEndX = buttonX - 2
    local lineEndX = x + width - sectionPadding

    if headerClipAlpha > 0.02 then
        local prevSA = currentSectionAlpha
        currentSectionAlpha = prevSA * headerClipAlpha

        if textStartX - lineStartX > 0 then
            local t1 = 0.2
            rect(lineStartX, lineY, textStartX - lineStartX, lineThickness,
                 getGradientColor(t1), 14, true, 0.8)
        end

        txt(self.name, textStartX, y + 5, THEME.text, 10, 16, 1)

        if buttonX - textEndX > 0 then
            local t2 = 0.5
            rect(textEndX, lineY, buttonX - textEndX, lineThickness,
                 getGradientColor(t2), 14, true, 0.8)
        end
        
        if lineEndX - buttonEndX > 0 then
            local t3 = 0.8
            rect(buttonEndX, lineY, lineEndX - buttonEndX, lineThickness, 
                 getGradientColor(t3), 14, true, 0.8)
        end
        
        local bcx = math.floor(buttonX + buttonSize / 2)
        local bcy = math.floor(y + headerHeight / 2)
        local vAlpha = 1 - self.expandAnim
        rect(bcx - 2, bcy, 5, 1, THEME.text, 16, true, 1)
        if vAlpha > 0.01 then
            local bump = math.floor(2 * vAlpha)
            rect(bcx, bcy - bump, 1, bump * 2 + 1, THEME.text, 16, true, vAlpha)
        end

        currentSectionAlpha = prevSA

        if headerClipAlpha > 0.02 and mousePos and not (_activeKeybindMenu or _keybindMenuBlockUntilRelease or _modalBlockUntilRelease or _activeColorPicker) then
            local headerHit = mousePos.X >= x and mousePos.X <= x + width and
                             mousePos.Y >= y and mousePos.Y <= y + headerHeight
            
            if headerHit and _mouseJustPressed then
                self.collapsed = not self.collapsed
            end
        end
    end
    
    local currentY = y + headerHeight
    local totalHeight = headerHeight

    self.expandAnim = approach(self.expandAnim, self.collapsed and 0 or 1, 12)

    if self.expandAnim > 0.01 then
        local outerSectionAlpha = currentSectionAlpha
        currentSectionAlpha = outerSectionAlpha * self.expandAnim

        local contentEndY = currentY
        local interactive = self.expandAnim > 0.9
        local FADE_ZONE = 18 -- px over which an element fades in/out as it crosses the scroll clip edge
        for i, elem in ipairs(self.elements) do
            local elemX = x + sectionPadding + contentPadding
            local elemY = contentEndY + contentPadding
            local elemW = width - (sectionPadding * 2) - (contentPadding * 2)
            local estHeight = (elem.getHeight and elem:getHeight()) or 20
            local elemHeight

            if clipTop and elemY > clipBottom + FADE_ZONE then
                -- Fully past the bottom clip edge (with margin) — everything
                -- after this in the list is too, since elements are laid
                -- out top-to-bottom. Skip drawing but still tally heights.
                local actualH = elem:Render(-5000, -5000, elemW, nil)
                contentEndY = contentEndY + actualH + 2
                for j = i + 1, #self.elements do
                    local h = self.elements[j]:Render(-5000, -5000, elemW, nil)
                    contentEndY = contentEndY + h + 2
                end
                break
            elseif clipTop and (elemY + estHeight < clipTop - FADE_ZONE) then
                -- Fully past the top clip edge (with margin)
                elemHeight = elem:Render(-5000, -5000, elemW, nil)
            elseif clipTop then
                if elem._isDropdown then
                    -- Dropdown options calculate their own edge fade. Keeping
                    -- the parent control opaque avoids fading the whole list.
                    local elemMouse = (interactive and (not (_activeKeybindMenu or _keybindMenuBlockUntilRelease or _modalBlockUntilRelease or _activeColorPicker) or elem == _activeKeybindMenu or elem == _activeColorPicker or elem.colorPicker == _activeColorPicker or _mouseRightJustPressed)) and mousePos or nil
                    elemHeight = elem:Render(elemX, elemY, elemW, elemMouse, clipTop, clipBottom)
                else
                    local topD = elemY - clipTop
                    local botD = clipBottom - (elemY + estHeight)
                    local aTop = math.max(0, math.min(1, 1 + topD / FADE_ZONE))
                    local aBot = math.max(0, math.min(1, 1 + botD / FADE_ZONE))
                    local clipAlpha = math.min(aTop, aBot)

                    local prevSA = currentSectionAlpha
                    currentSectionAlpha = prevSA * clipAlpha
                    local elemMouse = (interactive and clipAlpha > 0.95 and (not (_activeKeybindMenu or _keybindMenuBlockUntilRelease or _modalBlockUntilRelease or _activeColorPicker) or elem == _activeKeybindMenu or elem == _activeColorPicker or elem.colorPicker == _activeColorPicker or _mouseRightJustPressed)) and mousePos or nil
                    elemHeight = elem:Render(elemX, elemY, elemW, elemMouse)
                    currentSectionAlpha = prevSA
                end
            else
                local elemMouse = (interactive and (not (_activeKeybindMenu or _keybindMenuBlockUntilRelease or _modalBlockUntilRelease or _activeColorPicker) or elem == _activeKeybindMenu or elem == _activeColorPicker or elem.colorPicker == _activeColorPicker or _mouseRightJustPressed)) and mousePos or nil
                elemHeight = elem:Render(elemX, elemY, elemW, elemMouse)
            end
            contentEndY = contentEndY + (elemHeight or 0) + 2
        end
        contentEndY = contentEndY + contentPadding

        local contentH = (contentEndY - currentY)
        local animH = math.max(0.5, contentH * self.expandAnim)
        local outlineColor = rgb(60, 60, 60)

        if not clipTop or (currentY < clipBottom and currentY + animH > clipTop) then
            local drawY = math.max(currentY, clipTop or currentY)
            local drawH = math.min(currentY + animH, clipBottom or (currentY + animH)) - drawY
            local borderH = math.min(currentY + animH, clipBottom or (currentY + animH)) - math.max(currentY, clipTop or currentY)
            rect(x + sectionPadding, drawY, width - (sectionPadding * 2), drawH,
                 THEME.sectionBg, 13, true, 0.4 * math.min(1, animH / 4))

            if not clipTop or currentY >= clipTop then
                rect(x + sectionPadding, currentY, width - (sectionPadding * 2), 1,
                     outlineColor, 14, true, 0.6)
            end
            if not clipTop or currentY + animH <= clipBottom then
                rect(x + sectionPadding, currentY + animH - 1, width - (sectionPadding * 2), 1,
                     outlineColor, 14, true, 0.6)
            end
            if borderH > 0 then
                rect(x + sectionPadding, math.max(currentY, clipTop or currentY), 1, borderH,
                     outlineColor, 14, true, 0.6)
                rect(x + width - sectionPadding - 1, math.max(currentY, clipTop or currentY), 1, borderH,
                     outlineColor, 14, true, 0.6)
            end
        end

        currentSectionAlpha = outerSectionAlpha

        totalHeight = headerHeight + animH
    else
        for _, elem in ipairs(self.elements) do
            elem:Render(-5000, -5000, width, nil)
        end
        totalHeight = headerHeight
    end
    
    return totalHeight
end

-- ===== Window class =====
local Window = {}
Window.__index = Window

function Window.new(config)
    local self = setmetatable({}, Window)
    self.x, self.y = 50, 50
    self.w = config.Width or 600
    self.footerH = 58
    self.h = (config.Height or 750) + self.footerH
    self.title = config.title or "Window"
    self.game = config.game or "Game"
    self.version = config.version or "1.0.0"
    self.build = config.build or "RELEASE"
    self.visible = true
    self.configFolder = config.ConfigFolder or config.configFolder or "ColaUI_configs"
    self.configBaseName = config.ConfigName or config.configName or "HavocConfig"
    self.configName = self.configBaseName
    self.autoSave = false
    self.autoLoad = false
    self.showWatermark = true
    self.showKeybindOverlay = true
    self.alpha = 1 -- animated fade (1 = fully shown, 0 = fully hidden)
    self.glowColor = THEME.accent
    
    -- Keybind system (toggle open/close), polled via iskeypressed every frame
    self.keybind = normalizeKey(config.Keybind) or "p"
    self.keybindVK = KEY_VK[self.keybind]
    self.lastKeybindState = false

    self.closeKeybind = normalizeKey(config.CloseKeybind) or "delete"
    self.closeKeybindVK = KEY_VK[self.closeKeybind]
    self.lastCloseKeybindState = false

    -- Logo (top-left of titlebar), loaded once from a URL
    self.logoUrl = config.Logo
    self.logoEnabled = self.logoUrl ~= nil and self.logoUrl ~= ""
    self.logoImage = nil
    self.logoSize = 22
    if self.logoUrl and self.logoUrl ~= "" then
        local spawnFn = (task and task.spawn) or spawn
        spawnFn(function()
            local raw
            pcall(function() raw = game:HttpGet(self.logoUrl) end)
            if raw and #raw > 24 then
                local h = 5381
                for i = 1, #self.logoUrl do h = (h * 33 + string.byte(self.logoUrl, i)) % 2147483648 end
                local cache = "cryptui_logo_" .. string.format("%08x", h) .. ".dat"
                pcall(function() writefile(cache, raw) end)
                local fixed
                pcall(function() fixed = readfile(cache) end)
                if fixed and #fixed > 24 then
                    local ok3, img = pcall(function()
                        local d = Drawing.new("Image")
                        d.Data = fixed
                        d.Size = Vector2.new(self.logoSize, self.logoSize)
                        d.Visible = false
                        return d
                    end)
                    if ok3 and img then
                        self.logoImage = img
                    end
                end
            end
        end)
    end

    -- Optional full-window background image. It uses the same raw Image.Data
    -- loading method as Logo and remains deliberately subtle behind controls.
    self.backgroundUrl = config.Background
    self.backgroundOpacity = tonumber(config.BackgroundOpacity) or 0.24
    -- The built-in Default config keeps the URL but starts the image disabled.
    self.backgroundEnabled = false
    self.backgroundImage = nil
    if self.backgroundUrl and self.backgroundUrl ~= "" then
        local spawnFn = (task and task.spawn) or spawn
        spawnFn(function()
            local raw; pcall(function() raw = game:HttpGet(self.backgroundUrl) end)
            if raw and #raw > 24 then
                local ok, img = pcall(function()
                    local d = Drawing.new("Image")
                    d.Data = raw; d.Visible = false; d.Rounding = 0
                    return d
                end)
                if ok and img then self.backgroundImage = img end
            end
        end)
    end
    -- Fixed footer data: populated asynchronously so UI startup never waits
    -- on the thumbnail or marketplace endpoints.
    self.avatarImage = nil
    self.playerName = "Player"
    self.userIdText = "N/A"
    self.placeIdText = "N/A"
    self.detectedGameName = "Loading game..."
    self.playerPrivacy = false
    self.playerPrivacyAlpha = 0
    do
        local spawnFn = (task and task.spawn) or spawn
        spawnFn(function()
            -- Full reference-style player identity and thumbnail loader.
            local function isImage(data)
                if not data or #data < 12 then return false end
                local a, b, c, d = string.byte(data, 1, 4)
                return (a == 0x89 and b == 0x50 and c == 0x4E and d == 0x47) or (a == 0xFF and b == 0xD8)
            end
            local function setAvatar(data)
                if not isImage(data) then return false end
                local image
                local ok = pcall(function()
                    image = Drawing.new("Image")
                    image.Data = data
                    image.Visible = false
                end)
                if ok and image then
                    if self.avatarImage then pcall(function() self.avatarImage:Remove() end) end
                    self.avatarImage = image
                    return true
                end
                return false
            end

            local waitFn = (task and task.wait) or wait
            local userId, userName
            for _ = 1, 30 do
                local player
                pcall(function() player = game:GetService("Players").LocalPlayer end)
                if player then
                    pcall(function()
                        if player.Name and player.Name ~= "" then userName = tostring(player.Name) end
                        userId = player.UserId
                    end)
                    if userName then self.playerName = userName end
                    if userId and userId ~= 0 then break end
                end
                if waitFn then waitFn(0.12) end
            end

            if (not userId or userId == 0) and userName then
                pcall(function()
                    local body = '{"usernames":["' .. userName .. '"],"excludeBannedUsers":false}'
                    local response
                    if httppost then
                        response = httppost("https://users.roblox.com/v1/usernames/users", body, "application/json")
                    elseif httprequest then
                        local result = httprequest({
                            Url = "https://users.roblox.com/v1/usernames/users",
                            Method = "POST",
                            Body = body,
                            Headers = { ["Content-Type"] = "application/json" },
                        })
                        response = result and (result.Body or result.body)
                    end
                    local id = response and string.match(response, '"id":%s*(%d+)')
                    if id then userId = tonumber(id) end
                end)
            end

            if userId and userId ~= 0 then
                self.userIdText = tostring(userId)
                local cache = "ColaUI_avatar_" .. tostring(userId) .. ".dat"
                if isfile and readfile then
                    local cached
                    pcall(function()
                        if isfile(cache) then cached = readfile(cache) end
                    end)
                    if setAvatar(cached) then userId = nil end
                end
                if userId then
                    local endpoints = {
                        "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. tostring(userId) .. "&size=150x150&format=Png&isCircular=false",
                        "https://thumbnails.roproxy.com/v1/users/avatar-headshot?userIds=" .. tostring(userId) .. "&size=150x150&format=Png&isCircular=false",
                        "https://thumbnails.roblox.com/v1/users/avatar-bust?userIds=" .. tostring(userId) .. "&size=150x150&format=Png&isCircular=false",
                    }
                    for _ = 1, 5 do
                        local loaded = false
                        for _, endpoint in ipairs(endpoints) do
                            pcall(function()
                                local meta = game:HttpGet(endpoint)
                                local imageUrl = meta and string.match(meta, '"imageUrl":"([^"]+)"')
                                if imageUrl and imageUrl ~= "" then
                                    local data = game:HttpGet(imageUrl:gsub("\\/", "/"))
                                    if setAvatar(data) then
                                        if writefile then pcall(function() writefile(cache, data) end) end
                                        loaded = true
                                    end
                                end
                            end)
                            if loaded then break end
                        end
                        if loaded then break end
                        if waitFn then waitFn(0.7) end
                    end
                end
            end

            pcall(function() self.placeIdText = tostring(game.PlaceId) end)
            local gameName
            pcall(function() gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end)
            if not gameName or gameName == "" then
                pcall(function()
                    local universe = game:HttpGet("https://apis.roblox.com/universes/v1/places/" .. tostring(game.PlaceId) .. "/universe")
                    local universeId = universe and universe:match('"universeId":%s*(%d+)')
                    if universeId then
                        local details = game:HttpGet("https://games.roblox.com/v1/games?universeIds=" .. universeId)
                        gameName = details and details:match('"name":"(.-)"')
                    end
                end)
            end
            if not gameName or gameName == "" then
                pcall(function() gameName = game.Name end)
            end
            if gameName and gameName ~= "" then self.detectedGameName = tostring(gameName) end
        end)
    end

    self.isDragging = false
    self.dragOffsetX = 0
    self.dragOffsetY = 0
    self.scrollY = 0
    self.scrollHeld = false
    self.scrollHover = 0

    self.tabs = {}
    self.selectedTab = nil
    self.tabHeight = 28
    
    self.tabSections = {}

    -- Auto-created settings page, opened via the gear icon (not a normal tab)
    self.viewingSettings = false
    self.lastGearPressed = false
    self.gearAnim = 0 -- 0 = idle grey, 1 = active blue+spun
    self.settingsTabData = { left = { Section.new("Settings") }, right = {} }
    local settingsSection = self.settingsTabData.left[1]
    settingsSection:Label("UI controls", { Background = false })
    self.uiKeybindControl = settingsSection:AddKeybind("UI Keybind", self.keybind, function(key)
        self.keybind = key
        self.keybindVK = KEY_VK[key]
        self.lastKeybindState = isKeyDown(self.keybindVK)
    end)
    local configSection = Section.new("Configs")
    table.insert(self.settingsTabData.left, configSection)
    -- The name field is intentionally blank. Select Default or type a new name;
    -- Default itself is built in and is never written over or deleted.
    local configName = configSection:AddTextbox("Name", "", function(value)
        self.configName = tostring(value or "")
        -- Never auto-save partial config names while the user is typing.
        self._suspendAutoSaveUntil = tick() + 1.25
    end, "Config name")
    configName.noSave = true
    local configDropdown
    local function refreshConfigs(selected)
        local choices = self:ListConfigs()
        configDropdown.options = choices
        configDropdown.selected = selected or configDropdown.selected or "Default"
        local found = false
        for _, choice in ipairs(choices) do if choice == configDropdown.selected then found = true break end end
        if not found then configDropdown.selected = "Default" end
    end
    configSection:AddActionButtons({
        { Text = "Save", Callback = function()
            local name = tostring(configName:GetValue() or "")
            if name ~= "" and string.lower(name) ~= "default" then self:SaveConfig(name); refreshConfigs(name) end
        end },
        { Text = "Load", Callback = function()
            local selected = configDropdown.selected or "Default"
            local name = configName:GetValue() ~= "" and configName:GetValue() or selected
            self:LoadConfig(name)
        end },
        { Text = "Delete", Callback = function()
            local name = configName:GetValue() ~= "" and configName:GetValue() or (configDropdown.selected or "Default")
            self:DeleteConfig(name); configName:SetValue("", true); refreshConfigs("Default")
        end },
    })
    configDropdown = configSection:AddDropdown("Config", { "Default" }, "Single", function(value)
        if not value then return end
        -- Selecting a name is not loading it. Keep configName pointing at the
        -- currently loaded config so Auto-save can never overwrite the choice.
        configName:SetValue(value == "Default" and "" or value, true)
        if self.autoLoad then self:SetAutoLoad(true, value) end
    end, "Default")
    configDropdown.noSave = true
    self.configNameBox, self.configDropdown = configName, configDropdown
    refreshConfigs("Default")
    self.autoSaveControl = configSection:AddCheckbox("Auto-save", function(value)
        self:SetAutoSave(value == true)
        if self.autoSave then self._lastAutoSaveSnapshot = nil; self._nextAutoSave = 0; self:PollAutoSave() end
    end, { Keybind = false })
    self.autoLoadControl = configSection:AddCheckbox("Auto-load", function(value)
        local enabled, selected = value == true, configDropdown.selected or "Default"
        self:SetAutoLoad(enabled, selected)
        if enabled then self:LoadConfig(selected) end
    end, { Keybind = false })
    self.autoSaveControl.noSave = true
    self.autoLoadControl.noSave = true
    local visibilitySection = Section.new("Overlays")
    table.insert(self.settingsTabData.left, visibilitySection)
    self.watermarkToggle = visibilitySection:AddCheckbox("Watermark", function(value) self.showWatermark = value == true; if self.watermark then self.watermark.visible = self.showWatermark end end, { Keybind = false })
    self.keybindOverlayToggle = visibilitySection:AddCheckbox("Keybind Overlay", function(value) self.showKeybindOverlay = value == true; if self.keybindOverlay then self.keybindOverlay.visible = self.showKeybindOverlay end end, { Keybind = false })
    self.watermarkToggle.checked, self.watermarkToggle.fillAnim = true, 1
    self.keybindOverlayToggle.checked, self.keybindOverlayToggle.fillAnim = true, 1
    local appearanceSection = Section.new("Appearance")
    table.insert(self.settingsTabData.left, appearanceSection)
    local backgroundToggle = appearanceSection:AddCheckbox("Background Image", function(value)
        self.backgroundEnabled = value == true
        if self.backgroundEnabled and not self.backgroundImage then self:SetBackgroundUrl(self.backgroundUrl) end
    end, { Keybind = false })
    backgroundToggle.checked, backgroundToggle.fillAnim = self.backgroundEnabled, self.backgroundEnabled and 1 or 0
    appearanceSection:AddTextbox("Background URL", self.backgroundUrl or "", function(value)
        self._pendingBackgroundUrl = tostring(value or "")
    end, "Image URL")
    local logoToggle = appearanceSection:AddCheckbox("Logo", function(value)
        self.logoEnabled = value == true
        if self.logoEnabled and not self.logoImage then self:SetLogoUrl(self.logoUrl) end
    end, { Keybind = false })
    logoToggle.checked, logoToggle.fillAnim = self.logoEnabled, self.logoEnabled and 1 or 0
    appearanceSection:AddTextbox("Logo URL", self.logoUrl or "", function(value)
        self._pendingLogoUrl = tostring(value or "")
    end, "Image URL")
    local visualSection = Section.new("Visual")
    table.insert(self.settingsTabData.right, visualSection)
    local function setThemeColor(name)
        return function(color) THEME[name] = color end
    end
    local function setGradientColor(name)
        return function(color)
            if name == "dark" then GRADIENT_DARK = color
            elseif name == "mid" then GRADIENT_MID = color
            elseif name == "bright" then GRADIENT_NORMAL = color
            else GRADIENT_END = color end
            gradientCache = {}
        end
    end
    local visualPickers = {}
    local function addThemePicker(label, key)
        visualPickers[key] = visualSection:AddColorPicker(label, THEME[key], setThemeColor(key))
    end
    addThemePicker("Background", "bg")
    addThemePicker("Title Background", "titleBg")
    addThemePicker("Text", "text")
    addThemePicker("Accent", "accent")
    addThemePicker("Toggle Fill", "toggle")
    addThemePicker("Dropdown Accent", "dropdownAccent")
    addThemePicker("Scrollbar", "scrollbar")
    addThemePicker("Scrollbar Hover", "scrollbarHover")
    addThemePicker("Window Border", "windowBorder")
    addThemePicker("Watermark Border", "watermarkBorder")
    addThemePicker("Slider Outline", "sliderOutline")
    addThemePicker("Slider Fill Outline", "sliderFillOutline")
    addThemePicker("Slider Handle", "sliderHandle")
    addThemePicker("Tab Inactive", "tabInactive")
    addThemePicker("Tab Active", "tabActive")
    addThemePicker("Section Background", "sectionBg")
    addThemePicker("Line Color", "lineColor")
    visualSection:AddDivider("GRADIENT")
    visualPickers.gradientDark = visualSection:AddColorPicker("Gradient Dark", GRADIENT_DARK, setGradientColor("dark"))
    visualPickers.gradientMid = visualSection:AddColorPicker("Gradient Mid", GRADIENT_MID, setGradientColor("mid"))
    visualPickers.gradientBright = visualSection:AddColorPicker("Gradient Bright", GRADIENT_NORMAL, setGradientColor("bright"))
    visualPickers.gradientEnd = visualSection:AddColorPicker("Gradient End", GRADIENT_END, setGradientColor("end"))
    visualSection:AddButton("Reset Defaults", function()
        for key, color in pairs(THEME_DEFAULTS) do
            THEME[key] = color
            if visualPickers[key] then visualPickers[key]:SetValue(color, true) end
        end
        GRADIENT_DARK, GRADIENT_MID = GRADIENT_DEFAULTS.dark, GRADIENT_DEFAULTS.mid
        GRADIENT_NORMAL, GRADIENT_END = GRADIENT_DEFAULTS.bright, GRADIENT_DEFAULTS.finish
        visualPickers.gradientDark:SetValue(GRADIENT_DARK, true)
        visualPickers.gradientMid:SetValue(GRADIENT_MID, true)
        visualPickers.gradientBright:SetValue(GRADIENT_NORMAL, true)
        visualPickers.gradientEnd:SetValue(GRADIENT_END, true)
        gradientCache = {}
    end)

    -- Content cross-fade (tab switching / settings toggle no longer insta-swaps)
    self.contentAlpha = 1
    self.contentFading = false -- true while fading OUT toward a pending swap
    self.pendingTab = nil
    self.pendingSettings = nil

    self.lastMousePressed = false

    return self
end

function Window:Center()
    local viewport = Vector2.new(1920, 1080)
    pcall(function() viewport = workspace.CurrentCamera.ViewportSize end)
    self.x = math.max(0, math.floor((viewport.X - self.w) / 2))
    self.y = math.max(0, math.floor((viewport.Y - self.h) / 2))
    return self
end
function Window:SetPosition(x, y) self.x, self.y = x, y return self end
function Window:SetSize(w, h) self.w, self.h = w, h + self.footerH return self end
function Window:SetTitle(t) self.title = tostring(t) return self end
function Window:Show() self.visible = true return self end
function Window:Hide()
    if _activeTextBox then _activeTextBox:Blur() end
    -- Close every inline dropdown search too; otherwise its focus loop can
    -- immediately disable Roblox input again during the fade-out frame.
    local groups = { self.tabSections, { self.settingsTabData } }
    for _, tabs in ipairs(groups) do
        for _, columns in pairs(tabs) do
            for _, sections in pairs(columns) do
                for _, section in ipairs(sections) do
                    for _, element in ipairs(section.elements) do
                        if getmetatable(element) == Dropdown then element.inputFocused = false end
                    end
                end
            end
        end
    end
    _activeTextBox, _textInputCount, _textInputLock = nil, 0, false
    self.visible = false
    _uiInputCaptured = false
    pcall(setrobloxinput, true)
    return self
end

function Window:AddTab(name)
    table.insert(self.tabs, {name = name, active = false, hoverAnim = 0, activeAnim = 0, lastPressed = false})
    if not self.selectedTab then
        self.selectedTab = 1
        self.tabs[1].active = true
    end
    self.tabSections[#self.tabs] = { left = {}, right = {} }
    return self
end

function Window:AddLeftSection(tabIndex, name)
    if not self.tabSections[tabIndex] then
        self.tabSections[tabIndex] = { left = {}, right = {} }
    end
    local section = Section.new(name)
    table.insert(self.tabSections[tabIndex].left, section)
    return section
end

function Window:AddRightSection(tabIndex, name)
    if not self.tabSections[tabIndex] then
        self.tabSections[tabIndex] = { left = {}, right = {} }
    end
    local section = Section.new(name)
    table.insert(self.tabSections[tabIndex].right, section)
    return section
end

function Window:SelectTab(index)
    -- Ignore the already-selected tab. It avoids restarting the content
    -- transition and causing the old flash.
    if self.selectedTab == index and not self.viewingSettings then return self end
    self.viewingSettings = false
    if self.tabs[self.selectedTab] then
        self.tabs[self.selectedTab].active = false
    end
    self.selectedTab = index
    if self.tabs[index] then
        self.tabs[index].active = true
    end
    self.pendingTab = nil
    self.pendingSettings = false
    self.contentFading = false
    self.contentAlpha = 1
    return self
end

function Window:SetBackgroundUrl(url)
    self.backgroundUrl = tostring(url or "")
    self._backgroundLoadId = (self._backgroundLoadId or 0) + 1
    local loadId = self._backgroundLoadId
    if self.backgroundImage then pcall(function() self.backgroundImage:Remove() end); self.backgroundImage = nil end
    if self.backgroundUrl == "" then return self end
    local spawnFn = (task and task.spawn) or spawn
    spawnFn(function()
        local raw; pcall(function() raw = game:HttpGet(self.backgroundUrl) end)
        if loadId ~= self._backgroundLoadId or not raw or #raw <= 24 then return end
        local ok, image = pcall(function()
            local d = Drawing.new("Image")
            d.Data = raw; d.Visible = false; d.Rounding = 0
            return d
        end)
        if ok and image then
            if loadId == self._backgroundLoadId then self.backgroundImage = image else pcall(function() image:Remove() end) end
        end
    end)
    return self
end

function Window:SetLogoUrl(url)
    self.logoUrl = tostring(url or "")
    self._logoLoadId = (self._logoLoadId or 0) + 1
    local loadId = self._logoLoadId
    if self.logoImage then pcall(function() self.logoImage:Remove() end); self.logoImage = nil end
    if self.logoUrl == "" then return self end
    local spawnFn = (task and task.spawn) or spawn
    spawnFn(function()
        local raw; pcall(function() raw = game:HttpGet(self.logoUrl) end)
        if loadId ~= self._logoLoadId or not raw or #raw <= 24 then return end
        local ok, image = pcall(function()
            local d = Drawing.new("Image")
            d.Data = raw; d.Size = Vector2.new(self.logoSize, self.logoSize); d.Visible = false
            return d
        end)
        if ok and image then
            if loadId == self._logoLoadId then self.logoImage = image else pcall(function() image:Remove() end) end
        end
    end)
    return self
end

function Window:Destroy()
    _uiInputCaptured = false
    pcall(setrobloxinput, true)
    self.visible = false
    if self.keybindOverlay then self.keybindOverlay:Destroy() end
    if self.logoImage then
        pcall(function() self.logoImage:Remove() end)
        self.logoImage = nil
    end
    if self.backgroundImage then pcall(function() self.backgroundImage:Remove() end); self.backgroundImage = nil end
    if self.avatarImage then
        pcall(function() self.avatarImage:Remove() end)
        self.avatarImage = nil
    end
    for i, w in ipairs(windows) do
        if w == self then table.remove(windows, i) break end
    end
    if #windows == 0 and #notifications == 0 then
        stopRender()
        for i, d in ipairs(pool) do
            local c = poolCache[i]
            if c and c.visible ~= false then c.visible = false; d.Visible = false end
        end
    end
end

function Window:HasTextFocus()
    if isAnyTextInputFocused() then return true end
    local groups = { self.tabSections, { self.settingsTabData } }
    for _, tabs in ipairs(groups) do for _, columns in pairs(tabs) do for _, sections in pairs(columns) do for _, section in ipairs(sections) do for _, element in ipairs(section.elements) do
        if getmetatable(element) == Textbox and element.focused then return true end
        if getmetatable(element) == Dropdown and element.inputFocused then return true end
    end end end end end
    return false
end

function Window:ApplyPendingAppearanceUrls()
    -- Image downloads are intentionally deferred until text editing ends.
    if self._pendingBackgroundUrl ~= nil then
        local url = self._pendingBackgroundUrl
        self._pendingBackgroundUrl = nil
        if url ~= self.backgroundUrl then self:SetBackgroundUrl(url) end
    end
    if self._pendingLogoUrl ~= nil then
        local url = self._pendingLogoUrl
        self._pendingLogoUrl = nil
        if url ~= self.logoUrl then self:SetLogoUrl(url) end
    end
end

function Window:PollHiddenKeybinds()
    local groups = { self.tabSections, { self.settingsTabData } }
    for _, tabs in ipairs(groups) do for _, columns in pairs(tabs) do for _, sections in pairs(columns) do for _, section in ipairs(sections) do for _, element in ipairs(section.elements) do
        if getmetatable(element) == Checkbox then element:PollKeybindAction()
        elseif getmetatable(element) == Keybind and element ~= self.uiKeybindControl then element:Poll() end
    end end end end end
end
function Window:Render()
    -- Poll keybinds (works even while the window is faded out)
    -- Match the reference: focus consumes the menu key completely.
    local hasFocus = self:HasTextFocus()
    if not hasFocus then self:ApplyPendingAppearanceUrls() end
    local toggleDown = isKeyDown(self.keybindVK)
    if hasFocus then
        self.lastKeybindState = toggleDown
    else
        if toggleDown and not self.lastKeybindState then
            if self.visible then self:Hide() else self:Show() end
        end
        self.lastKeybindState = toggleDown
    end

    local closeDown = hasFocus and false or isKeyDown(self.closeKeybindVK)
    if closeDown and not self.lastCloseKeybindState then
        self:Destroy()
        return
    end
    self.lastCloseKeybindState = closeDown

    -- Fade animation toward the desired visible state
    self.alpha = approach(self.alpha, self.visible and 1 or 0, 20)
    if self.alpha <= 0.003 and not self.visible then return end

    currentRenderAlpha = self.alpha
    currentSectionAlpha = 1
    -- Only allow mouse interaction once we're mostly faded in, so clicks
    -- don't land on a window that's still animating away
    local interactive = self.alpha > 0.5

    local x, y, w, h = self.x, self.y, self.w, self.h

    -- Keep the outer glow close to the frame instead of letting it spill far
    -- into the game view, especially now that the footer extends the window.
    for i = 3, 1, -1 do
        local gs = i
        local ga = (0.18 * (4 - i)) / 3
        rect(x - gs, y - gs, w + gs * 2, h + gs * 2,
             THEME.accent, 0, true, ga)
    end

    rect(x, y, w, h, THEME.bg, 5, true, 1)
    if self.backgroundImage then
        local ok = pcall(function()
            self.backgroundImage.Position = Vector2.new(x + 1, y + 1)
            self.backgroundImage.Size = Vector2.new(w - 2, h - 2)
            self.backgroundImage.ZIndex = 6
            self.backgroundImage.Transparency = self.backgroundOpacity * currentRenderAlpha
            self.backgroundImage.Visible = self.backgroundEnabled and self.alpha > 0.01
        end)
        if not ok then self.backgroundImage = nil end
    end

    rect(x, y, w, 32, THEME.titleBg, 12, true, 1)

    if self.logoImage then
        local ok = pcall(function()
            self.logoImage.Position = Vector2.new(x + 8, y + (32 - self.logoSize) / 2)
            self.logoImage.Size = Vector2.new(self.logoSize, self.logoSize)
            self.logoImage.ZIndex = 13
            self.logoImage.Transparency = currentRenderAlpha
            self.logoImage.Visible = self.logoEnabled and self.alpha > 0.01
        end)
        if not ok then self.logoImage = nil end
    end

    local fontSize = 12

    local full_title_text = self.title .. " " .. self.game .. " " .. self.version .. " | " .. self.build

    local t_obj, t_cache = txt(full_title_text, 0, y + 8, THEME.text, fontSize, 13, 1)

    if t_obj then
        local leftBound = x + (self.logoImage and 30 or 0)
        local rightBound = x + w - 18
        local titleX = (leftBound + rightBound) / 2
        local titleY = y + (32 - fontSize) / 2 + 3
        if t_cache.center ~= true then t_cache.center = true; t_obj.Center = true end
        if t_cache.x ~= titleX or t_cache.y ~= titleY then t_cache.x, t_cache.y = titleX, titleY; t_obj.Position = Vector2.new(titleX, titleY) end
    end

    -- Settings gear icon, top-right of the titlebar
    local mousePosForGear = interactive and not self.isDragging and not (_activeKeybindMenu or _keybindMenuBlockUntilRelease or _modalBlockUntilRelease or _activeColorPicker) and self:GetMousePos() or nil
    self.gearAnim = approach(self.gearAnim, self.viewingSettings and 1 or 0, 8)

    local gearR = 6
    local gearX = x + w - 18
    local gearY = y + 16
    local gearIdle = rgb(150, 150, 150)
    local gearColor = lerpColor(gearIdle, THEME.accent, self.gearAnim)
    local gearAngle = self.gearAnim * math.pi -- half turn as it spins up to active

    -- Ring (gear body)
    circle(gearX, gearY, gearR, gearColor, 16, false, 1, 2)

    -- Blocky teeth around the ring
    local teethCount = 8
    local toothLen = 3
    local toothThick = 2.4
    for i = 0, teethCount - 1 do
        local ang = gearAngle + (i / teethCount) * math.pi * 2
        local innerR = gearR + 0.5
        local outerR = gearR + 0.5 + toothLen
        local x1 = gearX + math.cos(ang) * innerR
        local y1 = gearY + math.sin(ang) * innerR
        local x2 = gearX + math.cos(ang) * outerR
        local y2 = gearY + math.sin(ang) * outerR
        line(x1, y1, x2, y2, gearColor, 16, 1, toothThick)
    end

    -- Small circle (unfilled)
    circle(gearX, gearY, 2.5, gearColor, 17, false, 1, 1)

    if mousePosForGear then
        local isPressed = self:IsMousePressed()
        local dx = mousePosForGear.X - gearX
        local dy = mousePosForGear.Y - gearY
        local maxRadius = gearR + 0.5 + toothLen + 2
        local hovered = (dx * dx + dy * dy) <= (maxRadius * maxRadius)
        if hovered and _mouseJustPressed then
            self.pendingSettings = not self.viewingSettings
            self.pendingTab = self.selectedTab
            self.contentFading = true
        end
    end

    local tabBarY = y + 32
    local tabBarH = self.tabHeight

    rect(x, tabBarY, w, tabBarH, rgb(20, 20, 20), 10, true, 1)

    rect(x, tabBarY + tabBarH - 1, w, 1, rgb(50, 50, 50), 11, true, 1)

    local tabSpacing = 2
    local fixedTabWidth = 110
    local mousePos = interactive and self:GetMousePos() or nil
    local elementMouse = interactive and not self.isDragging and mousePos or nil

    local totalTabWidth = (fixedTabWidth * #self.tabs) + (tabSpacing * (#self.tabs - 1))

    local tabStartX = x + (w - totalTabWidth) / 2
    local currentTabX = tabStartX

    for tabIdx, tab in ipairs(self.tabs) do
        local baseX = currentTabX
        local tabY = tabBarY + 2
        local baseW = fixedTabWidth
        local baseH = tabBarH - 4

        local isHoveredNow = elementMouse ~= nil
            and elementMouse.X >= baseX and elementMouse.X <= baseX + baseW
            and elementMouse.Y >= tabY and elementMouse.Y <= tabY + baseH

        tab.activeAnim = approach(tab.activeAnim or 0, (tab.active and not self.viewingSettings) and 1 or 0, 14)
        tab.hoverAnim = approach(tab.hoverAnim or 0, (isHoveredNow and not tab.active) and 1 or 0, 14)

        -- Selected tab grows slightly, staying centered on its slot
        local growW = 6 * tab.activeAnim
        local growH = 3 * tab.activeAnim
        local tabW = baseW + growW
        local tabH = baseH + growH
        local tabX = baseX - growW / 2
        local tabDrawY = tabY - growH / 2

        local hoverColor = rgb(60, 60, 60)
        local tabColor = lerpColor(THEME.tabInactive, hoverColor, tab.hoverAnim)
        tabColor = lerpColor(tabColor, THEME.tabActive, tab.activeAnim)
        local textColor = THEME.text

        rect(tabX, tabDrawY, tabW, tabH, tabColor, 11, true, 0.7 + 0.3 * tab.activeAnim)
        if tab.activeAnim > 0.01 then
            local segs = math.max(2, tabW)
            local ga = tab.activeAnim * 0.6
            for i = 0, segs - 1 do
                local t = i / (segs - 1)
                local segX = math.floor(tabX + tabW * i / segs)
                local segEnd = tabX + tabW * (i + 1) / segs
                local segW = math.max(1, math.floor(segEnd) - segX)
                rect(segX, tabDrawY, segW, tabH, getGradientColor(t), 12, true, ga)
            end
        end

        local estTextWidth = #tab.name * 7.2
        local textX = tabX + (tabW - estTextWidth) / 2
        local textY = tabDrawY + (tabH - 10) / 2
        txt(tab.name, textX, textY, textColor, 11, 13, 1)

        if mousePos then
            local isPressed = self:IsMousePressed()

            if isHoveredNow and _mouseJustPressed and not (_activeKeybindMenu or _keybindMenuBlockUntilRelease or _modalBlockUntilRelease or _activeColorPicker) then
                self:SelectTab(tabIdx)
                self.pendingSettings = false
            end
        end

        currentTabX = currentTabX + baseW + tabSpacing
    end

    local contentPaddingSides = 8
    local contentPaddingTop = 6
    local contentX = x + contentPaddingSides
    local contentY = y + 32 + tabBarH + contentPaddingTop
    local contentW = w - (contentPaddingSides * 2)
    local contentFooterGap = 1
    local contentH = h - 32 - tabBarH - contentPaddingTop - self.footerH - contentFooterGap
    
    local innerBorderColor = rgb(40, 40, 40)
    local innerBorderThickness = 1
    -- Keep fading content safely inside the tab frame on both edges.
    local contentClipTop = contentY + 10
    local contentClipBottom = contentY + contentH - innerBorderThickness - 10
    rect(contentX, contentY, contentW, innerBorderThickness, innerBorderColor, 14, true, 1)
    rect(contentX, contentY + contentH - innerBorderThickness, contentW, innerBorderThickness, innerBorderColor, 14, true, 1)
    rect(contentX, contentY, innerBorderThickness, contentH, innerBorderColor, 14, true, 1)
    rect(contentX + contentW - innerBorderThickness, contentY, innerBorderThickness, contentH, innerBorderColor, 14, true, 1)
    
    -- Content cross-fade: fade the outgoing tab/settings view out, swap the
    -- underlying data once invisible, then fade the new one back in. This
    -- replaces the old instant swap.
    self.contentAlpha = approach(self.contentAlpha, self.contentFading and 0 or 1, 22)
    if self.contentFading and self.contentAlpha <= 0.03 then
        if self.pendingSettings ~= nil then
            self.viewingSettings = self.pendingSettings
            self.pendingSettings = nil
        end
        self.pendingTab = nil
        self.contentFading = false -- now approach back toward 1 (fade in)
    end
    local contentFadeAlpha = math.max(0, self.contentAlpha)
    -- Content only becomes clickable once it's mostly faded in, same idea
    -- as the window-level interactive gate above.
    local contentInteractive = contentFadeAlpha > 0.6
    local elementMouseFaded = contentInteractive and elementMouse or nil

    local activeTabSections = nil
    if self.viewingSettings then
        activeTabSections = self.settingsTabData
    elseif self.selectedTab and self.tabSections[self.selectedTab] then
        activeTabSections = self.tabSections[self.selectedTab]
    end

    if activeTabSections then
        local prevSectionAlpha = currentSectionAlpha
        currentSectionAlpha = currentSectionAlpha * contentFadeAlpha

        local columnWidth = (contentW - 4 - 8) / 2
        local colPadding = 4
        local leftX = contentX
        local rightX = contentX + columnWidth + colPadding
        
        local renderY = contentY - self.scrollY
        local leftHeight = 0
        
        for _, section in ipairs(activeTabSections.left) do
            local sectionHeight = section:Render(leftX, renderY, columnWidth, elementMouseFaded, contentClipTop, contentClipBottom)
            renderY = renderY + sectionHeight + 4
            leftHeight = leftHeight + sectionHeight + 4
        end
        
        renderY = contentY - self.scrollY
        local rightHeight = 0
        
        for _, section in ipairs(activeTabSections.right) do
            local sectionHeight = section:Render(rightX, renderY, columnWidth, elementMouseFaded, contentClipTop, contentClipBottom)
            renderY = renderY + sectionHeight + 4
            rightHeight = rightHeight + sectionHeight + 4
        end

        currentSectionAlpha = prevSectionAlpha

        -- Total content height for scrolling (without scroll offset)
        local totalContentH = math.max(leftHeight, rightHeight)
        local scrollMax = math.max(0, totalContentH - contentH)
        self.scrollY = math.max(0, math.min(self.scrollY or 0, scrollMax))

        -- Scrollbar (only when content overflows)
        if scrollMax > 0 then
            local sbW = 7
            local sbX = contentX + contentW - sbW - 2
            local trackY = contentY
            local trackH = contentH
            local thumbH = math.max(10, trackH * (contentH / totalContentH))
            local thumbY = trackY + (trackH - thumbH) * (self.scrollY / scrollMax)
            local sbCol = THEME.scrollbar
            local sbColBright = THEME.scrollbarHover

            -- Hover detection (wider hit area)
            local hitX = sbX - 6
            local hitW = sbW + 12
            local onTrack = elementMouse and elementMouse.X >= hitX and elementMouse.X <= hitX + hitW and elementMouse.Y >= trackY and elementMouse.Y <= trackY + trackH
            local onThumb = elementMouse and elementMouse.X >= sbX - 3 and elementMouse.X <= sbX + sbW + 3 and elementMouse.Y >= thumbY and elementMouse.Y <= thumbY + thumbH
            -- While actively dragging, treat it as "hovered" even if the
            -- cursor drifts off the thin thumb hitbox (easy to do with a
            -- fast drag) so the glow/brighten doesn't drop out mid-scroll.
            local onThumbEffective = onThumb or self.scrollHeld

            self.scrollHover = approach(self.scrollHover or 0, (onTrack or self.scrollHeld) and 1 or 0, 10)
            self.scrollThumbHover = approach(self.scrollThumbHover or 0, onThumbEffective and 1 or 0, 10)
            local hover = self.scrollHover or 0
            local thumbHover = self.scrollThumbHover or 0
            local held = self.scrollHeld and 1 or 0

            -- Track (brightens slightly on hover)
            local trackCol = lerpColor(rgb(30, 30, 30), rgb(45, 45, 45), hover)
            rect(sbX, trackY, sbW, trackH, trackCol, 14, true, 0.5 + hover * 0.15)

            -- Glow: a few thin layered rects fading outward around the thumb,
            -- same idea as the window's own edge glow, instead of one flat
            -- oversized rect that just read as a big solid smear.
            local glowStrength = thumbHover * 0.6 + held * 0.6
            if glowStrength > 0.02 then
                for i = 3, 1, -1 do
                    local expand = i * 1.6
                    local layerA = glowStrength * (0.05 * (4 - i))
                    rect(sbX - expand, thumbY - expand, sbW + expand * 2, thumbH + expand * 2,
                         sbCol, 15, true, layerA)
                end
            end

            -- Thumb (brightens toward a lighter blue on hover/hold, plus a subtle grow)
            local thumbCol = lerpColor(sbCol, sbColBright, math.min(1, thumbHover * 0.6 + held * 0.4))
            local thumbGrow = thumbHover * 0.5 + held * 0.5
            rect(sbX - thumbGrow / 2, thumbY, sbW + thumbGrow, thumbH, thumbCol, 18, true, 0.85 + thumbHover * 0.15)

            -- Scrollbar interaction:
            --  - grabbing the thumb drags it relative to where you grabbed
            --    it (no snapping the thumb under the cursor)
            --  - clicking empty track pages the view toward the click
            --    instead of teleporting the thumb's middle to the cursor
            if onTrack and _mouseJustPressed then
                if onThumb then
                    self.scrollHeld = true
                    self.scrollDragStartY = elementMouse.Y
                    self.scrollDragStartScrollY = self.scrollY
                else
                    if elementMouse.Y < thumbY then
                        self.scrollY = math.max(0, self.scrollY - contentH)
                    else
                        self.scrollY = math.min(scrollMax, self.scrollY + contentH)
                    end
                end
            end
            if self.scrollHeld then
                local mp = self:GetMousePos()
                if mp and self:IsMousePressed() then
                    local deltaY = mp.Y - (self.scrollDragStartY or mp.Y)
                    local deltaScroll = deltaY * (totalContentH / trackH)
                    self.scrollY = math.max(0, math.min(scrollMax, (self.scrollDragStartScrollY or self.scrollY) + deltaScroll))
                else
                    self.scrollHeld = false
                end
            end

            -- Window mouse wheel scroll (remaining after dropdowns)
            local wDir = _dropdownWheel or 0
            if wDir ~= 0 then
                if elementMouse and elementMouse.Y >= contentY and elementMouse.Y <= contentY + contentH then
                    self.scrollY = math.max(0, math.min(scrollMax, self.scrollY - wDir * 30))
                end
                _dropdownWheel = 0
            end
        end
    end

    -- Fixed window footer (outside of, and independent from, tab content).
    local footerH = self.footerH
    local footerX, footerY = x + 8, y + h - footerH + 6
    local footerW, footerInnerH = w - 16, footerH - 12
    local footerBorder = rgb(55, 55, 55)
    rect(footerX, footerY, footerW, footerInnerH, rgb(18, 18, 18), 14, true, 0.96, 4)
    rect(footerX, footerY, footerW, footerInnerH, footerBorder, 15, false, 0.75, 4)

    local splitX = footerX + math.floor(footerW * 0.42)
    rect(splitX, footerY + 5, 1, footerInnerH - 10, footerBorder, 15, true, 0.6)

    local avatarX, avatarY, avatarSize = footerX + 8, footerY + 7, 32
    rect(avatarX, avatarY, avatarSize, avatarSize, rgb(28, 28, 28), 16, true, 1, 16)
    if self.avatarImage then
        local ok = pcall(function()
            self.avatarImage.Position = Vector2.new(avatarX, avatarY)
            self.avatarImage.Size = Vector2.new(avatarSize, avatarSize)
            self.avatarImage.ZIndex = 17
            self.avatarImage.Transparency = currentRenderAlpha
            self.avatarImage.Rounding = 16
            self.avatarImage.Visible = self.alpha > 0.01
        end)
        if not ok then self.avatarImage = nil end
    else
        circle(avatarX + avatarSize / 2, avatarY + avatarSize / 2, 11, THEME.accent, 17, false, 0.8, 1)
    end

    local playerName = tostring(self.playerName or "Player")
    txt("PLAYER", avatarX + avatarSize + 8, footerY + 9, rgb(140, 140, 140), 8, 17, 0.9)
    txt(playerName, avatarX + avatarSize + 8, footerY + 16, THEME.text, 11, 17, 1)
    txt("USER ID: " .. tostring(self.userIdText or "N/A"), avatarX + avatarSize + 8, footerY + 27, rgb(170, 170, 170), 8, 17, 0.9)

    -- Click the player panel to fade a black privacy cover over it for
    -- screenshots; click it again to reveal it.
    local playerPanelW = splitX - footerX
    local onPlayerPanel = mousePos and mousePos.X >= footerX and mousePos.X <= splitX and mousePos.Y >= footerY and mousePos.Y <= footerY + footerInnerH
    if onPlayerPanel and _mouseJustPressed then
        self.playerPrivacy = not self.playerPrivacy
    end
    self.playerPrivacyAlpha = approach(self.playerPrivacyAlpha or 0, self.playerPrivacy and 1 or 0, 14)
    rect(footerX + 1, footerY + 1, playerPanelW - 1, footerInnerH - 2,
         rgb(0, 0, 0), 19, true, self.playerPrivacyAlpha * 0.98, 4)
    -- A smaller framed clock tab sits independently to the right of the
    -- detected game information and uses the executor PC's local time.
    local clockW, clockH = 78, 32
    local clockX, clockY = footerX + footerW - clockW - 7, footerY + 7
    rect(clockX, clockY, clockW, clockH, rgb(22, 22, 22), 16, true, 0.95, 4)
    rect(clockX, clockY, clockW, clockH, footerBorder, 17, false, 0.7, 4)
    local localTime = os.date("%I:%M %p")
    txt("LOCAL TIME", clockX + 9, clockY + 5, rgb(140, 140, 140), 7, 18, 0.9)
    txt(localTime, clockX + 10, clockY + 17, THEME.text, 10, 18, 1)

    local infoX = splitX + 12
    local gameName = tostring(self.detectedGameName or "Loading game...")
    if #gameName > 25 then gameName = string.sub(gameName, 1, 24) .. "..." end
    txt("CURRENT GAME", infoX, footerY + 7, rgb(140, 140, 140), 8, 17, 0.9)
    txt(gameName, infoX, footerY + 18, THEME.text, 10, 17, 1)
    txt("PLACE ID: " .. tostring(self.placeIdText or "N/A"), infoX, footerY + 31, rgb(170, 170, 170), 9, 17, 0.9)
    local titleBarX, titleBarY, titleBarW, titleBarH = x, y, w, 32

    if mousePos then
        local titleBarHovered = mousePos.X >= titleBarX and mousePos.X <= titleBarX + titleBarW and
                               mousePos.Y >= titleBarY and mousePos.Y <= titleBarY + titleBarH
        local gearDx = mousePos.X - gearX
        local gearDy = mousePos.Y - gearY
        local onGear = gearDx * gearDx + gearDy * gearDy < 144

        if self:IsMousePressed() then
            if titleBarHovered and not onGear and not self.isDragging and not _anyUIDragging then
                self.isDragging = true
                _anyUIDragging = true
                self.dragOffsetX = mousePos.X - self.x
                self.dragOffsetY = mousePos.Y - self.y
            end
        else
            if self.isDragging then
                _anyUIDragging = false
            end
            self.isDragging = false
        end
        
        if self.isDragging then
            local vpX, vpY = 1920, 1080
            local ok, cam = pcall(function() return workspace.CurrentCamera end)
            if ok and cam and cam.ViewportSize then
                vpX, vpY = cam.ViewportSize.X, cam.ViewportSize.Y
            end
            
            local newX = mousePos.X - self.dragOffsetX
            local newY = mousePos.Y - self.dragOffsetY
            
            newX = math.max(0, math.min(newX, vpX - self.w))
            newY = math.max(0, math.min(newY, vpY - self.h))
            
            self.x = newX
            self.y = newY
        end
    end

    local outlineColor = THEME.windowBorder
    local borderThickness = 2
    rect(x, y, w, borderThickness, outlineColor, 20, true, 1)
    rect(x, y + h - borderThickness, w, borderThickness, outlineColor, 20, true, 1)
    rect(x, y, borderThickness, h, outlineColor, 20, true, 1)
    rect(x + w - borderThickness, y, borderThickness, h, outlineColor, 20, true, 1)

    local lineY = math.floor(y + 24)
    local lineHeight = 1
    local segments = 80
    local lineInset = 40
    local lineStartX = x + lineInset
    local lineWidth = w - (lineInset * 2)

    for i = 0, segments - 1 do
        local t = i / (segments - 1)
        local color = getGradientColor(t)

        local segmentXRaw = lineStartX + (lineWidth * i / segments)
        local segmentXEnd = lineStartX + (lineWidth * (i + 1) / segments)
        local segmentX = math.floor(segmentXRaw)
        local segmentW = math.max(1, math.floor(segmentXEnd) - segmentX)
        rect(segmentX, lineY, segmentW, lineHeight, color, 14, true, 1)
    end
    
    if mousePos then
        self.lastMousePressed = self:IsMousePressed()
    end
end

function Window:IsMousePressed()
    return _mouseDown
end

function Window:GetMousePos()
    return _frameMousePos
end

-- ===== Watermark class =====
local Watermark = {}
Watermark.__index = Watermark

function Watermark.new(config)
    local self = setmetatable({}, Watermark)
    self.text = config.text or config.title or "FAL.LOL"
    self.x = config.x or 20
    self.y = config.y or 20
    self.visible = true
    self.isDragging = false
    self.lastMousePressed = false
    return self
end

function Watermark:Render()
    if not self.visible then return end
    currentRenderAlpha = 1

    local fontSize = 12
    local h = 28

    local x, y = self.x, self.y

    local pad = 3
    local extra = 0
    local textObj, textCache = txt(self.text, x, y + h / 2, THEME.text, fontSize, 30, 1)
    local textW = textObj and textObj.TextBounds and textObj.TextBounds.X
    if not textW or textW <= 1 then textW = #self.text * 7.44 + 5 end

    local w = textW + pad * 2 + extra
    self.renderW, self.renderH = w, h
    local textX, textY = x + w / 2, y + h / 2
    if textCache.center ~= true then textCache.center = true; textObj.Center = true end
    if textCache.x ~= textX or textCache.y ~= textY then textCache.x, textCache.y = textX, textY; textObj.Position = Vector2.new(textX, textY) end

    local mousePos = self:GetMousePos()
    local isPressed = false
    if mousePos then
        isPressed = _mouseDown
    end

    rect(x, y, w, h, THEME.bg, 21, true, 0.95)

    local borderColor = THEME.watermarkBorder
    local bt = 1
    rect(x, y, w, bt, borderColor, 22, true, 0.8)
    rect(x, y + h - bt, w, bt, borderColor, 22, true, 0.8)
    rect(x, y, bt, h, borderColor, 22, true, 0.8)
    rect(x + w - bt, y, bt, h, borderColor, 22, true, 0.8)

    for i = 3, 1, -1 do
        local gs = i * 1.2
        local ga = (0.2 * (4 - i)) / 3
        rect(x - gs, y - gs, w + gs * 2, h + gs * 2, THEME.accent, 20, true, ga)
    end

    local textLineY = math.floor(y + h / 2 + fontSize / 2 + 2)
    local txtSegX = x + (w - textW) / 2
    local txtSegEnd = x + (w + textW) / 2
    local txtSegments = math.max(4, math.floor(textW / 3))
    for i = 0, txtSegments - 1 do
        local t = i / (txtSegments - 1)
        local segX = math.floor(txtSegX + textW * i / txtSegments)
        local segEnd = txtSegX + textW * (i + 1) / txtSegments
        local segW = math.max(1, math.floor(segEnd) - segX)
        rect(segX, textLineY, segW, 2, getGradientColor(t), 25, true, 0.85)
    end

    if mousePos then
        local hovered = mousePos.X >= x and mousePos.X <= x + w and
                       mousePos.Y >= y and mousePos.Y <= y + h

        if isPressed then
            if hovered and not self.isDragging and not _anyUIDragging then
                self.isDragging = true
                _anyUIDragging = true
                self.dragOffsetX = mousePos.X - self.x
                self.dragOffsetY = mousePos.Y - self.y
            end
        else
            if self.isDragging then
                _anyUIDragging = false
            end
            self.isDragging = false
        end
        
        if self.isDragging then
            local vpX, vpY = 1920, 1080
            local ok, cam = pcall(function() return workspace.CurrentCamera end)
            if ok and cam and cam.ViewportSize then
                vpX, vpY = cam.ViewportSize.X, cam.ViewportSize.Y
            end
            self.x = math.max(0, math.min(mousePos.X - self.dragOffsetX, vpX - w))
            self.y = math.max(0, math.min(mousePos.Y - self.dragOffsetY, vpY - h))
        end
        
        self.lastMousePressed = isPressed
    end
end

function Watermark:GetMousePos()
    return _frameMousePos
end

function Watermark:Destroy()
    self.visible = false
    for i, w in ipairs(windows) do
        if w == self then table.remove(windows, i) break end
    end
end

-- ===== Top-right notification system =====
local Notification = {}
Notification.__index = Notification

function Notification.new(config)
    local self = setmetatable({}, Notification)
    self.title = tostring(config.Title or config.title or "Notification")
    self.message = tostring(config.Content or config.content or config.Message or config.message or config.Text or config.text or "")
    self.duration = math.max(0.5, tonumber(config.Duration or config.duration) or 4)
    self.createdAt = (tick and tick() or os.clock())
    self.alpha = 0
    self.closing = false
    return self
end

function Notification:Close()
    self.closing = true
end

function Notification:Render(stackIndex)
    local now = (tick and tick() or os.clock())
    local elapsed = now - self.createdAt
    local fadeLead = 0.28
    local target = (elapsed < fadeLead and 1 or 1)
    if self.closing or elapsed >= self.duration - fadeLead then target = 0 end
    self.alpha = approach(self.alpha, target, 18)
    if (self.closing or elapsed >= self.duration) and self.alpha <= 0.02 then return false end

    local viewportX = 1920
    pcall(function() viewportX = workspace.CurrentCamera.ViewportSize.X end)
    local cardW, cardH = 268, 58
    local x = viewportX - cardW - 18 + (1 - self.alpha) * 24
    local y = 18 + (stackIndex - 1) * (cardH + 8)
    local a = self.alpha

    rect(x - 3, y - 3, cardW + 6, cardH + 6, THEME.accent, 97, true, a * 0.08, 5)
    rect(x, y, cardW, cardH, rgb(18, 18, 18), 98, true, a * 0.97, 4)
    rect(x, y, cardW, cardH, rgb(55, 55, 55), 99, false, a * 0.8, 4)
    rect(x, y, 3, cardH, THEME.accent, 100, true, a, 3)
    txt(self.title, x + 13, y + 10, THEME.text, 11, 101, a)
    local message = self.message
    if #message > 42 then message = string.sub(message, 1, 41) .. "..." end
    if message ~= "" then txt(message, x + 13, y + 29, rgb(180, 180, 180), 9, 101, a * 0.95) end

    -- Countdown bar: fixed segment count keeps pooled drawing order stable
    -- while its visible width shrinks with the requested duration.
    local barX, barY, barW = x + 5, y + cardH - 5, cardW - 10
    local remaining = math.max(0, math.min(1, (self.duration - elapsed) / self.duration))
    local filledW = barW * remaining
    rect(barX, barY, barW, 2, rgb(35, 35, 35), 100, true, a * 0.55)
    local barSegments = 32
    for segment = 0, barSegments - 1 do
        local segStart = barW * segment / barSegments
        local segEnd = math.min(barW * (segment + 1) / barSegments, filledW)
        rect(barX + segStart, barY, math.max(0, segEnd - segStart), 2,
             getGradientColor(segment / (barSegments - 1)), 101, true, a)
    end
    return true
end
-- ===== Active keybind overlay =====
local KeybindOverlay = {}
KeybindOverlay.__index = KeybindOverlay
function KeybindOverlay.new(owner)
    return setmetatable({ owner = owner, x = 20, y = 55, visible = false, dragging = false }, KeybindOverlay)
end
function KeybindOverlay:CaptureDrag()
    if not self.visible then return end
    local mouse = _frameMousePos
    local w = 215
    if not _mouseDown then
        if self.dragging then _anyUIDragging = false end
        self.dragging = false
        return
    end
    local inHeader = mouse and mouse.X >= self.x and mouse.X <= self.x + w and mouse.Y >= self.y and mouse.Y <= self.y + 24
    if self.dragging then
        _anyUIDragging = true
        if mouse then self.x, self.y = mouse.X - self.dx, mouse.Y - self.dy end
    elseif _mouseJustPressed and inHeader and not _anyUIDragging then
        self.dragging = true
        _anyUIDragging = true
        self.dx, self.dy = mouse.X - self.x, mouse.Y - self.y
    end
end

function KeybindOverlay:Render()
    if not self.visible then return end
    currentRenderAlpha, currentSectionAlpha = 1, 1
    local entries = { { label = "UI [" .. keyLabel(self.owner.keybind) .. "]", active = isKeyDown(self.owner.keybindVK) } }
    local groups = { self.owner.tabSections, { self.owner.settingsTabData } }
    for _, tabs in ipairs(groups) do for _, columns in pairs(tabs) do for _, sections in pairs(columns) do for _, section in ipairs(sections) do for _, e in ipairs(section.elements) do
        if getmetatable(e) == Checkbox and e.keybindEnabled and e.checked and e.keybind then
            local active = (e.keyMode == "Always") or (e.keyMode == "Toggle" and e.keybindActive) or isKeyDown(KEY_VK[e.keybind])
            entries[#entries + 1] = { label = e.text .. " [" .. keyLabel(e.keybind) .. "]", active = active }
        elseif getmetatable(e) == Keybind and e ~= self.owner.uiKeybindControl and e.keybind then
            entries[#entries + 1] = { label = e.text .. " [" .. keyLabel(e.keybind) .. "]", active = isKeyDown(KEY_VK[e.keybind]) }
        end
    end end end end end
    local w, rowH = 215, 21
    local h = 31 + #entries * rowH + 6
    self.renderW, self.renderH = w, h
    local x, y = self.x, self.y
    -- Compact watermark-style frame, independent of the watermark position.
    rect(x - 2, y - 2, w + 4, h + 4, THEME.accent, 69, true, 0.13)
    rect(x, y, w, h, THEME.bg, 70, true, 0.96)
    rect(x, y, w, h, THEME.watermarkBorder, 71, false, 0.9)
    local title = "Keybind Overlay"
    txt(title, x + w / 2 - #title * 3.6, y + 7, THEME.text, 12, 72, 0.95)
    for i = 0, 23 do
        local sx = x + 4 + (w - 8) * i / 24
        rect(sx, y + 23, math.max(1, (w - 8) / 24), 1, getGradientColor(i / 23), 72, true, 0.9)
    end
    for i, entry in ipairs(entries) do
        local yy = y + 26 + (i - 1) * rowH
        txt(entry.label, x + 8, yy + 3, entry.active and THEME.accent or THEME.text, 12, 73, entry.active and 0.95 or 0.84)
    end
    self:CaptureDrag()
end
function KeybindOverlay:Destroy() self.visible = false end
