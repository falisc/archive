function Keybind:Poll()
    if isAnyTextInputFocused() then return end
    if self.listening then
        for name, vk in pairs(KEY_VK) do
            local down = isKeyDown(vk)
            if down and not self.listenSnapshot[name] then
                if name ~= "esc" then
                    self.keybind = name
                    if self.callback then self.callback(name) end
                end
                self.listening = false
                return
            end
            self.listenSnapshot[name] = down
        end
