local KEY_VK = {}
do
    local function add(name, code) KEY_VK[name] = code end
    add("m1", 0x01); add("m2", 0x02)
    add("mb3", 0x04); add("mb4", 0x05); add("mb5", 0x06)
    add("backspace", 0x08); add("tab", 0x09); add("enter", 0x0D)
    add("shift", 0x10); add("esc", 0x1B); add("space", 0x20)
    add("pageup", 0x21); add("pagedown", 0x22); add("end", 0x23); add("home", 0x24)
    add("left", 0x25); add("up", 0x26); add("right", 0x27); add("down", 0x28)
    add("insert", 0x2D); add("delete", 0x2E)
    for i = 0, 9 do add(tostring(i), 0x30 + i) end
    for i = 0, 25 do add(string.char(97 + i), 0x41 + i) end
    for i = 1, 12 do add("f" .. i, 0x6F + i) end
    add("lshift", 0xA0); add("rshift", 0xA1); add("lctrl", 0xA2); add("rctrl", 0xA3); add("lalt", 0xA4); add("ralt", 0xA5)
    add("semicolon", 0xBA); add("plus", 0xBB); add("comma", 0xBC)
    add("minus", 0xBD); add("period", 0xBE); add("slash", 0xBF)
    add("tilde", 0xC0); add("lbracket", 0xDB); add("backslash", 0xDC)
    add("rbracket", 0xDD); add("quote", 0xDE)
end

local function normalizeKey(v)
    if v == nil then return nil end
    v = string.lower(tostring(v)):gsub("%s+", "")
    if v == "" then return nil end
    return KEY_ALIASES[v] or v
end

local function isKeyDown(vk)
    if not vk then return false end
    local ok, down = pcall(iskeypressed, vk)
    return ok and down or false
end

