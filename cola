-- ===== Animation helpers =====
local FRAME_DT = 1 / 60 -- updated every frame from RenderStepped's dt

-- Typematic key-repeat timing for held text-input keys (e.g. holding Backspace)
local KEY_REPEAT_DELAY = 0.42    -- time held before repeating starts
local KEY_REPEAT_INTERVAL = 0.035 -- time between repeats once it starts

local function approach(cur, target, speed, dt)
    dt = dt or FRAME_DT
    speed = speed or 12
    return cur + (target - cur) * (1 - math.exp(-speed * dt))
end

local function lerpColor(a, b, t)
    t = t < 0 and 0 or (t > 1 and 1 or t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

-- Multiplied into every rect()/txt() alpha so a whole window or a whole
-- section can fade in/out just by changing one number before drawing it.
local currentRenderAlpha = 1  -- per-window fade (keybind show/hide)
local currentSectionAlpha = 1 -- per-section fade (collapse/expand)
local drawingClipTop = nil
local drawingClipBottom = nil

-- ===== Drawing pool (type-safe, property-cached) =====
-- Drawing property writes are comparatively expensive. Cache the last values
-- per pooled object so a static frame only performs the writes it needs.
local pool = {}
local poolTypes = {}
local poolCache = {}
local idx = 0

local function getDrawing(typ)
    idx = idx + 1
    local slot = pool[idx]
    if not slot or poolTypes[idx] ~= typ then
        if slot and slot.Remove then slot:Remove() end
        slot = Drawing.new(typ)
        pool[idx] = slot
        poolTypes[idx] = typ
        poolCache[idx] = {}
    end
    return slot, poolCache[idx]
end

local function hideUnused()
    for i = idx + 1, #pool do
        local d, c = pool[i], poolCache[i]
        if d and c and c.visible ~= false then
            c.visible = false
            d.Visible = false
        end
    end
end

local function rect(x, y, w, h, color, z, filled, alpha, corner)
    local d, c = getDrawing("Square")
    if drawingClipTop then
        local clippedTop = math.max(y, drawingClipTop)
        local clippedBottom = math.min(y + h, drawingClipBottom)
        if clippedBottom <= clippedTop then
            if c.visible ~= false then c.visible = false; d.Visible = false end
            return
        end
        y, h = clippedTop, clippedBottom - clippedTop
    end
    if w <= 0 or h <= 0 then
        if c.visible ~= false then c.visible = false; d.Visible = false end
        return
    end
    if c.x ~= x or c.y ~= y then c.x, c.y = x, y; d.Position = Vector2.new(x, y) end
    if c.w ~= w or c.h ~= h then c.w, c.h = w, h; d.Size = Vector2.new(w, h) end
    local r, g, b = color.R, color.G, color.B
    if c.r ~= r or c.g ~= g or c.b ~= b then c.r, c.g, c.b = r, g, b; d.Color = color end
    local isFilled = filled ~= false
    if c.filled ~= isFilled then c.filled = isFilled; d.Filled = isFilled end
    corner = corner or 0
    if c.corner ~= corner then c.corner = corner; d.Corner = corner end
    z = z or 1
    if c.z ~= z then c.z = z; d.ZIndex = z end
    alpha = (alpha or 1) * currentRenderAlpha * currentSectionAlpha
    if c.alpha ~= alpha then c.alpha = alpha; d.Transparency = alpha end
    if c.visible ~= true then c.visible = true; d.Visible = true end
end

local GRADIENT_DARK = rgb(30, 80, 150)
local GRADIENT_NORMAL = rgb(50, 180, 255)
local GRADIENT_MID = rgb(20, 60, 120)
local GRADIENT_END = rgb(30, 80, 150)
local GRADIENT_DEFAULTS = { dark = rgb(30, 80, 150), mid = rgb(20, 60, 120), bright = rgb(50, 180, 255), finish = rgb(30, 80, 150) }
local gradientCache = {}
local function getGradientColor(t)
    local cached = gradientCache[t]
    if cached then return cached end
    local color
    if t < 0.25 then
        local s = t / 0.25
        color = Color3.new(GRADIENT_DARK.R + (GRADIENT_MID.R - GRADIENT_DARK.R) * s, GRADIENT_DARK.G + (GRADIENT_MID.G - GRADIENT_DARK.G) * s, GRADIENT_DARK.B + (GRADIENT_MID.B - GRADIENT_DARK.B) * s)
    elseif t < 0.5 then
        local s = (t - 0.25) / 0.25
        color = Color3.new(GRADIENT_MID.R + (GRADIENT_NORMAL.R - GRADIENT_MID.R) * s, GRADIENT_MID.G + (GRADIENT_NORMAL.G - GRADIENT_MID.G) * s, GRADIENT_MID.B + (GRADIENT_NORMAL.B - GRADIENT_MID.B) * s)
    elseif t < 0.75 then
        local s = (t - 0.5) / 0.25
        color = Color3.new(GRADIENT_NORMAL.R + (GRADIENT_MID.R - GRADIENT_NORMAL.R) * s, GRADIENT_NORMAL.G + (GRADIENT_MID.G - GRADIENT_NORMAL.G) * s, GRADIENT_NORMAL.B + (GRADIENT_MID.B - GRADIENT_NORMAL.B) * s)
    else
        local s = (t - 0.75) / 0.25
        color = Color3.new(GRADIENT_MID.R + (GRADIENT_END.R - GRADIENT_MID.R) * s, GRADIENT_MID.G + (GRADIENT_END.G - GRADIENT_MID.G) * s, GRADIENT_MID.B + (GRADIENT_END.B - GRADIENT_MID.B) * s)
    end
    gradientCache[t] = color
    return color
end

local function circle(x, y, radius, color, z, filled, alpha, thickness)
    local d, c = getDrawing("Circle")
    if radius <= 0 then
        if c.visible ~= false then c.visible = false; d.Visible = false end
        return
    end
    if c.x ~= x or c.y ~= y then c.x, c.y = x, y; d.Position = Vector2.new(x, y) end
    if c.radius ~= radius then c.radius = radius; d.Radius = radius end
    local r, g, b = color.R, color.G, color.B
    if c.r ~= r or c.g ~= g or c.b ~= b then c.r, c.g, c.b = r, g, b; d.Color = color end
    local isFilled = filled == true
    if c.filled ~= isFilled then c.filled = isFilled; d.Filled = isFilled end
    thickness = thickness or 1
    if c.thickness ~= thickness then c.thickness = thickness; d.Thickness = thickness end
    if c.sides ~= 24 then c.sides = 24; d.NumSides = 24 end
    z = z or 1
    if c.z ~= z then c.z = z; d.ZIndex = z end
    alpha = (alpha or 1) * currentRenderAlpha * currentSectionAlpha
    if c.alpha ~= alpha then c.alpha = alpha; d.Transparency = alpha end
    if c.visible ~= true then c.visible = true; d.Visible = true end
end

local function line(x1, y1, x2, y2, color, z, alpha, thickness)
    local d, c = getDrawing("Line")
    if c.x1 ~= x1 or c.y1 ~= y1 then c.x1, c.y1 = x1, y1; d.From = Vector2.new(x1, y1) end
    if c.x2 ~= x2 or c.y2 ~= y2 then c.x2, c.y2 = x2, y2; d.To = Vector2.new(x2, y2) end
    local r, g, b = color.R, color.G, color.B
    if c.r ~= r or c.g ~= g or c.b ~= b then c.r, c.g, c.b = r, g, b; d.Color = color end
    thickness = thickness or 1.5
    if c.thickness ~= thickness then c.thickness = thickness; d.Thickness = thickness end
    z = z or 1
    if c.z ~= z then c.z = z; d.ZIndex = z end
    alpha = (alpha or 1) * currentRenderAlpha * currentSectionAlpha
    if c.alpha ~= alpha then c.alpha = alpha; d.Transparency = alpha end
    if c.visible ~= true then c.visible = true; d.Visible = true end
end

local function txt(text, px, y, color, size, z, alpha, fontOverride)
    local d, c = getDrawing("Text")
    if not text or text == "" then
        if c.visible ~= false then c.visible = false; d.Visible = false end
        return
    end
    size = size or 12
    if drawingClipTop and (y + size <= drawingClipTop or y >= drawingClipBottom) then
        if c.visible ~= false then c.visible = false; d.Visible = false end
        return
    end
    local effAlpha = (alpha or 1) * currentRenderAlpha * currentSectionAlpha
    if c.size ~= size then c.size = size; d.Size = size end
    local font = fontOverride or Drawing.Fonts.ProximaSoftBold or 1
    if c.font ~= font then c.font = font; d.Font = font end
    text = tostring(text)
    if c.text ~= text then c.text = text; d.Text = text end
    if c.x ~= px or c.y ~= y then c.x, c.y = px, y; d.Position = Vector2.new(px, y) end
    local r, g, b = color.R, color.G, color.B
    if c.r ~= r or c.g ~= g or c.b ~= b then c.r, c.g, c.b = r, g, b; d.Color = color end
    if c.center ~= false then c.center = false; d.Center = false end
    local outline = effAlpha > 0.97
    if c.outline ~= outline then c.outline = outline; d.Outline = outline end
    z = z or 1
    if c.z ~= z then c.z = z; d.ZIndex = z end
    if c.alpha ~= effAlpha then c.alpha = effAlpha; d.Transparency = effAlpha end
    if c.visible ~= true then c.visible = true; d.Visible = true end
    return d, c
end
-- A single invisible Drawing text object gives exact proportional-font widths
-- for editable textbox carets without adding a visible drawing each frame.
local _textMeasure = nil
local function measureTextWidth(value, size, fontOverride)
    local ok, width = pcall(function()
        if not _textMeasure then
            _textMeasure = Drawing.new("Text")
            _textMeasure.Visible = false
            _textMeasure.Font = Drawing.Fonts.ProximaSoftBold or 1
        end
        _textMeasure.Font = fontOverride or Drawing.Fonts.ProximaSoftBold or 1
        _textMeasure.Size = size or 10
        _textMeasure.Text = tostring(value or "")
        return _textMeasure.TextBounds.X
    end)
    return ok and width or (#tostring(value or "") * 5.4)
end
