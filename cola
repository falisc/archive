-- ===== Checkbox class =====
local Checkbox = {}
Checkbox.__index = Checkbox

-- config = { Keybind = true/false, Default = "somekey" }
function Checkbox.new(text, callback, config)
    config = config or {}
    local self = setmetatable({}, Checkbox)
    self.text = text
    self.checked = false
    self.callback = callback
    self.lastMousePressed = false
    self.fillAnim = 0 -- 0 = empty, 1 = fully filled

    -- Whether this checkbox has a keybind at all
    self.keybindEnabled = config.Keybind == true

    -- Keybind capture (right-side [NONE] / [...] / [KEY] button)
    self.keybind = self.keybindEnabled and normalizeKey(config.Default) or nil
    self.listening = false
    self.listenSnapshot = nil
    self.lastBoundKeyState = false
    self.kbLastMousePressed = false
    self.keybindActive = false
    self.modeMenuOpen = false
    self.modeMenuAnim = 0
    local modeName = tostring(config.KeyMode or config.Mode or "Click"):lower()
    self.keyMode = ({ hold = "Hold", toggle = "Toggle", always = "Always", click = "Click" })[modeName] or "Click"
    if config.ColorPicker then
        local pickerConfig = type(config.ColorPicker) == "table" and config.ColorPicker or {}
        self.colorPicker = ColorPicker.new("", pickerConfig.Default or config.Color, pickerConfig.Callback or config.ColorCallback)
        self.colorPicker.owner = self
    end
    return self
end

function Checkbox:SetValue(val)
    self.checked = val
    if self.callback then
        self.callback(val)
    end
end

function Checkbox:SetKeybind(key)
    if not self.keybindEnabled then return self end
    self.keybind = normalizeKey(key)
    return self
end

function Checkbox:StartListening()
    if not self.keybindEnabled then return end
    self.listening = true
    self.listenSnapshot = {}
    for name, vk in pairs(KEY_VK) do
        self.listenSnapshot[name] = isUIKeyDown(vk)
    end
end

function Checkbox:PollKeybindCapture()
    if not self.keybindEnabled or not self.listening or isAnyTextInputFocused() then return end
    for name, vk in pairs(KEY_VK) do
        local down = isKeyDown(vk)
        if down and not self.listenSnapshot[name] then
            if name ~= "esc" then -- esc cancels instead of binding
                self.keybind = name
            end
            self.listening = false
            return
        end
        self.listenSnapshot[name] = down
    end
end

function Checkbox:PollKeybindAction()
    if not self.keybindEnabled or self.listening then return end
    -- UI visibility must not disable feature binds; only actual text entry does.
    if isAnyTextInputFocused() then return end
    local down = self.keybind and isKeyDown(KEY_VK[self.keybind]) or false
    local pressed = down and not self.lastBoundKeyState
    self.lastBoundKeyState = down

    -- A keybind never changes the checkbox itself. It only invokes the
    -- callback while the checkbox has been explicitly enabled by a click.
    if not self.checked then
        self.keybindActive = false
        return
    end
    if self.keyMode == "Hold" then
        if down and self.callback then self.callback(true, "Hold") end
    elseif self.keyMode == "Toggle" then
        if pressed then self.keybindActive = not self.keybindActive end
        if self.keybindActive and self.callback then self.callback(true, "Toggle") end
    elseif self.keyMode == "Always" then
        if self.callback then self.callback(true, "Always") end
    elseif pressed and self.callback then
        self.callback(true, "Click")
    end
end

function Checkbox:Render(x, y, width, mousePos)
    if self.modeMenuClosePending and not _mouseDown then
        self.modeMenuClosePending = false
        self.modeMenuOpen = false
    end
    self:PollKeybindCapture()
    self:PollKeybindAction()
    if _activeKeybindMenu and _activeKeybindMenu ~= self then mousePos = nil end

    local checkboxSize = 14
    local padding = 8
    local checkboxOutlineColor = rgb(41, 41, 41)
    
    rect(x + padding, y + 3, checkboxSize, checkboxSize, 
         checkboxOutlineColor, 15, false, 1)
    
    self.fillAnim = approach(self.fillAnim, self.checked and 1 or 0, 16)
    if self.fillAnim > 0.01 then
        local innerSize = checkboxSize - 4
        local drawnSize = innerSize * self.fillAnim
        local offset = (innerSize - drawnSize) / 2
        rect(x + padding + 2 + offset, y + 5 + offset, drawnSize, drawnSize, 
             THEME.toggle, 16, true, self.fillAnim)
    end
    
    txt(self.text, x + padding + checkboxSize + 8, y + 5, THEME.text, 10, 16, 1)

    -- Keybind button: left-click rebinds; right-click opens its action mode.
    if self.keybindEnabled then
        local kbLabel = self.listening and "..." or keyLabel(self.keybind)
        local kbH = checkboxSize
        local kbW = math.max(40, #kbLabel * 6.5 + 10)
        local kbX = x + width - kbW
        local kbY = y + 3
        if self.colorPicker then self.colorPicker:RenderSwatch(kbX - 18, kbY, mousePos) end
        local kbBg = self.listening and THEME.accent or rgb(30, 30, 30)
        rect(kbX, kbY, kbW, kbH, kbBg, 16, true, self.listening and 0.8 or 0.6)
        rect(kbX, kbY, kbW, kbH, rgb(55, 55, 55), 17, false, 0.8)
        local kbTextX = kbX + (kbW - (#kbLabel * 6.5)) / 2
        txt(kbLabel, kbTextX, kbY + 2, THEME.text, 10, 18, 1)

        if mousePos then
            local kbHit = mousePos.X >= kbX and mousePos.X <= kbX + kbW and mousePos.Y >= kbY and mousePos.Y <= kbY + kbH
            if kbHit and _mouseJustPressed then self:StartListening() end
            if kbHit and _mouseRightJustPressed then
                if _activeKeybindMenu and _activeKeybindMenu ~= self then
                    _activeKeybindMenu.modeMenuOpen = false
                end
                self.modeMenuOpen = not self.modeMenuOpen
                _activeKeybindMenu = self
            end
        end
        self.modeMenuAnim = approach(self.modeMenuAnim or 0, self.modeMenuOpen and 1 or 0, 18)
        if self.modeMenuAnim > 0.01 then
            local modes = { "Hold", "Toggle", "Always", "Click" }
            local menuW, optionH = 104, 17
            local menuX = kbX + kbW - menuW
            local menuY = kbY + kbH + 3
            local menuH = #modes * optionH + 4
            local menuAlpha = self.modeMenuAnim
            local drawMenuY = menuY - (1 - menuAlpha) * 4
            rect(menuX, drawMenuY, menuW, menuH, rgb(20, 20, 20), 20, true, 0.98 * menuAlpha, 4)
            rect(menuX, drawMenuY, menuW, menuH, rgb(80, 80, 80), 21, false, 0.8 * menuAlpha, 4)
            for i, mode in ipairs(modes) do
                local optionY = menuY + 2 + (i - 1) * optionH
                local drawOptionY = drawMenuY + 2 + (i - 1) * optionH
                local hovered = self.modeMenuOpen and mousePos and mousePos.X >= menuX + 2 and mousePos.X <= menuX + menuW - 2 and mousePos.Y >= optionY and mousePos.Y <= optionY + optionH
                local selected = self.keyMode == mode
                local bg = selected and lerpColor(rgb(24, 24, 24), THEME.accent, 0.22) or (hovered and rgb(40, 40, 40) or rgb(24, 24, 24))
                rect(menuX + 2, drawOptionY, menuW - 4, optionH - 1, bg, 21, true, 0.95 * menuAlpha, 3)
                txt(mode, menuX + 8, drawOptionY + 3, THEME.text, 9, 22, menuAlpha)
                if hovered and _mouseJustPressed then
                    self.keyMode = mode
                    self.keybindActive = false
                    self.modeMenuClosePending = true
                    _keybindMenuBlockUntilRelease = true
                    _modalBlockUntilRelease = true
                end
            end
        end
    end
    if self.colorPicker and not self.keybindEnabled then
        self.colorPicker:RenderSwatch(x + width - 16, y + 3, mousePos)
    end
    if mousePos then
        local isPressed = _mouseDown
local hitX = mousePos.X >= x + padding and mousePos.X <= x + padding + checkboxSize
        local hitY = mousePos.Y >= y + 3 and mousePos.Y <= y + 3 + checkboxSize
        if hitX and hitY and _mouseJustPressed then
            self:SetValue(not self.checked)
        end
    end
    
    return 20
end
