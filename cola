        local clipBottomY = math.min(oy + animH, viewportBottom or (oy + animH))
        local OPT_FADE_ZONE = 14
        local optRight = scrollMax > 0 and (x + width - 12) or (x + width - 4)
        for i, opt in ipairs(filteredOptions) do
            local optY = oy + (i - 1) * optionH - self.scrollOffset
            local topD = optY - clipTop
            local botD = clipBottomY - (optY + optionH)
            local aTop = math.max(0, math.min(1, 1 + topD / OPT_FADE_ZONE))
            local aBot = math.max(0, math.min(1, 1 + botD / OPT_FADE_ZONE))
            local edgeAlpha = math.min(aTop, aBot)
            if edgeAlpha > 0.02 then
                local optAlpha = alphaFade * edgeAlpha
                local isSelected
                if self.type == "Single" then
                    isSelected = self.selected == opt
                else
                    isSelected = self.selected and self.selected[opt]
                end

                local optW = optRight - (x + 4)
                local ohit = edgeAlpha > 0.95 and mousePos and mousePos.X >= x + 4 and mousePos.X <= optRight and mousePos.Y >= optY and mousePos.Y <= optY + optionH or false
                local selectionAnim = approach(self.selectionAnim[opt] or 0, isSelected and 1 or 0, 16)
                self.selectionAnim[opt] = selectionAnim
                local selectionPulse = approach(self.selectionPulse[opt] or 0, 0, 20)
                self.selectionPulse[opt] = selectionPulse

                local optBg = rgb(24, 24, 24)
                if ohit then
                    optBg = lerpColor(optBg, rgb(60, 60, 60), 0.5)
                end

                -- Use the slider's full blue gradient, but blend it into the
                -- row background first. The narrow fixed layers keep it smooth
                -- and preserve a stable pooled drawing sequence.
                local selectionStrength = selectionAnim * 0.16 + selectionPulse * 0.08
                rect(x + 4, optY, optW, optionH, optBg, 15, true, optAlpha)
                local gradientX, gradientW = x + 5, optW - 2
                local gradientSegments = 48
                for segment = 0, gradientSegments - 1 do
                    local segX = math.floor(gradientX + gradientW * segment / gradientSegments)
                    local segEnd = gradientX + gradientW * (segment + 1) / gradientSegments
                    local segW = math.max(1, math.floor(segEnd) - segX)
                    local gradientBg = lerpColor(optBg, getGradientColor(segment / (gradientSegments - 1)), selectionStrength)
                    rect(segX, optY + 1, segW, optionH - 2, gradientBg, 16, true, optAlpha)
                end

                rect(x + 4, optY, optW, 1, borderColor, 17, true, optAlpha * 0.9)
                rect(x + 4, optY + optionH - 1, optW, 1, borderColor, 17, true, optAlpha * 0.9)
                rect(x + 4, optY, 1, optionH, borderColor, 17, true, optAlpha * 0.9)
                rect(optRight, optY, 1, optionH, borderColor, 17, true, optAlpha * 0.9)

                rect(x + 5, optY + 2, 2, optionH - 4, sbCol, 18, true, selectionAnim * optAlpha)

                local maxTextW = optW - 12
                local label = #opt * 7 > maxTextW and string.sub(opt, 1, math.max(3, math.floor(maxTextW / 7) - 1)) .. "..." or opt
                txt(label, x + 10, optY + (optionH - 10) / 2, THEME.text, 10, 18, optAlpha)

                if ohit and mousePos and _mouseDown and not self.lastPressed then
                    if self.type == "Single" then
                        self.selected = opt
                        self.expanded = false
                    else
                        if not self.selected then self.selected = {} end
                        self.selected[opt] = not self.selected[opt]
                    end
                    self.selectionPulse[opt] = 1
                    if self.callback then
                        self.callback(self.type == "Single" and self.selected or self.selected)
                    end
                end
            end
        end
    end

    self.lastPressed = mousePos and _mouseDown or false

    drawingClipTop, drawingClipBottom = previousClipTop, previousClipBottom
    return total
end
function Dropdown:getHeight()
    local h = 24
    local optionH = 20
    local searchH = 22
    local multiActionH = 18
    local multiActionGap = 3
    local isMulti = self.type ~= "Single"
    local controlsH = searchH + (isMulti and (multiActionH + multiActionGap) or 0)
    local optionBottomPadding = 6
    local totalOptions = #self.options
    local contentH = totalOptions * optionH
    local maxVisible = math.min(contentH, 160)
    local animH = 0
    local searchAnim = math.floor(controlsH * self.expandAnim)
    if totalOptions > 0 and self.expandAnim > 0.01 then
        animH = math.floor((maxVisible + optionBottomPadding) * self.expandAnim)
    end
    return h + searchAnim + animH + 6
end

-- ===== Slider class =====
local Slider = {}
Slider.__index = Slider

function Slider.new(text, min, max, default, callback, increment)
    local self = setmetatable({}, Slider)
    self.text = text
    self.min = min or 0
    self.max = max or 100
    self.increment = increment or 1
    self.value = default or self.min
    self.callback = callback
    self.dragging = false
    self.lastMousePressed = false
    self.fillAnim = 0
    self.minusFlash = 0
    self.plusFlash = 0
    self.lastMinusPressed = false
    self.lastPlusPressed = false
    return self
end

function Slider:SetValue(val)
    val = math.max(self.min, math.min(self.max, val))
    if self.increment and self.increment > 0 then
        val = math.floor(val / self.increment + 0.5) * self.increment
    end
    if val ~= self.value then
        self.value = val
        if self.callback then self.callback(val) end
    end
end

function Slider:Render(x, y, width, mousePos)
    local trackH = 8
    local trackY = y + 16
    local trackX = x + 8
    local trackW = width - 16
    local btnSize = 8
    local btnGap = 3
    local totalH = 30

    self.minusFlash = approach(self.minusFlash, 0, 14)
    self.plusFlash = approach(self.plusFlash, 0, 14)

    local valStr = self.value == math.floor(self.value) and tostring(math.floor(self.value)) or string.format("%.1f", self.value)
    txt(self.text .. ": " .. valStr, x + 6, y + 2, THEME.text, 10, 16, 1)

    local trackBg = rgb(24, 24, 24)
    local borderColor = THEME.sliderOutline
    local fillBorder = THEME.sliderFillOutline
    rect(trackX, trackY, trackW, trackH, trackBg, 15, true, 1)
    rect(trackX, trackY, trackW, 1, borderColor, 14, true, 1)
    rect(trackX, trackY + trackH - 1, trackW, 1, borderColor, 14, true, 1)
    rect(trackX, trackY, 1, trackH, borderColor, 14, true, 1)
    rect(trackX + trackW - 1, trackY, 1, trackH, borderColor, 14, true, 1)

    local fill = (self.value - self.min) / (self.max - self.min)
    self.fillAnim = approach(self.fillAnim, fill, 14)
    if self.fillAnim > 0.01 then
        local fillW = math.max(2, trackW * self.fillAnim)
        local segs = math.max(4, fillW)
        for i = 0, segs - 1 do
            local t = i / (segs - 1)
            local segXRaw = trackX + fillW * i / segs
            local segXEnd = trackX + fillW * (i + 1) / segs
            local segX = math.floor(segXRaw)
            local segW = math.max(1, math.floor(segXEnd) - segX)
            rect(segX, trackY, segW, trackH, getGradientColor(t), 16, true, 0.85)
        end
        rect(trackX, trackY, fillW, 1, fillBorder, 17, true, 0.9)
        rect(trackX, trackY + trackH - 1, fillW, 1, fillBorder, 17, true, 0.9)
        rect(trackX, trackY, 1, trackH, fillBorder, 17, true, 0.9)
        rect(trackX + fillW - 1, trackY, 1, trackH, fillBorder, 17, true, 0.9)
    end

    local fillEdge = trackX + trackW * self.fillAnim
    rect(fillEdge, trackY, 1, trackH, THEME.sliderHandle, 18, true, 0.7)

    local btnY = math.floor(y + 3)
    local minusX = math.floor(x + width - (btnSize * 2 + btnGap + 6))
    local plusX = minusX + btnSize + btnGap

    local minusColor = lerpColor(rgb(50, 50, 50), THEME.accent, self.minusFlash)
    local plusColor = lerpColor(rgb(50, 50, 50), THEME.accent, self.plusFlash)

    rect(minusX, btnY, btnSize, btnSize, rgb(30, 30, 30), 15, true, 1)
    rect(minusX, btnY, btnSize, btnSize, minusColor, 14, false, 0.8)
    local mcX = math.floor(minusX + btnSize / 2)
    local mcY = math.floor(btnY + btnSize / 2)
    rect(mcX - 2, mcY, 5, 1, THEME.text, 16, true, 1)

    rect(plusX, btnY, btnSize, btnSize, rgb(30, 30, 30), 15, true, 1)
    rect(plusX, btnY, btnSize, btnSize, plusColor, 14, false, 0.8)
    local pcX = math.floor(plusX + btnSize / 2)
    local pcY = math.floor(btnY + btnSize / 2)
    rect(pcX - 2, pcY, 5, 1, THEME.text, 16, true, 1)
    rect(pcX, pcY - 2, 1, 5, THEME.text, 16, true, 1)

    if mousePos then
        local isPressed = _mouseDown
        local trackHit = mousePos.Y >= trackY - 4 and mousePos.Y <= trackY + trackH + 4 and
                        mousePos.X >= trackX and mousePos.X <= trackX + trackW

        local inMinus = mousePos.X >= minusX and mousePos.X <= minusX + btnSize and
                       mousePos.Y >= btnY and mousePos.Y <= btnY + btnSize
        local inPlus = mousePos.X >= plusX and mousePos.X <= plusX + btnSize and
                      mousePos.Y >= btnY and mousePos.Y <= btnY + btnSize

        if isPressed then
            if not _anySliderDragging and trackHit and _mouseJustPressed then
                self.dragging = true
                _anySliderDragging = true
                -- Grab relative to wherever the click landed, instead of
                -- snapping the handle to sit under the cursor.
                self.dragStartMouseX = mousePos.X
                self.dragStartValue = self.value
            end
            if self.dragging then
                local deltaX = mousePos.X - (self.dragStartMouseX or mousePos.X)
                local deltaT = deltaX / trackW
                local deltaVal = deltaT * (self.max - self.min)
                self:SetValue((self.dragStartValue or self.value) + deltaVal)
            end
            if inMinus and not self.lastMinusPressed then
                self:SetValue(self.value - self.increment)
                self.minusFlash = 1
            end
            if inPlus and not self.lastPlusPressed then
                self:SetValue(self.value + self.increment)
                self.plusFlash = 1
            end
        else
            if self.dragging then _anySliderDragging = false end
            self.dragging = false
        end

        self.lastMinusPressed = isPressed and inMinus
        self.lastPlusPressed = isPressed and inPlus
        self.lastMousePressed = isPressed
    end

    return totalH
end
function Slider:getHeight() return 30 end

