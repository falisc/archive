                        self.searchQuery = string.sub(self.searchQuery or "", 1, #(self.searchQuery or "") - 1)
                    elseif name == "space" then
                        self.searchQuery = (self.searchQuery or "") .. " "
                    else
                        local ch
                        if shiftHeld then
                            ch = _SHIFTED_CHARS[name] or string.upper(name)
                        else
                            ch = name
                        end
                        self.searchQuery = (self.searchQuery or "") .. ch
                    end
                end
            end
            states[name] = down
        end
    elseif self._lastKeyStates then
        self._lastKeyStates = nil
        self._keyRepeatTimer = nil
    end

    -- Search bar click handling
    if searchAnim > 0 and mousePos then
        local sbx = x + 6
        local sby = y + h + 2 + (isMulti and (multiActionH + multiActionGap) or 0)
        local sbw = width - 12
        local sbh = searchH - 4
        local sbHovered = mousePos.X >= sbx and mousePos.X <= sbx + sbw and mousePos.Y >= sby and mousePos.Y <= sby + sbh
        local isPressEdge = _mouseDown and not self.lastPressed
        if sbHovered and isPressEdge then
            pcall(setrobloxinput, false)
            if not self.inputFocused then textInputBegin() end
            self.inputFocused = true

            -- Double-click the search box to instantly clear it (stand-in
            -- for select-all + delete, since there's no mid-string caret)
            local now = tick()
            if self._lastSearchClickTime and (now - self._lastSearchClickTime) < 0.35 then
                self.searchQuery = ""
                self._lastSearchClickTime = nil
            else
                self._lastSearchClickTime = now
            end
        elseif not sbHovered and isPressEdge then
            if self.inputFocused then textInputEnd() end
            self.inputFocused = false
        end
    end

    -- Options with scroll
    if animH > 1 and self.expanded then
        local oy = y + h + searchAnim
        local alphaFade = self.expandAnim
        local sbCol = THEME.scrollbar

        -- Scrollbar
        if scrollMax > 0 and (not viewportBottom or viewportBottom > oy) then
            local sbW = 3
            local sbX = x + width - sbW - 3
            local trackH = math.max(0, math.min(animH, (viewportBottom or (oy + animH)) - oy))
            local thumbH = math.max(6, trackH * (maxVisible / contentH))
            local thumbY = oy + (trackH - thumbH) * (self.scrollOffset / scrollMax)

            rect(sbX, oy, sbW, trackH, rgb(35, 35, 35), 16, true, 0.5 * alphaFade)
            rect(sbX, thumbY, sbW, thumbH, sbCol, 18, true, alphaFade)

            -- Scrollbar drag
            if mousePos and mousePos.X >= sbX - 2 and mousePos.X <= sbX + sbW + 2 and mousePos.Y >= oy and mousePos.Y <= oy + trackH then
