-- ===== Label class =====
local Label = {}
Label.__index = Label

local function labelLines(value)
    if type(value) == "table" then
        local lines = {}
        for i, line in ipairs(value) do lines[i] = tostring(line or "") end
        return #lines > 0 and lines or { "" }
    end
    local lines = {}
    for line in (tostring(value or "") .. "\n"):gmatch("(.-)\n") do
        table.insert(lines, line)
    end
    return #lines > 0 and lines or { "" }
end

function Label.new(text, config)
    config = config or {}
    local self = setmetatable({}, Label)
    self.lines = labelLines(text)
    self.color = config.Color or rgb(185, 185, 185)
    self.size = config.Size or 10
    self.background = config.Background ~= false
    return self
end

function Label:SetText(text)
    self.lines = labelLines(text)
    return self
end

function Label:SetLine(index, text)
    index = math.max(1, math.floor(tonumber(index) or 1))
    while #self.lines < index do table.insert(self.lines, "") end
    self.lines[index] = tostring(text or "")
    return self
end

function Label:AddLine(text)
    table.insert(self.lines, tostring(text or ""))
    return self
end

function Label:Clear()
    self.lines = { "" }
    return self
end

function Label:getHeight()
    return math.max(20, #self.lines * 12 + 8) + 4
end

function Label:Render(x, y, width)
    local innerH = math.max(20, #self.lines * 12 + 8)
    if self.background then
        rect(x, y, width, innerH, rgb(23, 23, 23), 15, true, 0.72)
        rect(x, y, width, innerH, rgb(53, 53, 53), 16, false, 0.62)
    end
    for i, line in ipairs(self.lines) do
        txt(line, x + 7, y + 4 + (i - 1) * 12, self.color, self.size, 17, 0.95)
    end
    return innerH + 4
end
-- ===== Textbox class =====
local Textbox = {}
Textbox.__index = Textbox

function Textbox.new(text, default, callback, placeholder)
    local self = setmetatable({}, Textbox)
    self.text = tostring(text or "Text")
    self.value = tostring(default or "")
    self.placeholder = tostring(placeholder or "")
    self.callback = callback
    self.focused = false
    self.cursor = #self.value
    self.maxLength = 250
    self.keyStates, self.repeatTimers = {}, {}
    self.lastClickTime = 0
    self.boxX, self.boxY, self.boxW, self.boxH = nil, nil, nil, nil
    return self
end

function Textbox:GetValue() return self.value end
function Textbox:SetValue(value, silent)
    self.value = string.sub(tostring(value or ""), 1, self.maxLength or 250)
    self.cursor = #self.value
    if not silent and self.callback then self.callback(self.value) end
    return self
end
function Textbox:Blur()
    if self.focused then textInputEnd() end
    self.focused = false
    self.keyStates, self.repeatTimers = {}, {}
    if _activeTextBox == self then _activeTextBox = nil end
end
function Textbox:Contains(point)
    return point and self.boxX and point.X >= self.boxX and point.X <= self.boxX + self.boxW and point.Y >= self.boxY and point.Y <= self.boxY + self.boxH
end
function Textbox:Insert(char)
    char = tostring(char or "")
    local available = (self.maxLength or 250) - #self.value
    if available <= 0 or char == "" then return end
    char = string.sub(char, 1, available)
    local before, after = string.sub(self.value, 1, self.cursor), string.sub(self.value, self.cursor + 1)
    self.value = before .. char .. after
    self.cursor = self.cursor + #char
    if self.callback then self.callback(self.value) end
end
function Textbox:PollInput()
    if not self.focused or not _clientWindowFocused then return end
    pcall(setrobloxinput, false)
    local shiftHeld = isKeyDown(KEY_VK.lshift) or isKeyDown(KEY_VK.rshift)
    for name, vk in pairs(_TEXT_KEYS) do
        local down, previous = isKeyDown(vk), self.keyStates[name]
        local fire = down and not previous
        if fire then self.repeatTimers[name] = KEY_REPEAT_DELAY
        elseif down and name ~= "enter" and name ~= "esc" then
            local timer = (self.repeatTimers[name] or KEY_REPEAT_DELAY) - FRAME_DT
            if timer <= 0 then fire = true; timer = KEY_REPEAT_INTERVAL end
            self.repeatTimers[name] = timer
        elseif not down then self.repeatTimers[name] = nil end
        if fire then
            if name == "enter" or name == "esc" then self:Blur()
            elseif name == "left" then self.cursor = math.max(0, self.cursor - 1)
            elseif name == "right" then self.cursor = math.min(#self.value, self.cursor + 1)
            elseif name == "backspace" and self.cursor > 0 then
                self.value = string.sub(self.value, 1, self.cursor - 1) .. string.sub(self.value, self.cursor + 1)
                self.cursor = self.cursor - 1
                if self.callback then self.callback(self.value) end
            elseif name == "delete" and self.cursor < #self.value then
                self.value = string.sub(self.value, 1, self.cursor) .. string.sub(self.value, self.cursor + 2)
                if self.callback then self.callback(self.value) end
            elseif name ~= "backspace" then
                local char = name == "space" and " " or (shiftHeld and (_SHIFTED_CHARS[name] or string.upper(name)) or (_UNSHIFTED_CHARS[name] or name))
                self:Insert(char)
            end
        end
        self.keyStates[name] = down
    end
end

function Textbox:Render(x, y, width, mousePos)
    self:PollInput()
    txt(self.text, x + 6, y + 2, rgb(180, 180, 180), 9, 16, 0.9)
    local boxY, boxH = y + 14, 20
    self.boxX, self.boxY, self.boxW, self.boxH = x, boxY, width, boxH
    local hovered = mousePos and self:Contains(mousePos)
    local inputFont = Drawing.Fonts.ProximaSoftBold or 1
    -- Same subtle focus/hover highlight as the reference textbox.
    rect(x, boxY, width, boxH, rgb(255, 255, 255), 15, true, 0.055)
    rect(x, boxY, width, boxH, rgb(255, 255, 255), 16, false, self.focused and 0.45 or (hovered and 0.20 or 0.13))

    -- Reference-style field: one normal text draw using the UI font. The same
    -- font is used for measurement, so the caret is never detached from text.
    local textX, textY = x + 8, boxY + 5
    -- ProximaSoftBold is proportional, so measure the exact same font for
    -- both horizontal scrolling and the typing indicator.
    local maxTextWidth = width - 32 -- reserve the right edge for the dot wave
    local visibleValue = self.value
    while #visibleValue > 0 and measureTextWidth(visibleValue, 10, inputFont) > maxTextWidth do
        visibleValue = string.sub(visibleValue, 2)
    end
    if visibleValue == "" and not self.focused then
        txt(self.placeholder ~= "" and self.placeholder or self.text, textX, textY, rgb(120, 120, 120), 10, 17, 0.52, inputFont)
    else
        txt(visibleValue, textX, textY, THEME.text, 10, 17, 0.95, inputFont)
    end
    if self.focused then
        local phase = tick() * 4
        for i = 1, 3 do
            local wave = (math.sin(phase - (i - 1) * 0.8) + 1) * 0.5
            circle(x + width - 9 - (3 - i) * 5, boxY + boxH / 2 - wave * 1.2, 1 + wave * 0.45, THEME.text, 18, true, 0.30 + wave * 0.55)
        end
    end
    if mousePos and _mouseJustPressed and hovered then
        if _activeTextBox and _activeTextBox ~= self then _activeTextBox:Blur() end
        local now = tick()
        if now - self.lastClickTime < 0.35 then
            self.value, self.cursor = "", 0
            if self.callback then self.callback(self.value) end
        else
            self.cursor = #self.value
        end
        self.lastClickTime = now
        pcall(setrobloxinput, false)
        if not self.focused then textInputBegin() end
        self.focused, _activeTextBox = true, self
    end
    return 38
end
