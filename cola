-- Color3 values are immutable, so reuse each RGB value rather than allocating
-- identical colors for every control on every frame.
local rgbCache = {}
local function rgb(r, g, b)
    local key = r * 65536 + g * 256 + b
    local color = rgbCache[key]
    if not color then
        color = Color3.fromRGB(r, g, b)
        rgbCache[key] = color
    end
    return color
end

